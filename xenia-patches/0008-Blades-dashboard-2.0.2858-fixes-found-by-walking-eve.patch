+uint32_t SystemManagementController::MediaState() const {
+  // What XN_SYS_TRAYSTATECHANGED carries: the media in the drive, as the
+  // blades dashboard's disc tile shows it (0 no disc -> "Open Tray",
+  // 1 Xbox 360 game -> "Play Game", 3 unknown -> "Unrecognized Disc",
+  // 4 DVD -> "Play DVD", ...). Only a closed tray holds readable media.
