+int SDLInputDriver::GetBatteryLevel(uint32_t user_index) {
+  if (user_index >= HID_SDL_USER_COUNT) {
+    return -1;
+  }
+  auto controller = GetControllerState(user_index);
+  if (!controller) {
+    return -1;
+  }
+  switch (SDL_JoystickCurrentPowerLevel(
+      SDL_GameControllerGetJoystick(controller->sdl))) {
+    case SDL_JOYSTICK_POWER_EMPTY:
+      return 0;
+    case SDL_JOYSTICK_POWER_LOW:
+      return 1;
+    case SDL_JOYSTICK_POWER_MEDIUM:
+      return 2;
+    case SDL_JOYSTICK_POWER_FULL:
+      return 3;
+    default:  // wired or unknown
+      return -1;
+  }
+}
+
 X_RESULT SDLInputDriver::GetState(uint32_t user_index,
                                   X_INPUT_STATE* out_state) {
   assert(sdl_events_initialized_ && sdl_gamecontroller_initialized_);
