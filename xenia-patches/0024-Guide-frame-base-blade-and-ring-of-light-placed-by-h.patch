+void GuideOverlay::LoadHudKeys() {
+  std::ifstream in(asset_dir_ / "hud_keys.txt");
+  std::string line;
+  while (std::getline(in, line)) {
+    std::istringstream ls(line);
+    std::string kind, id;
+    ls >> kind;
+    if (kind != "key") continue;
+    HudKey key;
+    int show = 1;
+    ls >> id >> key.t >> key.interp >> key.ease_in >> key.ease_out >>
+        key.ease_scale >> key.x >> show >> key.opacity;
+    key.show = show != 0;
+    hud_keys_[id].push_back(key);
+  }
+  if (hud_keys_.empty()) {
+    XELOGW("Guide: hud_keys.txt missing");
+  }
+}
+
+// A timeline value as XUI plays it: interpolation 0 linear to the next key,
+// 1 held, 2 eased (XuiEase); Show is held from the key before.
+GuideOverlay::HudState GuideOverlay::HudAt(const std::string& id,
+                                           float frame) const {
+  HudState state;
+  auto it = hud_keys_.find(id);
+  if (it == hud_keys_.end() || it->second.empty()) {
+    return state;
+  }
+  const std::vector<HudKey>& keys = it->second;
+  const HudKey* prev = &keys.front();
+  const HudKey* next = nullptr;
+  for (const HudKey& key : keys) {
+    if (key.t <= frame) {
+      prev = &key;
+    } else {
+      next = &key;
+      break;
+    }
+  }
+  state.x = prev->x;
+  state.opacity = prev->opacity;
+  state.show = prev->show;
+  if (next && prev->interp != 1 && frame > prev->t && next->t > prev->t) {
+    float u = (frame - prev->t) / float(next->t - prev->t);
+    if (prev->interp == 2) {
+      u = XuiEase(u, prev->ease_in, prev->ease_out, prev->ease_scale);
+    }
+    state.x += (next->x - prev->x) * u;
+    state.opacity += (next->opacity - prev->opacity) * u;
+  }
+  return state;
+}
