+void GuideOverlay::LoadMessageBoxLayout() {
+  std::ifstream in(asset_dir_ / "msgbox.txt");
+  std::string key, name, kind;
+  int buttons, focus;
+  while (in >> key >> buttons >> focus >> name >> kind) {
+    MessageBoxItem item;
+    item.is_text = kind == "text";
+    in >> item.x >> item.y >> item.w >> item.h;
+    if (item.is_text) {
+      std::string color;
+      in >> item.size >> item.ascent >> item.line_h >> item.style >> color;
+      item.color = uint32_t(std::stoul(color, nullptr, 16));
+    }
+    message_box_layout_[buttons * 10 + focus][name] = item;
+  }
+  std::ifstream font(asset_dir_ / "XenonCLatin.ttf", std::ios::binary);
+  font_data_.assign(std::istreambuf_iterator<char>(font),
+                    std::istreambuf_iterator<char>());
+  font_ = std::make_unique<stbtt_fontinfo>();
+  if (font_data_.empty() ||
+      !stbtt_InitFont(font_.get(), font_data_.data(),
+                      stbtt_GetFontOffsetForIndex(font_data_.data(), 0))) {
+    font_.reset();
+  }
+  if (message_box_layout_.empty() || !font_) {
+    XELOGW("Guide: message box assets missing (msgbox.txt, XenonCLatin.ttf)");
+  }
+}
