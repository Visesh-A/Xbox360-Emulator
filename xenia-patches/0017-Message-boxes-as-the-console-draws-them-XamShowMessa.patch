+namespace {
+// Straight-alpha "over" of a color (0..1 channels) with coverage `a`.
+void BlendPixel(uint8_t* p, float r, float g, float b, float a) {
+  if (a <= 0.0f) {
+    return;
+  }
+  float da = p[3] / 255.0f;
+  float oa = a + da * (1.0f - a);
+  auto channel = [&](int c, float v) {
+    float out = (v * a + p[c] / 255.0f * da * (1.0f - a)) / oa;
+    p[c] = uint8_t(std::clamp(out * 255.0f + 0.5f, 0.0f, 255.0f));
+  };
+  channel(0, r);
+  channel(1, g);
+  channel(2, b);
+  p[3] = uint8_t(std::clamp(oa * 255.0f + 0.5f, 0.0f, 255.0f));
+}
+}  // namespace
+
+// As xui_render.draw_text (checked against real frames): font pixel size
+// PointSize * 4/3, lines of ascent + descent (+ LineSpacingAdjust), words
+// wrapped at the box width, TextStyle 0x400 centered / 0x200 right / 0x1000
+// vertically centered.
+void GuideOverlay::RenderText(Pixels& out, const MessageBoxItem& item,
+                            const std::u16string& text) {
+  if (!font_ || text.empty()) {
+    return;
+  }
+  const float s = layout_.scale;
+  const float scale = stbtt_ScaleForMappingEmToPixels(font_.get(), item.size * s);
+  auto advance = [&](char16_t c) {
+    int adv, lsb;
+    stbtt_GetCodepointHMetrics(font_.get(), c, &adv, &lsb);
+    return adv * scale;
+  };
+  auto measure = [&](const std::u16string& t) {
+    float w = 0;
+    for (char16_t c : t) {
+      w += advance(c);
+    }
+    return w;
+  };
+  const float box_w = item.w * s, box_h = item.h * s;
+  std::vector<std::u16string> lines;
+  std::u16string raw;
+  auto flush = [&]() {
+    if (box_w > 0 && measure(raw) > box_w) {
+      std::u16string cur;
+      size_t start = 0;
+      while (true) {
+        size_t end = raw.find(u' ', start);
+        std::u16string word = raw.substr(
+            start, end == std::u16string::npos ? std::u16string::npos
+                                               : end - start);
+        std::u16string trial = cur.empty() ? word : cur + u" " + word;
+        if (measure(trial) > box_w && !cur.empty()) {
+          lines.push_back(cur);
+          cur = word;
+        } else {
+          cur = trial;
+        }
+        if (end == std::u16string::npos) {
+          break;
+        }
+        start = end + 1;
+      }
+      lines.push_back(cur);
+    } else {
+      lines.push_back(raw);
+    }
+    raw.clear();
+  };
+  for (char16_t c : text) {
+    if (c == u'\r') {
+      continue;
+    }
+    if (c == u'\n') {
+      flush();
+    } else {
+      raw.push_back(c);
+    }
+  }
+  flush();
+
+  const float line_h = item.line_h * s, ascent = item.ascent * s;
+  const float total = line_h * lines.size();
+  const float top = (item.style & 0x1000) ? (box_h - total) / 2 : 0.0f;
+  const float r = ((item.color >> 16) & 0xFF) / 255.0f;
+  const float g = ((item.color >> 8) & 0xFF) / 255.0f;
+  const float b = (item.color & 0xFF) / 255.0f;
+  const float alpha = (item.color >> 24) / 255.0f;
+  std::vector<uint8_t> glyph;
+  for (size_t i = 0; i < lines.size(); ++i) {
+    if (top + i * line_h >= box_h) {
+      break;  // past the bottom of the box
+    }
+    const float tw = measure(lines[i]);
+    float x = item.x * s + ((item.style & 0x400)   ? (box_w - tw) / 2
+                            : (item.style & 0x200) ? box_w - tw
+                                                   : 0.0f);
+    const float baseline = item.y * s + top + i * line_h + ascent;
+    const int base_y = int(std::floor(baseline));
+    const float shift_y = baseline - base_y;
+    for (char16_t c : lines[i]) {
+      const int pen_x = int(std::floor(x));
+      const float shift_x = x - pen_x;
+      int x0, y0, x1, y1;
+      stbtt_GetCodepointBitmapBoxSubpixel(font_.get(), c, scale, scale,
+                                          shift_x, shift_y, &x0, &y0, &x1, &y1);
+      const int gw = x1 - x0, gh = y1 - y0;
+      if (gw > 0 && gh > 0) {
+        glyph.assign(size_t(gw) * gh, 0);
+        stbtt_MakeCodepointBitmapSubpixel(font_.get(), glyph.data(), gw, gh,
+                                          gw, scale, scale, shift_x, shift_y,
+                                          c);
+        for (int gy = 0; gy < gh; ++gy) {
+          int oy = base_y + y0 + gy;
+          if (oy < 0 || oy >= out.height) continue;
+          for (int gx = 0; gx < gw; ++gx) {
+            int ox = pen_x + x0 + gx;
+            if (ox < 0 || ox >= out.width) continue;
+            float cover = glyph[size_t(gy) * gw + gx] / 255.0f * alpha;
+            BlendPixel(&out.rgba[(size_t(oy) * out.width + ox) * 4], r, g, b,
+                       cover);
+          }
+        }
+      }
+      x += advance(c);
+    }
+  }
+}
+
+bool GuideOverlay::ComposeMessageBox(const kernel::xam::TitleMessageBox& box,
+                                     int focus, Pixels& out) {
+  const int buttons = int(box.buttons.size());
+  auto layout = message_box_layout_.find(buttons * 10 + focus);
+  if (layout == message_box_layout_.end() ||
+      !Decode("msgbox" + std::to_string(buttons) + "_f" + std::to_string(focus),
+              out)) {
+    return false;
+  }
+  const auto& items = layout->second;
+  static const char* const kIcons[] = {nullptr, "msgbox_icon_error",
+                                       "msgbox_icon_warning",
+                                       "msgbox_icon_alert"};
+  auto icon_item = items.find("icon");
+  if (box.icon >= 1 && box.icon <= 3 && icon_item != items.end()) {
+    Pixels icon;
+    if (Decode(kIcons[box.icon], icon)) {
+      // Bilinear, like the renderer's linear sampling.
+      const float s = layout_.scale;
+      const MessageBoxItem& it = icon_item->second;
+      int dx0 = int(std::lround(it.x * s)), dy0 = int(std::lround(it.y * s));
+      int dw = int(std::lround(it.w * s)), dh = int(std::lround(it.h * s));
+      for (int y = 0; y < dh; ++y) {
+        for (int x = 0; x < dw; ++x) {
+          float u = (x + 0.5f) * icon.width / dw - 0.5f;
+          float v = (y + 0.5f) * icon.height / dh - 0.5f;
+          int u0 = std::clamp(int(std::floor(u)), 0, icon.width - 1);
+          int v0 = std::clamp(int(std::floor(v)), 0, icon.height - 1);
+          int u1 = std::min(u0 + 1, icon.width - 1);
+          int v1 = std::min(v0 + 1, icon.height - 1);
+          float fu = std::clamp(u - u0, 0.0f, 1.0f);
+          float fv = std::clamp(v - v0, 0.0f, 1.0f);
+          float c[4] = {};
+          for (int k = 0; k < 4; ++k) {
+            int su = (k & 1) ? u1 : u0, sv = (k & 2) ? v1 : v0;
+            float wgt = ((k & 1) ? fu : 1 - fu) * ((k & 2) ? fv : 1 - fv);
+            const uint8_t* p = &icon.rgba[(size_t(sv) * icon.width + su) * 4];
+            float a = p[3] / 255.0f;
+            for (int ch = 0; ch < 3; ++ch) c[ch] += p[ch] / 255.0f * a * wgt;
+            c[3] += a * wgt;
+          }
+          int ox = dx0 + x, oy = dy0 + y;
+          if (c[3] > 0 && ox >= 0 && ox < out.width && oy >= 0 &&
+              oy < out.height) {
+            BlendPixel(&out.rgba[(size_t(oy) * out.width + ox) * 4],
+                       c[0] / c[3], c[1] / c[3], c[2] / c[3], c[3]);
+          }
+        }
+      }
+    }
+  }
+  auto text = [&](const std::string& name, const std::u16string& value) {
+    auto it = items.find(name);
+    if (it != items.end()) {
+      RenderText(out, it->second, value);
+    }
+  };
+  text("title", box.title);
+  text("text", box.text);
+  for (int i = 0; i < buttons; ++i) {
+    text("button" + std::to_string(i), box.buttons[i]);
+  }
+  return true;
+}
+
+bool GuideOverlay::ShowTitleMessageBox(const kernel::xam::TitleMessageBox& box,
+                                       std::function<void(int)> done) {
+  const int buttons = int(box.buttons.size());
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode_ != Mode::kClosed || title_done_ || buttons < 1 || buttons > 3 ||
+        !font_) {
+      return false;
+    }
+  }
+  // Composed at the Guide's image scale, then shrunk to the screen like the
+  // other images (the last size the Guide was drawn at, if any).
+  float ppu = display_h_ > 0 ? display_h_ / layout_.canvas_h : layout_.scale;
+  std::map<std::string, Pixels> images;
+  for (int focus = 0; focus < buttons; ++focus) {
+    Pixels pixels;
+    if (!ComposeMessageBox(box, focus, pixels)) {
+      return false;
+    }
+    float f = ppu / layout_.scale;
+    if (f < 1.0f) {
+      pixels = Resample(pixels, std::max(1, int(std::lround(pixels.width * f))),
+                        std::max(1, int(std::lround(pixels.height * f))));
+    }
+    images["msgbox_title_f" + std::to_string(focus)] = std::move(pixels);
+  }
+  {
+    std::lock_guard<std::mutex> lock(prepare_mutex_);
+    title_images_ = std::move(images);
+    title_images_ppu_ = ppu;
+  }
+  XELOGI("Guide: message box \"{}\" ({} buttons)", xe::to_utf8(box.title),
+         buttons);
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    page_ = Page::kTitleMessage;
+    title_buttons_ = buttons;
+    title_result_ = -1;
+    title_done_ = std::move(done);
+    choice_ = std::clamp(int(box.focus), 0, buttons - 1);
+    mode_ = Mode::kOpening;  // ClosedToError
+    transition_ = Transition::kNone;
+    anim_start_ = Clock::now();
+  }
+  PlaySfx("HUD_open");
+  app_context_.CallInUIThread([this]() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!dialog_) {
+      dialog_ = new Dialog(imgui_drawer_, this);
+    }
+  });
+  return true;
+}
