-      if (fade_from.rfind("menu", 0) == 0) {
-        DrawMenuDynamic(k, ox, oy, up, content_alpha * fade_out,
-                        view.signed_in);
-      }
-    }
+    const float scene_alpha = content_alpha;
     if (fading) content_alpha *= fade_in;
