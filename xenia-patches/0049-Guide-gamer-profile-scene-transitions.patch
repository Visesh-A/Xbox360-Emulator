       layer(content, 0.0f, content_alpha);
@@ -1955,6 +1955,21 @@ void GuideOverlay::Draw(float display_w, float display_h) {
     if (content == "axl_page" && page_ready && content_alpha > 0.0f) {
       DrawAddXboxLive(k, ox, oy, up, content_alpha);
     }
+    // The outgoing scene over the new one (they overlap only when the new
+    // scene has no transition of its own: shown at once, 821 / 828).
+    if (fading && fade_out > 0.0f && !fade_from.empty()) {
+      layer(fade_from, 0.0f, scene_alpha * fade_out);
+      if (fade_from.rfind("menu", 0) == 0) {
+        DrawMenuDynamic(k, ox, oy, up, scene_alpha * fade_out,
+                        view.signed_in);
+      }
+      // the outgoing scene's arrows go with it
+      if (fade_page == Page::kGpPrefCat || fade_page == Page::kGpPrefSet) {
+        DrawPrefs(k, ox, oy, up, scene_alpha * fade_out, fade_page);
+      } else if (fade_page == Page::kGpGames || fade_page == Page::kGpAchs) {
+        DrawViewGames(k, ox, oy, up, scene_alpha * fade_out, fade_page);
+      }
+    }
 
     // A wireless controller's battery (part of the hosted scene, so it fades
     // with it); none for a wired one, like the console.
@@ -3688,8 +3703,27 @@ void GuideOverlay::EndGamerProfile() {
   }).detach();
 }
 
+void GuideOverlay::GpFade(Page from, Page to) {
+  // 821 (GameAchievStatsMe) and 828 (AchievDetails) name no transition
+  auto has = [](Page p) {
+    return p != Page::kGpAchs && p != Page::kGpAchDetail;
+  };
+  opt_fade_out_on_ = has(from);
+  opt_fade_in_on_ = has(to);
+  if (!opt_fade_out_on_ && !opt_fade_in_on_) {
+    opt_fading_ = false;
+    return;
+  }
+  opt_fade_from_ = "opt_prev";
+  opt_fade_capture_ = true;
+  opt_fade_page_ = from;
+  opt_fading_ = true;
+  opt_fade_start_ = Clock::now();
+}
+
 void GuideOverlay::GpGoTo(Page page) {
   // XuiSceneNavigateForward to another full-width scene: the frame stays.
+  GpFade(page_, page);
   gp_back_.push_back({page_, gp_focus_});
   page_ = page;
   if (page == Page::kGpPics || page == Page::kGpPersonal) {
