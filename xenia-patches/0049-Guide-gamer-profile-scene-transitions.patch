   std::string fade_from;
+  Page fade_page = Page::kMenu;
   {
     std::lock_guard<std::mutex> lock(mutex_);
     if (opt_fade_capture_) {
@@ -1818,11 +1819,16 @@ void GuideOverlay::Draw(float display_w, float display_h) {
                       l.fps;
       if (t >= 40.0f) {
         opt_fading_ = false;
+        opt_fade_out_on_ = opt_fade_in_on_ = true;
+        opt_fade_page_ = Page::kMenu;
       } else {
         fading = true;
-        fade_out = std::max(0.0f, 1.0f - t / 15.0f);
-        fade_in = t < 25.0f ? 0.0f : (t - 25.0f) / 15.0f;
+        fade_out = opt_fade_out_on_ ? std::max(0.0f, 1.0f - t / 15.0f) : 0.0f;
+        fade_in = !opt_fade_in_on_ ? 1.0f
+                  : t < 25.0f      ? 0.0f
+                                   : (t - 25.0f) / 15.0f;
         fade_from = opt_fade_from_;
+        fade_page = opt_fade_page_;
       }
     }
   }
@@ -1930,13 +1936,7 @@ void GuideOverlay::Draw(float display_w, float display_h) {
     if (blade.show) layer("hud_blade", blade.x - 991.0f, 1.0f);
   }
   if (content_visible) {
-    if (fading && fade_out > 0.0f && !fade_from.empty()) {
