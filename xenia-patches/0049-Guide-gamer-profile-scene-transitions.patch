   const int cat = pref_cat_, row = pref_row_, top = pref_top_;
   const auto focus_at = pref_focus_at_, scroll_at = pref_scroll_at_;
   const int dir = pref_scroll_dir_;
@@ -4681,9 +4718,9 @@ bool GuideOverlay::ComposeViewGamesPage(Page page, float ppu, Pixels& out) {
 // The lists' scroll ends (ScrollMore where they can scroll; the Scrolling
