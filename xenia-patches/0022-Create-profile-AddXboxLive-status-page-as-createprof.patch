+    if (kind == "text") {
+      std::string name, color;
+      MessageBoxItem& item = axl_status_item_;
+      item.is_text = true;
+      ls >> name >> item.x >> item.y >> item.w >> item.h >> item.size >>
+          item.ascent >> item.line_h >> item.style >> color;
+      item.color = uint32_t(std::stoul(color, nullptr, 16));
+    } else if (kind == "spin") {
+      int t;
+      SpinFrame frame;
+      float w, h;
+      ls >> t >> frame.x >> frame.y >> w >> h;
+      frame.shown = w > 0 && h > 0;
+      if (t >= 0) {
+        if (axl_spin_.size() <= size_t(t)) axl_spin_.resize(t + 1);
+        axl_spin_[t] = frame;
+      }
+    } else if (kind == "spin_frames") {
+      ls >> axl_spin_loop_;
+    }
+  }
+  if (axl_spin_.empty()) {
+    XELOGW("Guide: AddXboxLive assets missing (axl.txt)");
+  }
+}
+
+void GuideOverlay::DrawAddXboxLive(float k, float ox, float oy, float up,
+                                   float alpha) {
+  auto V = [up](float x, float y) { return ImVec2(x * up, y * up); };
+  ImDrawList* draw_list = ImGui::GetForegroundDrawList();
+  const ImU32 tint = IM_COL32(255, 255, 255, int(alpha * 255.0f + 0.5f));
+  // The wait cursor: its loop from the page's start; frames 36-85 are the
+  // same as 36 (every light holds from there).
+  float frames = std::chrono::duration<float>(Clock::now() - axl_start_)
+                     .count() *
+                 layout_.fps;
+  int t = int(frames) % std::max(1, axl_spin_loop_);
+  t = std::min(t, int(axl_spin_.size()) - 1);
+  if (t >= 0 && axl_spin_[t].shown) {
+    if (const Image* spin = Texture("axl_spin_" + std::to_string(t), k)) {
+      float x = std::round(ox + axl_spin_[t].x * k);
+      float y = std::round(oy + axl_spin_[t].y * k);
+      draw_list->AddImage(reinterpret_cast<ImTextureID>(spin->texture.get()),
+                          V(x, y), V(x + spin->width, y + spin->height),
+                          ImVec2(0, 0), ImVec2(1, 1), tint);
+    }
+  }
+  // The status line (statusText, XuiLabelCenterJustify), in the console font.
+  std::u16string status;
+  uint64_t version;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    status = axl_status_;
+    version = axl_text_version_;
+  }
+  Image& text = images_["axl_text"];
+  if (!text.texture || axl_text_ppu_ != k || axl_text_drawn_ != version) {
+    Pixels pixels;
+    pixels.width = int(std::ceil(layout_.canvas_w * k));
+    pixels.height = int(std::ceil(layout_.canvas_h * k));
+    pixels.rgba.assign(size_t(pixels.width) * pixels.height * 4, 0);
+    RenderText(pixels, axl_status_item_, status, k);
+    text.texture = imgui_drawer_->CreateImGuiTexture(
+        pixels.width, pixels.height, pixels.rgba.data());
+    text.width = pixels.width;
+    text.height = pixels.height;
+    axl_text_ppu_ = k;
+    axl_text_drawn_ = version;
+  }
+  if (text.texture) {
+    draw_list->AddImage(reinterpret_cast<ImTextureID>(text.texture.get()),
+                        V(ox, oy), V(ox + text.width, oy + text.height),
+                        ImVec2(0, 0), ImVec2(1, 1), tint);
+  }
+}
