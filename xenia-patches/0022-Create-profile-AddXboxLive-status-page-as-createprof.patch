+void GuideOverlay::Schedule(Clock::time_point when, std::function<void()> job) {
+  {
+    std::lock_guard<std::mutex> lock(schedule_mutex_);
+    schedule_.emplace(when, std::move(job));
+  }
+  schedule_cv_.notify_all();
+}
+
+void GuideOverlay::ScheduleThread() {
+  std::unique_lock<std::mutex> lock(schedule_mutex_);
+  while (running_) {
+    if (schedule_.empty()) {
+      schedule_cv_.wait(lock);
+      continue;
+    }
+    auto it = schedule_.begin();
+    if (Clock::now() < it->first) {
+      schedule_cv_.wait_until(lock, it->first);
+      continue;
+    }
+    auto job = std::move(it->second);
+    schedule_.erase(it);
+    lock.unlock();
+    job();
+    lock.lock();
+  }
+}
