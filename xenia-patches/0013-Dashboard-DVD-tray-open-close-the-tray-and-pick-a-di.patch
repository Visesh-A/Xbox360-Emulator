@@ -59,9 +60,14 @@ DECLARE_XBOXKRNL_EXPORT3(HalSendSMCMessage, kNone, kStub, kImportant,
 // 1 opens the tray, 0 closes it: the blades dashboard's disc tile calls it
 // with 1 when XamLoaderGetDvdTrayState says closed (0), labelled "Open Tray",
 // and with 0 when it says open (2), labelled "Close Tray".
