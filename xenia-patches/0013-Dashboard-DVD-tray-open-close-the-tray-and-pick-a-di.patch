+#ifndef XENIA_APP_DISC_PICKER_H_
+#define XENIA_APP_DISC_PICKER_H_
+
+#include <atomic>
+#include <filesystem>
+#include <thread>
+
+namespace xe {
+class Emulator;
+namespace app {
+
+// Plays the part of the player's hand at the DVD drive: when a dashboard
+// opens the tray, a small Windows window (not part of the console's UI) lists
+// the disc images in --disc_folder. The chosen one goes in the tray and is
+// read when the dashboard closes it. Works with the controller (D-pad/stick to
+// choose, A insert, B leave as is), the keyboard or the mouse.
+class DiscPicker {
+ public:
+  DiscPicker(Emulator* emulator, void* owner_hwnd);
+  ~DiscPicker();
+
+  static bool IsEnabled();
+  void Show();  // any thread; ignored while already open
+
+ private:
+  void Run();
+
+  Emulator* emulator_;
+  void* owner_hwnd_;
+  std::atomic<bool> open_{false};
+  std::thread thread_;
+};
+
+}  // namespace app
+}  // namespace xe
+
+#endif  // XENIA_APP_DISC_PICKER_H_
