+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/app/disc_picker.h"
+
+#include <algorithm>
+#include <chrono>
+#include <string>
+#include <vector>
+
+#include "xenia/base/cvar.h"
+#include "xenia/base/logging.h"
+#include "xenia/base/platform_win.h"
+#include "xenia/base/filesystem.h"
+#include "xenia/base/utf8.h"
+#include "xenia/emulator.h"
+#include "xenia/hid/input.h"
+#include "xenia/hid/input_system.h"
+#include "xenia/kernel/kernel_state.h"
+#include "xenia/kernel/xam/xam_state.h"
+
+DEFINE_path(disc_folder, "",
+            "Folder of disc images (.iso) offered when a dashboard opens the "
+            "DVD tray; the chosen one is read when the tray closes.",
+            "General");
+
+namespace xe {
+namespace app {
+
+namespace {
+constexpr int kIdList = 100, kIdInsert = 101, kIdCancel = 102;
+constexpr UINT kClose = WM_APP + 1;
+
+struct PickerState {
+  std::vector<std::filesystem::path> discs;  // [0] = no disc
+  int result = -1;                           // index, -1 = leave as is
+  HWND list = nullptr;
+  bool done = false;
+};
+
+LRESULT CALLBACK PickerProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
+  auto* st = reinterpret_cast<PickerState*>(GetWindowLongPtrW(hwnd, GWLP_USERDATA));
+  switch (msg) {
+    case WM_COMMAND:
+      if (!st) break;
+      if (LOWORD(wp) == kIdInsert ||
+          (LOWORD(wp) == kIdList && HIWORD(wp) == LBN_DBLCLK)) {
+        st->result = int(SendMessageW(st->list, LB_GETCURSEL, 0, 0));
+        st->done = true;
+      } else if (LOWORD(wp) == kIdCancel) {
+        st->done = true;
+      }
+      return 0;
+    case WM_CLOSE:
+      if (st) st->done = true;
+      return 0;
+  }
+  return DefWindowProcW(hwnd, msg, wp, lp);
+}
+}  // namespace
+
+bool DiscPicker::IsEnabled() { return !cvars::disc_folder.empty(); }
+
+DiscPicker::DiscPicker(Emulator* emulator, void* owner_hwnd)
+    : emulator_(emulator), owner_hwnd_(owner_hwnd) {}
+
+DiscPicker::~DiscPicker() {
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+}
+
+void DiscPicker::Show() {
+  if (open_.exchange(true)) {
+    return;
+  }
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+  thread_ = std::thread([this]() {
+    Run();
+    open_ = false;
+  });
+}
+
+void DiscPicker::Run() {
+  PickerState st;
+  st.discs.push_back({});
+  std::error_code ec;
+  for (auto& entry : std::filesystem::directory_iterator(cvars::disc_folder, ec)) {
+    auto ext = xe::utf8::lower_ascii(xe::path_to_utf8(entry.path().extension()));
+    if (entry.is_regular_file() && ext == ".iso") {
+      st.discs.push_back(entry.path());
+    }
+  }
+  std::sort(st.discs.begin() + 1, st.discs.end());
+  auto in_tray = emulator_->tray_disc();
+  int selected = 0;
+  for (size_t i = 1; i < st.discs.size(); ++i) {
+    if (st.discs[i] == in_tray) selected = int(i);
+  }
+
+  HINSTANCE inst = GetModuleHandleW(nullptr);
+  WNDCLASSW wc = {};
+  wc.lpfnWndProc = PickerProc;
+  wc.hInstance = inst;
+  wc.hCursor = LoadCursorW(nullptr, IDC_ARROW);
+  wc.hbrBackground = reinterpret_cast<HBRUSH>(COLOR_BTNFACE + 1);
+  wc.lpszClassName = L"XeniaDiscPicker";
+  RegisterClassW(&wc);  // fails harmlessly when already registered
+
+  const int w = 560, h = 380;
+  RECT owner = {0, 0, GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN)};
+  if (owner_hwnd_) GetWindowRect(HWND(owner_hwnd_), &owner);
+  int x = owner.left + (owner.right - owner.left - w) / 2;
+  int y = owner.top + (owner.bottom - owner.top - h) / 2;
+  HWND hwnd = CreateWindowExW(
+      WS_EX_TOPMOST | WS_EX_DLGMODALFRAME, wc.lpszClassName,
+      L"Xbox 360 DVD drive \x2014 insert a disc",
+      WS_POPUP | WS_CAPTION | WS_SYSMENU, x, y, w, h, HWND(owner_hwnd_),
+      nullptr, inst, nullptr);
+  if (!hwnd) {
+    XELOGE("Disc picker: CreateWindowEx failed");
+    return;
+  }
+  SetWindowLongPtrW(hwnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(&st));
+  HFONT font = CreateFontW(-18, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0,
+                           CLEARTYPE_QUALITY, 0, L"Segoe UI");
+  auto child = [&](const wchar_t* cls, const wchar_t* text, DWORD style, int cx,
+                   int cy, int cw, int ch, int id) {
+    HWND c = CreateWindowExW(0, cls, text, WS_CHILD | WS_VISIBLE | style, cx, cy,
+                             cw, ch, hwnd, HMENU(INT_PTR(id)), inst, nullptr);
+    SendMessageW(c, WM_SETFONT, WPARAM(font), TRUE);
+    return c;
+  };
+  child(L"STATIC",
+        L"Choose a disc, then select Close Tray on the dashboard.\nController: D-pad to choose, A insert, B leave as is.",
+        0, 16, 10, w - 48, 52, 0);
+  st.list = child(L"LISTBOX", L"",
+                  WS_BORDER | WS_VSCROLL | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT, 16,
+                  70, w - 48, h - 166, kIdList);
+  for (size_t i = 0; i < st.discs.size(); ++i) {
+    std::wstring name = i == 0 ? std::wstring(L"(No disc)")
+                               : st.discs[i].stem().wstring();
+    SendMessageW(st.list, LB_ADDSTRING, 0, LPARAM(name.c_str()));
+  }
+  SendMessageW(st.list, LB_SETCURSEL, selected, 0);
+  child(L"BUTTON", L"Insert disc", BS_DEFPUSHBUTTON | WS_TABSTOP, w - 272,
+        h - 86, 120, 34, kIdInsert);
+  child(L"BUTTON", L"Cancel", WS_TABSTOP, w - 144, h - 86, 112, 34, kIdCancel);
+  ShowWindow(hwnd, SW_SHOW);
+  SetForegroundWindow(hwnd);
+  SetFocus(st.list);
+
+  // While the picker is open the dashboard gets no controller input, like
+  // while the Guide is up.
+  auto* xam_state = emulator_->kernel_state()->xam_state();
+  xam_state->xam_dialogs_shown_++;
+  auto input = emulator_->input_system();
+  uint16_t prev = 0xFFFF;  // ignore buttons already held when it opened
+  auto next_repeat = std::chrono::steady_clock::now();
+  while (!st.done) {
+    MSG m;
+    while (PeekMessageW(&m, nullptr, 0, 0, PM_REMOVE)) {
+      if (m.message == WM_KEYDOWN && m.wParam == VK_RETURN) {
+        st.result = int(SendMessageW(st.list, LB_GETCURSEL, 0, 0));
+        st.done = true;
+      } else if (m.message == WM_KEYDOWN && m.wParam == VK_ESCAPE) {
+        st.done = true;
+      } else if (!IsDialogMessageW(hwnd, &m)) {
+        TranslateMessage(&m);
+        DispatchMessageW(&m);
+      }
+    }
+    uint16_t buttons = 0;
+    float ly = 0;
+    if (input) {
+      auto lock = input->lock();
+      for (uint32_t user = 0; user < 4; ++user) {
+        hid::X_INPUT_STATE state = {};
+        if (input->GetState(user, hid::X_INPUT_FLAG::X_INPUT_FLAG_GAMEPAD,
+                            &state) == X_ERROR_SUCCESS) {
+          buttons |= state.gamepad.buttons;
+          if (std::abs(int(state.gamepad.thumb_ly)) > std::abs(ly * 32767)) {
+            ly = state.gamepad.thumb_ly / 32767.0f;
+          }
+        }
+      }
+    }
+    if (prev == 0xFFFF) prev = buttons;
+    uint16_t pressed = buttons & ~prev;
+    prev = buttons;
+    int dir = (buttons & hid::X_INPUT_GAMEPAD_DPAD_UP) || ly > 0.5f     ? -1
+              : (buttons & hid::X_INPUT_GAMEPAD_DPAD_DOWN) || ly < -0.5f ? 1
+                                                                           : 0;
+    auto now = std::chrono::steady_clock::now();
+    bool fresh = pressed & (hid::X_INPUT_GAMEPAD_DPAD_UP | hid::X_INPUT_GAMEPAD_DPAD_DOWN);
+    if (dir && (fresh || now >= next_repeat)) {
+      int cur = int(SendMessageW(st.list, LB_GETCURSEL, 0, 0));
+      int count = int(SendMessageW(st.list, LB_GETCOUNT, 0, 0));
+      SendMessageW(st.list, LB_SETCURSEL, std::clamp(cur + dir, 0, count - 1), 0);
+      next_repeat = now + std::chrono::milliseconds(fresh ? 400 : 150);
+    }
+    if (pressed & hid::X_INPUT_GAMEPAD_A) {
+      st.result = int(SendMessageW(st.list, LB_GETCURSEL, 0, 0));
+      st.done = true;
+    } else if (pressed & hid::X_INPUT_GAMEPAD_B) {
+      st.done = true;
+    }
+    Sleep(16);
+  }
+  if (st.result >= 0 && st.result < int(st.discs.size())) {
+    emulator_->SetTrayDisc(st.discs[st.result]);
+  }
+  DestroyWindow(hwnd);
+  DeleteObject(font);
+  if (owner_hwnd_) SetForegroundWindow(HWND(owner_hwnd_));
+  // Let go of the buttons before the dashboard sees input again (A would
+  // otherwise also press the dashboard's selected item).
+  for (int i = 0; i < 60 && input; ++i) {
+    uint16_t held = 0;
+    {
+      auto lock = input->lock();
+      for (uint32_t user = 0; user < 4; ++user) {
+        hid::X_INPUT_STATE state = {};
+        if (input->GetState(user, hid::X_INPUT_FLAG::X_INPUT_FLAG_GAMEPAD,
+                            &state) == X_ERROR_SUCCESS) {
+          held |= state.gamepad.buttons;
+        }
+      }
+    }
+    if (!(held & (hid::X_INPUT_GAMEPAD_A | hid::X_INPUT_GAMEPAD_B))) break;
+    Sleep(16);
+  }
+  xam_state->xam_dialogs_shown_--;
+}
+
+}  // namespace app
+}  // namespace xe
