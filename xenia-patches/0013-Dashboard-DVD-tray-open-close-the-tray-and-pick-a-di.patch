+bool Emulator::InsertDisc(const std::filesystem::path& path) {
+  if (file_system_->HasDevice("\\Device\\Cdrom0")) {
+    file_system_->UnregisterDevice("\\Device\\Cdrom0");
+  }
+  disc_path_.clear();
+  if (path.empty()) {
+    return true;
+  }
+  auto disc = CreateVfsDevice(path, "\\Device\\Cdrom0");
+  if (!disc || !disc->Initialize() ||
+      !file_system_->RegisterDevice(std::move(disc))) {
+    return false;
+  }
+  disc_path_ = path;
+  return true;
+}
+
+void Emulator::OpenTray() {
+  {
+    std::lock_guard<std::mutex> lock(disc_mutex_);
+    tray_disc_ = disc_path_;  // the disc stays in the tray until swapped
+  }
+  kernel_state_->smc()->SetTrayState(X_DVD_TRAY_STATE::OPEN);
+  XELOGI("DVD tray opened");
+  if (on_tray_opened) {
+    on_tray_opened();
+  }
+}
+
+void Emulator::CloseTray() {
+  {
+    std::lock_guard<std::mutex> lock(disc_mutex_);
+    if (tray_disc_ != disc_path_ && !InsertDisc(tray_disc_)) {
+      XELOGE("Unable to load disc: {}", xe::path_to_utf8(tray_disc_));
+    }
+    XELOGI("DVD tray closed with {}",
+           disc_path_.empty() ? std::string("no disc")
+                              : xe::path_to_utf8(disc_path_));
+    // Remembered like a disc left in a switched-off console.
+    if (FILE* file = xe::filesystem::OpenFile("dvd_drive.txt", "wb")) {
+      std::string p = xe::path_to_utf8(disc_path_);
+      fwrite(p.data(), 1, p.size(), file);
+      fclose(file);
+    }
+  }
+  kernel_state_->smc()->SetTrayState(X_DVD_TRAY_STATE::CLOSED);
+}
+
+void Emulator::SetTrayDisc(const std::filesystem::path& path) {
+  std::lock_guard<std::mutex> lock(disc_mutex_);
+  tray_disc_ = path;
+  XELOGI("Disc put in the tray: {}",
+         path.empty() ? std::string("none") : xe::path_to_utf8(path));
+}
+
+std::filesystem::path Emulator::disc_path() {
+  std::lock_guard<std::mutex> lock(disc_mutex_);
+  return disc_path_;
+}
+
+std::filesystem::path Emulator::tray_disc() {
+  std::lock_guard<std::mutex> lock(disc_mutex_);
+  return tray_disc_;
+}
