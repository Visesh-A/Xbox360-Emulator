+std::function<bool()> live_upsell_ui_hook;
+
+// The Guide's Xbox Live upsell ("Join Xbox Live", InfoUpsellLive.xur). The
+// blades dashboard calls it from Join Xbox Live and its Xbox Live banner and
+// ignores the result.
+dword_result_t XamShowLiveUpsellUI_entry(dword_t user_index, dword_t flags) {
+  if (live_upsell_ui_hook && live_upsell_ui_hook()) {
+    return X_ERROR_SUCCESS;
+  }
+  return X_ERROR_FUNCTION_FAILED;
+}
+DECLARE_XAM_EXPORT1(XamShowLiveUpsellUI, kUI, kSketchy);
+
+// Xbox Live account sign-up / gamertag recovery: needs the Xbox Live service,
+// which is not emulated. (Defined so callers get a failure rather than an
+// undefined import; the dashboard's Recover Gamertag ignores the result.)
+dword_result_t XamShowLiveSignupUI_entry(dword_t user_index, dword_t flags) {
+  XELOGI("XamShowLiveSignupUI({}, {:X}): Xbox Live is not available",
+         uint32_t(user_index), uint32_t(flags));
+  return X_ERROR_FUNCTION_FAILED;
+}
+DECLARE_XAM_EXPORT1(XamShowLiveSignupUI, kUI, kStub);
