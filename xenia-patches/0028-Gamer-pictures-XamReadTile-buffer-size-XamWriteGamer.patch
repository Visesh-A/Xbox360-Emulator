+X_RESULT WriteGamerPicture(uint64_t xuid, uint32_t title_id, uint32_t big_id,
+                           uint32_t small_id) {
+  auto user = kernel_state()->xam_state()->GetUserProfile(xuid);
+  if (!user) {
+    return X_ERROR_NO_SUCH_USER;
+  }
+  // The pictures as xam's resources hold them (shrdres
+  // 64_ / 32_<title><big id><small id>.png), copied to gamerpics\.
+  const std::string key =
+      fmt::format("{:08x}{:08x}{:08x}", title_id, big_id, small_id);
+  const auto folder = xe::filesystem::GetExecutableFolder() / "gamerpics";
+  auto read = [&](const char* size) {
+    std::vector<uint8_t> data;
+    FILE* file = xe::filesystem::OpenFile(
+        folder / fmt::format("{}_{}.png", size, key), "rb");
+    if (file) {
+      fseek(file, 0, SEEK_END);
+      data.resize(size_t(ftell(file)));
+      fseek(file, 0, SEEK_SET);
+      data.resize(fread(data.data(), 1, data.size(), file));
+      fclose(file);
+    }
+    return data;
+  };
+  const std::vector<uint8_t> tile_64 = read("64"), tile_32 = read("32");
+  if (tile_64.empty() || tile_32.empty()) {
+    XELOGW("WriteGamerPicture: no picture {}", key);
+    return X_ERROR_FILE_NOT_FOUND;
+  }
+  // (stored by size: tile_64.png / tile_32.png)
+  auto* tracker = kernel_state()->xam_state()->user_tracker();
+  tracker->UpdateUserIcon(xuid, tile_64);
+  tracker->UpdateUserIcon(xuid, tile_32);
+  // the gamercard's picture key, as the default one is kept
+  const UserSetting setting(
+      UserSettingId::XPROFILE_GAMERCARD_PICTURE_KEY,
+      xe::string_util::read_u16string_and_swap(
+          xe::to_utf16(fmt::format("{:08X}{:08X}{:08X}", title_id, big_id,
+                                   small_id))
+              .c_str()));
+  tracker->UpsertSetting(xuid, kDashboardID, &setting);
+  XELOGI("Gamer picture {} written for {:016X}", key, xuid);
+  return X_ERROR_SUCCESS;
+}
+
+// As createprofile calls it (90108970): (user index, title, big tile id,
+// small tile id, 0, overlapped); xam stores the picture's two sizes in the
+// profile and sets its gamercard picture key.
