-                                       dword_t small_tile_id,
-                                       dword_t big_tile_id, dword_t arg5,
+                                       dword_t big_tile_id,
+                                       dword_t small_tile_id, dword_t arg5,
                                        dword_t overlapped_ptr) {
+  X_RESULT result = X_ERROR_NO_SUCH_USER;
+  if (auto user = kernel_state()->xam_state()->GetUserProfile(user_index)) {
+    result = WriteGamerPicture(user->xuid(), title_id, big_tile_id,
+                               small_tile_id);
+  }
   if (overlapped_ptr) {
-    kernel_state()->CompleteOverlappedImmediate(overlapped_ptr,
-                                                X_ERROR_SUCCESS);
+    kernel_state()->CompleteOverlappedImmediate(overlapped_ptr, result);
     return X_ERROR_IO_PENDING;
   }
-  return X_ERROR_SUCCESS;
+  return result;
 }
