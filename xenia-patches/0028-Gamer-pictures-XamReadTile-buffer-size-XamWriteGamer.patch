+// Congratulations' gamerTileImage: the picture (xam's 64x64 PNG, read by
+// the scene with XamReadTile) drawn into its box.
+void GuideOverlay::DrawGamerPicture(Pixels& out, int picture, float ppu) {
+  if (picture <= 0 || save_tile_[2] <= 0) {
+    return;
+  }
+  auto it = gamer_pictures_.find(picture);
+  if (it == gamer_pictures_.end()) {
+    Pixels pixels;
+    auto path = xe::filesystem::GetExecutableFolder() / "gamerpics" /
+                fmt::format("64_fffe07d1{:08x}{:08x}.png", 0x20000 + picture,
+                            0x10000 + picture);
+    std::ifstream file(path, std::ios::binary);
+    std::vector<uint8_t> data((std::istreambuf_iterator<char>(file)),
+                              std::istreambuf_iterator<char>());
+    int channels;
+    if (uint8_t* rgba = stbi_load_from_memory(
+            data.data(), int(data.size()), &pixels.width, &pixels.height,
+            &channels, STBI_rgb_alpha)) {
+      pixels.rgba.assign(rgba,
+                         rgba + size_t(pixels.width) * pixels.height * 4);
+      stbi_image_free(rgba);
+    }
+    it = gamer_pictures_.emplace(picture, std::move(pixels)).first;
+  }
+  if (it->second.rgba.empty()) {
+    return;
+  }
+  const int x0 = int(std::lround(save_tile_[0] * ppu));
+  const int y0 = int(std::lround(save_tile_[1] * ppu));
+  const int w = std::max(1, int(std::lround(save_tile_[2] * ppu)));
+  const int h = std::max(1, int(std::lround(save_tile_[3] * ppu)));
+  Pixels tile = Resample(it->second, w, h);
+  for (int y = 0; y < h; ++y) {
+    int oy = y0 + y;
+    if (oy < 0 || oy >= out.height) continue;
+    for (int x = 0; x < w; ++x) {
+      int ox = x0 + x;
+      if (ox < 0 || ox >= out.width) continue;
+      const uint8_t* p = &tile.rgba[(size_t(y) * w + x) * 4];
+      BlendPixel(&out.rgba[(size_t(oy) * out.width + ox) * 4], p[0] / 255.0f,
+                 p[1] / 255.0f, p[2] / 255.0f, p[3] / 255.0f);
+    }
+  }
+}
