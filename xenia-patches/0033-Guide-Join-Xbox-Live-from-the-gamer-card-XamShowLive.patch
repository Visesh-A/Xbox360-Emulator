+      // 9010CB28: +0x444 = 1 and the scene closes; then (9010C898)
+      // XamShowLiveSignupUI(the user, 0): createprofile's Xbox Live steps.
+      const uint32_t user_index = hud_user_;
+      lock.unlock();
+      EndGamerProfile();
+      std::thread([this, user_index]() {
