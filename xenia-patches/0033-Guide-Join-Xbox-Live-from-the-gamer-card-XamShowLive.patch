+bool GuideOverlay::ShowLiveSignup(uint32_t user_index) {
+  if (!create_profile_ready_) {
+    return false;
+  }
+  auto* user =
+      emulator_->kernel_state()->xam_state()->GetUserProfile(user_index);
+  if (!user) {
+    return false;
+  }
+  uint64_t run;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode_ != Mode::kClosed || create_profile_active_ || gp_active_) {
+      return false;
+    }
+    // xam 818EDD78: system UI message 0x2100E (createprofile.xex) with mode 1
+    // (flags 0); createprofile's first scene for modes 1 and 2 is
+    // AddXboxLive.xur (90105388), which goes straight to its Xbox Live steps
+    // (90103880 -> 90103278) for the signed-in profile.
+    create_profile_active_ = true;
+    live_signup_ = true;
+    create_user_index_ = user_index;
+    hud_user_ = user_index;
+    created_xuid_ = user->xuid();
+    axl_signed_in_ = true;
+    axl_status_key_.clear();
+    axl_status_.clear();
+    axl_button_ = "getLiveButton";
+    profile_box_done_ = nullptr;
+    profile_box_next_.reset();
+    run = ++axl_run_;
+    axl_start_ = Clock::now();
+    ++page_version_;
+  }
+  if (display_h_ > 0) {
+    float ppu = display_h_ / layout_.canvas_h;
+    if (scaling_for_ != ppu) {
+      scaling_for_ = ppu;
+      scaled_ready_ = false;
+      if (scale_thread_.joinable()) scale_thread_.join();
+      scale_thread_ =
+          std::thread([this, ppu]() { PrepareCreateProfileImages(ppu); });
+    }
+  }
+  emulator_->kernel_state()->BroadcastNotification(
+      xe::kXNotificationSystemUI, true);
+  XELOGI("Guide: Xbox Live sign-up (createprofile.xex, mode 1)");
+  Open(Page::kAddXboxLive);  // a half-width scene: ClosedToHalf
+  Schedule(Clock::now() + kToHalfTime, [this, run]() {
+    if (AddXboxLiveRunning(run)) JoinXboxLive(run);
+  });
+  return true;
+}
