+// The scenes' inits read their settings for the Guide's user.
+void GuideOverlay::OptLoadValues(Page page) {
+  auto* state = emulator_->kernel_state()->xam_state();
+  uint32_t user_index;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    user_index = opt_user_;
+  }
+  auto* user = state->GetUserProfile(user_index);
+  auto read = [&](uint32_t id) -> std::optional<int32_t> {
+    if (!user) return std::nullopt;
+    auto setting = state->user_tracker()->GetSetting(user, kernel::kDashboardID,
+                                                     id);
+    if (!setting) return std::nullopt;
+    auto data = setting->get_host_data();
+    if (auto* v = std::get_if<int32_t>(&data)) return *v;
+    if (auto* u = std::get_if<uint32_t>(&data)) return int32_t(*u);
+    return std::nullopt;
+  };
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (page == Page::kOptVib) {
+    // 9144B828: checked first, then the setting (non-zero = on)
+    opt_vib_ = true;
+    if (auto v = read(kVibration)) opt_vib_ = *v != 0;
+  } else if (page == Page::kOptVoice) {
+    // 9144B290: unmuted, Play Through Speakers, the slider at its maximum;
+    // then the settings
+    opt_mute_ = false;
+    opt_output_ = 1;
+    opt_volume_ = 10;
+    if (auto v = read(kVoiceMuted)) opt_mute_ = *v != 0;
+    if (auto v = read(kVoiceOutput)) opt_output_ = std::clamp(*v, 0, 2);
+    if (auto v = read(kVoiceVolume)) {
+      const float volume = float(std::min(*v, 100));
+      // 9144B434: (value * 0.01f) * (max - min), single precision, truncated
+      opt_volume_ = int((volume * 0.01f) * 10.0f);
+    }
+  } else if (page == Page::kOptOnl) {
+    // 9144A8B0: XamGetUserPresetPresenceState's state as the radio
+    auto it = opt_presence_by_user_.find(user_index);
+    opt_presence_ = it != opt_presence_by_user_.end() ? it->second : 0;
+  }
+  ++page_version_;
+}
+
+void GuideOverlay::OptWriteSetting(uint32_t id, int32_t value) {
+  auto* state = emulator_->kernel_state()->xam_state();
+  uint32_t user_index;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    user_index = opt_user_;
+  }
+  auto* user = state->GetUserProfile(user_index);
+  if (!user) return;
+  const kernel::xam::UserSetting setting(
+      static_cast<kernel::xam::UserSettingId>(id), value);
+  state->user_tracker()->UpsertSetting(user->xuid(), kernel::kDashboardID,
+                                       &setting);
+  XELOGI("Guide: profile setting {:08X} = {}", id, value);
+}
+
+}  // namespace app
+}  // namespace xe
