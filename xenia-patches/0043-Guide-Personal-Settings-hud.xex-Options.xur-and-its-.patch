+// hud's profile settings (XamUserRead/WriteProfileSettings, title FFFE07D1)
+constexpr uint32_t kVibration = 0x10040003;  // 9144B828 / 9144B6C0
+constexpr uint32_t kVoiceMuted = 0x1004000C;  // 9144B290 / 9144AEB0
+constexpr uint32_t kVoiceOutput = 0x1004000D;  // 9144B018: 0-2
+constexpr uint32_t kVoiceVolume = 0x1004000E;  // 9144B0C8: 0-100
+// OptionsOnline's radios -> XamSetUserPresetPresenceState (9144A748)
+constexpr uint32_t kPresence[4] = {1, 0x10001, 0x20001, 5};
+// trans_FadeOut: opacity 1 -> 0 over frames 0-15; trans_FadeIn: hidden
+// until 25, then 0 -> 1 by 40
+constexpr float kFadeOutEnd = 15.0f, kFadeInStart = 25.0f,
+                kFadeInEnd = 40.0f;
+
+void Blend(uint8_t* p, const uint8_t* c) {
+  const float a = c[3] / 255.0f;
+  if (a <= 0.0f) return;
+  const float da = p[3] / 255.0f;
+  const float oa = a + da * (1.0f - a);
+  for (int i = 0; i < 3; ++i) {
+    const float v =
+        (c[i] / 255.0f * a + p[i] / 255.0f * da * (1.0f - a)) / oa;
+    p[i] = uint8_t(std::clamp(v * 255.0f + 0.5f, 0.0f, 255.0f));
+  }
+  p[3] = uint8_t(std::clamp(oa * 255.0f + 0.5f, 0.0f, 255.0f));
+}
