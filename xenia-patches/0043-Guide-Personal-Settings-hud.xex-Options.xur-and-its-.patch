+
+void GuideOverlay::LoadOptionsLayout() {
+  std::ifstream in(asset_dir_ / "options.txt");
+  std::string line;
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::istringstream ls(line);
+    std::string kind, page;
+    ls >> kind >> page;
+    OptPage& p = opt_pages_[page];
+    if (kind == "page") {
+      std::string scene;
+      ls >> scene >> p.default_focus;
+    } else if (kind == "order") {
+      std::string id;
+      while (ls >> id) p.order.push_back(id);
+    } else if (kind == "ctrl") {
+      OptCtrl c;
+      ls >> c.id >> c.kind >> c.up >> c.down;
+      p.ctrls.push_back(c);
+    } else if (kind == "layer") {
+      std::string id, state;
+      int x, y;
+      ls >> id >> state >> x >> y;
+      p.layers[id + "_" + state] = {x, y};
+    }
+  }
+  opt_ready_ = opt_pages_.size() == 5;
+  for (const char* key : {"opt", "optvib", "optnot", "optonl", "optvoice"}) {
+    if (!opt_pages_.count(key) || opt_pages_[key].ctrls.empty()) {
+      opt_ready_ = false;
+    }
+  }
+}
