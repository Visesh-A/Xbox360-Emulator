+// btnOptions' PressPath (XuiNavButton): XuiSceneNavigateForward to
+// Options.xur within the half-width Guide.
+void GuideOverlay::OptOpen() {
+  auto* state = emulator_->kernel_state()->xam_state();
+  opt_user_ = hud_user_;
+  if (!menu_signed_in_) {
+    opt_hud_state_ = 6;
+  } else {
+    auto* user = state->GetUserProfile(uint32_t(hud_user_));
+    opt_hud_state_ = user && user->IsLiveEnabled() ? 8 : 9;
+  }
+  opt_back_.clear();
+  OptGoTo(Page::kOpt);
+}
+
+void GuideOverlay::OptGoTo(Page page) {
+  // the outgoing scene's image fades out (trans_FadeOut) while this one
+  // waits, then fades in (trans_FadeIn)
+  if (page_ == Page::kMenu) {
+    const auto& menu = menu_signed_in_ ? layout_.menu_si : layout_.menu;
+    opt_fade_from_ = focus_ >= 0 && focus_ < int(menu.size())
+                         ? (menu_signed_in_ ? "menusi_" : "menu_") +
+                               menu[focus_].id
+                         : std::string();
+    opt_fade_capture_ = false;
+  } else {
+    opt_fade_from_ = "opt_prev";
+    opt_fade_capture_ = true;
+  }
+  if (OptKey(page_)) {
+    opt_back_.push_back({page_, opt_focus_});
+  }
+  page_ = page;
+  opt_focus_ = OptFirstFocus(page);
+  opt_fading_ = true;
+  opt_fade_start_ = std::chrono::steady_clock::now();
+  ++page_version_;
+  const Page init = page;
+  std::thread([this, init]() { OptLoadValues(init); }).detach();
+}
+
+void GuideOverlay::OptNavigateBack() {
+  opt_fade_from_ = "opt_prev";
+  opt_fade_capture_ = true;
+  opt_fading_ = true;
+  opt_fade_start_ = std::chrono::steady_clock::now();
+  if (opt_back_.empty()) {
+    // back to the main menu, on btnOptions (XUI keeps the focus)
+    page_ = Page::kMenu;
+    const auto& menu = menu_signed_in_ ? layout_.menu_si : layout_.menu;
+    for (size_t i = 0; i < menu.size(); ++i) {
+      if (menu[i].id == "btnOptions") focus_ = int(i);
+    }
+  } else {
+    page_ = opt_back_.back().first;
+    opt_focus_ = opt_back_.back().second;
+    opt_back_.pop_back();
+  }
+  ++page_version_;
+}
+
+void GuideOverlay::OptMove(Direction direction) {
+  const char* key = OptKey(page_);
+  if (!key || opt_fading_) return;
+  const OptPage& p = opt_pages_[key];
+  auto find = [&](const std::string& id) -> const OptCtrl* {
+    for (const auto& c : p.ctrls) {
+      if (c.id == id) return &c;
+    }
+    return nullptr;
+  };
+  const OptCtrl* cur = find(opt_focus_);
+  if (!cur) return;
+  if (direction == kLeft || direction == kRight) {
+    if (cur->kind != "slider") return;
+    // XuiSlider (8192DC08): a step (1) toward the end, within 0-10
+    const int next =
+        std::clamp(opt_volume_ + (direction == kRight ? 1 : -1), 0, 10);
+    if (next == opt_volume_) return;
+    opt_volume_ = next;
+    ++page_version_;
+    // 9144B0C8: (value - min) / (max - min) * 100
+    const int32_t volume = int32_t(float(next) / 10.0f * 100.0f);
+    std::thread([this, volume]() {
+      OptWriteSetting(kVoiceVolume, volume);
+    }).detach();
+    return;
+  }
+  // XUI's navigation passes over controls that cannot take focus
+  std::string target = direction == kUp ? cur->up : cur->down;
+  while (target != "-" && !target.empty()) {
+    const OptCtrl* t = find(target);
+    if (!t) return;
+    if (page_ != Page::kOpt || OptEnabled(target)) break;
+    target = direction == kUp ? t->up : t->down;
+  }
+  if (target == "-" || target.empty()) return;
+  opt_focus_ = target;
+  ++page_version_;
+  PlaySfx("btn_Focus");
+}
+
+void GuideOverlay::OptActivate() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  if (opt_fading_) return;
+  const Page page = page_;
+  const std::string focus = opt_focus_;
+  if (page == Page::kOpt) {
+    static const std::pair<const char*, Page> kPress[] = {
+        {"btnOnlineStatus", Page::kOptOnl},
+        {"btnVoice", Page::kOptVoice},
+        {"btnController", Page::kOptVib},
+        {"btnNotifications", Page::kOptNot}};
+    for (const auto& [id, next] : kPress) {
+      if (focus == id) {
+        OptGoTo(next);
+        lock.unlock();
+        PlaySfx("btn_Select");  // the button's Press state
+        return;
+      }
+    }
+    if (focus == "btnTurnOff") {
+      // 9144AA8C: Strings 44 "Are you sure you want to turn off the
+      // console?"; Yes (9144AA30) -> HalReturnToFirmware(5)
+      box_return_ = Page::kOpt;
+      lock.unlock();
+      PlaySfx("btn_Select");
+      ShowMessageBox(Page::kTurnOff);
+      return;
+    }
+    // Themes (SkinSelect.xur) and Active Downloads (XamShowMarketplaceUI):
+    // not built
+    lock.unlock();
+    PlaySfx("btn_Select");
+    XELOGW("Guide: Personal Settings {} is not available", focus);
+    return;
+  }
+  if (page == Page::kOptVib && focus == "chkVibration") {
+    // 9144B6C0: the setting follows the box (3 on, 0 off)
+    opt_vib_ = !opt_vib_;
+    const int32_t value = opt_vib_ ? 3 : 0;
+    ++page_version_;
+    lock.unlock();
+    PlaySfx("btn_Focus");  // its FocusCheck / Focus state's sound
+    OptWriteSetting(kVibration, value);
+    return;
+  }
+  if (page == Page::kOptNot) {
+    // 9144A4D0: XNotifyUISetOptions(show, sound)
+    if (focus == "chkShow") {
+      OVERRIDE_bool(notify_show, !cvars::notify_show);
+    } else if (focus == "chkSound") {
+      OVERRIDE_bool(notify_sound, !cvars::notify_sound);
+    } else {
+      return;
+    }
+    ++page_version_;
+    lock.unlock();
+    PlaySfx("btn_Focus");
+    config::SaveConfig();
+    return;
+  }
+  if (page == Page::kOptOnl) {
+    static const char* const kOnline[] = {"radbtnOnline", "radbtnAway",
+                                          "radbtnBusy", "radbtnAppearOffline"};
+    for (int i = 0; i < 4; ++i) {
+      if (focus != kOnline[i]) continue;
+      // 9144A748: XamSetUserPresetPresenceState, then back to Options
+      opt_presence_ = i;
+      opt_presence_by_user_[opt_user_] = i;
+      XELOGI("Guide: preset presence state {:X}", kPresence[i]);
+      ++page_version_;
+      OptNavigateBack();
+      lock.unlock();
+      PlaySfx("btn_Focus");
+      return;
+    }
+    return;
+  }
+  if (page == Page::kOptVoice) {
+    static const char* const kOutput[] = {"radbtnPlayHeadset", "radbtnPlayTV",
+                                          "radbtnPlayBoth"};
+    if (focus == "chkMute") {
+      opt_mute_ = !opt_mute_;
+      const int32_t value = opt_mute_ ? 1 : 0;
+      ++page_version_;
+      lock.unlock();
+      PlaySfx("btn_Focus");
+      OptWriteSetting(kVoiceMuted, value);
+      return;
+    }
+    for (int i = 0; i < 3; ++i) {
+      if (focus != kOutput[i] || i == opt_output_) continue;
+      opt_output_ = i;
+      ++page_version_;
+      lock.unlock();
+      PlaySfx("btn_Focus");
+      OptWriteSetting(kVoiceOutput, i);
+      return;
+    }
+  }
+}
+
+void GuideOverlay::OptBack() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (opt_fading_) return;
+    OptNavigateBack();
+  }
+  PlaySfx("btn_Back");  // the scene's XuiBackButton (legend_B) Press
+}
