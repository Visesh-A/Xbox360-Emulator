+const char* GuideOverlay::OptKey(Page page) {
+  switch (page) {
+    case Page::kOpt:
+      return "opt";
+    case Page::kOptVib:
+      return "optvib";
+    case Page::kOptNot:
+      return "optnot";
+    case Page::kOptOnl:
+      return "optonl";
+    case Page::kOptVoice:
+      return "optvoice";
+    default:
+      return nullptr;
+  }
