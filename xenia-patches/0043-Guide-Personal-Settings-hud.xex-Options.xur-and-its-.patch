+// Each layer is a crop of a full-canvas image (make_options_assets.py). It is
+// shrunk on the full image's own sampling grid (Resample's box filter over
+// the whole canvas), so it lands on the same pixels as the base image.
+void GuideOverlay::PrepareOptionsLayers(float ppu, float f) {
+  const int full_w = int(std::lround(layout_.canvas_w * layout_.scale));
+  const int full_h = int(std::lround(layout_.canvas_h * layout_.scale));
+  const int out_w = f < 1.0f ? std::max(1, int(std::lround(full_w * f))) : full_w;
+  const int out_h = f < 1.0f ? std::max(1, int(std::lround(full_h * f))) : full_h;
+  const double rx = double(full_w) / out_w, ry = double(full_h) / out_h;
+  std::map<std::string, OptLayer> layers;
+  for (const auto& [key, page] : opt_pages_) {
+    for (const auto& [name, origin] : page.layers) {
+      Pixels crop;
+      if (!Decode(key + "_" + name, crop)) continue;
+      OptLayer layer;
+      if (f >= 1.0f) {
+        layer.pixels = std::move(crop);
+        layer.x = origin[0];
+        layer.y = origin[1];
+        layers[key + "_" + name] = std::move(layer);
+        continue;
+      }
+      const int x0 = origin[0], y0 = origin[1];
+      const int ox0 = int(std::floor(x0 / rx));
+      const int oy0 = int(std::floor(y0 / ry));
+      const int ox1 = std::min(out_w, int(std::ceil((x0 + crop.width) / rx)));
+      const int oy1 = std::min(out_h, int(std::ceil((y0 + crop.height) / ry)));
+      Pixels& px = layer.pixels;
+      px.width = std::max(0, ox1 - ox0);
+      px.height = std::max(0, oy1 - oy0);
+      px.rgba.assign(size_t(px.width) * px.height * 4, 0);
+      for (int oy = oy0; oy < oy1; ++oy) {
+        const double sy0 = oy * ry, sy1 = std::min(double(full_h), sy0 + ry);
+        for (int ox = ox0; ox < ox1; ++ox) {
+          const double sx0 = ox * rx, sx1 = std::min(double(full_w), sx0 + rx);
+          double sum[4] = {};
+          for (int sy = int(sy0); sy < sy1; ++sy) {
+            const int cy = sy - y0;
+            if (cy < 0 || cy >= crop.height) continue;
+            const double wy = std::min(sy1, sy + 1.0) - std::max(sy0, double(sy));
+            for (int sx = int(sx0); sx < sx1; ++sx) {
+              const int cx = sx - x0;
+              if (cx < 0 || cx >= crop.width) continue;
+              const double w =
+                  wy * (std::min(sx1, sx + 1.0) - std::max(sx0, double(sx)));
+              const uint8_t* c = &crop.rgba[(size_t(cy) * crop.width + cx) * 4];
+              const double a = c[3] / 255.0 * w;
+              sum[0] += c[0] / 255.0 * a;
+              sum[1] += c[1] / 255.0 * a;
+              sum[2] += c[2] / 255.0 * a;
+              sum[3] += a;
+            }
+          }
+          const double area = (sx1 - sx0) * (sy1 - sy0);
+          uint8_t* o = &px.rgba[(size_t(oy - oy0) * px.width + (ox - ox0)) * 4];
+          const double a = sum[3] / area;
+          for (int i = 0; i < 3; ++i) {
+            const double v = sum[3] > 0 ? sum[i] / sum[3] : 0.0;
+            o[i] = uint8_t(std::clamp(v * 255.0 + 0.5, 0.0, 255.0));
+          }
+          o[3] = uint8_t(std::clamp(a * 255.0 + 0.5, 0.0, 255.0));
+        }
+      }
+      layer.x = ox0;
+      layer.y = oy0;
+      layers[key + "_" + name] = std::move(layer);
+    }
+  }
+  std::lock_guard<std::mutex> lock(prepare_mutex_);
+  opt_layers_ = std::move(layers);
+}
+
+// OptionsScene's init (9144AC80): message 0x7D3 (the control's Enabled flag,
+// xam 81926524) with 0 for Voice, Vibration, Themes and Active Downloads when
+// nobody is signed in (HUD state 6); Online Status disabled for a profile
+// without an Xbox Live account (state 9).
+bool GuideOverlay::OptEnabled(const std::string& id) const {
+  if (opt_hud_state_ == 6) {
+    return id != "btnVoice" && id != "btnController" &&
+           id != "btnPersonalization" && id != "btnDownloads";
+  }
+  if (opt_hud_state_ == 9) {
+    return id != "btnOnlineStatus";
+  }
+  return true;
+}
+
+// XUI's initial focus: the scene's DefaultFocus, or when that cannot take
+// focus its first enabled child in the scene's order.
+std::string GuideOverlay::OptFirstFocus(Page page) const {
+  const OptPage& p = opt_pages_.at(OptKey(page));
+  if (page != Page::kOpt || OptEnabled(p.default_focus)) return p.default_focus;
+  for (const auto& id : p.order) {
+    if (OptEnabled(id)) return id;
+  }
+  return p.default_focus;
+}
+
+bool GuideOverlay::ComposeOptionsPage(Page page, float ppu, Pixels& out) {
+  const char* key = OptKey(page);
+  std::unique_lock<std::mutex> lock(mutex_);
+  const std::string focus = opt_focus_;
+  const bool vib = opt_vib_, mute = opt_mute_;
+  const int presence = opt_presence_, output = opt_output_,
+            volume = opt_volume_;
+  std::map<std::string, bool> enabled;
+  for (const auto& c : opt_pages_[key].ctrls) enabled[c.id] = OptEnabled(c.id);
+  lock.unlock();
+  const bool show = cvars::notify_show, sound = cvars::notify_sound;
+  auto checked = [&](const std::string& id) {
+    if (id == "chkVibration") return vib;
+    if (id == "chkShow") return show;
+    if (id == "chkSound") return sound;
+    if (id == "chkMute") return mute;
+    static const char* const kOnline[] = {"radbtnOnline", "radbtnAway",
+                                          "radbtnBusy", "radbtnAppearOffline"};
+    static const char* const kOutput[] = {"radbtnPlayHeadset", "radbtnPlayTV",
+                                          "radbtnPlayBoth"};
+    for (int i = 0; i < 4; ++i) {
+      if (id == kOnline[i]) return i == presence;
+    }
+    for (int i = 0; i < 3; ++i) {
+      if (id == kOutput[i]) return i == output;
+    }
+    return false;
+  };
+  std::lock_guard<std::mutex> images_lock(prepare_mutex_);
+  if (!scaled_ready_ || scaled_ppu_ != ppu) return false;
+  auto base = scaled_.find(std::string(key) + "_base");
+  if (base == scaled_.end()) return false;
+  out = base->second;
+  for (const auto& c : opt_pages_[key].ctrls) {
+    const bool f = c.id == focus;
+    std::string state;
+    if (c.kind == "button") {
+      state = f ? "f" : enabled[c.id] ? "n" : "nd";
+    } else if (c.kind == "slider") {
+      state = std::string(f ? "f" : "n") + std::to_string(volume);
+    } else {
+      state = std::string(f ? "f" : "n") + (checked(c.id) ? "c" : "");
+    }
+    auto it = opt_layers_.find(std::string(key) + "_" + c.id + "_" + state);
+    if (it == opt_layers_.end()) continue;
+    const OptLayer& layer = it->second;
+    for (int y = 0; y < layer.pixels.height; ++y) {
+      const int oy = layer.y + y;
+      if (oy < 0 || oy >= out.height) continue;
+      for (int x = 0; x < layer.pixels.width; ++x) {
+        const int ox = layer.x + x;
+        if (ox < 0 || ox >= out.width) continue;
+        Blend(&out.rgba[(size_t(oy) * out.width + ox) * 4],
+              &layer.pixels.rgba[(size_t(y) * layer.pixels.width + x) * 4]);
+      }
+    }
+  }
+  return true;
+}
