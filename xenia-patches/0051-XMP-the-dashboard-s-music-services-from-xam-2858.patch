+      // xam 819A62B0: client 0 or 1, a workspace (or unk1), its pointer and
+      // size both given or both 0; the media manager keeps it (81A3FA60)
+      if (args->xmp_client > 1 || (!args->storage_ptr && !args->unk1) ||
+          (!args->storage_ptr) != (!args->unk2)) {
