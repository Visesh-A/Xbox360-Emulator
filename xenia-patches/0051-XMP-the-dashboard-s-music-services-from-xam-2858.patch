+      xe::store_and_swap<uint32_t>(
+          memory_->TranslateVirtual(a[2]),
+          kernel_state_->emulator()->audio_media_player()->GetPlaylistSongCount(
+              handle));
+      return X_E_SUCCESS;
     }
