+// xam's 10 media source slots (made in 81A43480): the hard drive's media
+// index (connected: XboxHardwareInfo has a hard disk, 81A47198), then each
+// class with no device - PC (4), three MTP players (3), audio CD (6), data
+// CD (7), three more (2). Names are empty.
+const XmpApp::MediaSource XmpApp::kMediaSources[10] = {
+    {"Media Index", 0, 0x802, 4},  {"", 4, 0x82B, 0},
+    {"some mtp device", 3, 0, 0},  {"some mtp device", 3, 0, 0},
+    {"some mtp device", 3, 0, 0},  {"CDDA", 6, 0x802, 0},
+    {"some data cd", 7, 0x113, 0}, {"", 2, 0x113, 0},
+    {"", 2, 0x113, 0},             {"", 2, 0x113, 0}};
+
+// A slot's 0xB4-byte record (xam 81A3FE68): +0 slot, +4 id (0x24 bytes),
+// +0x28 type, +0x2C flags, +0x30 state (4 = connected), +0x34 name
+void XmpApp::WriteMediaSource(uint8_t* record, uint32_t slot) {
+  const MediaSource& source = kMediaSources[slot];
+  std::memset(record, 0, 0xB4);
+  xe::store_and_swap<uint32_t>(record + 0x00, slot);
+  std::memcpy(record + 0x04, source.id, std::strlen(source.id));
+  xe::store_and_swap<uint32_t>(record + 0x28, source.type);
+  xe::store_and_swap<uint32_t>(record + 0x2C, source.flags);
+  xe::store_and_swap<uint32_t>(record + 0x30, source.state);
+}
