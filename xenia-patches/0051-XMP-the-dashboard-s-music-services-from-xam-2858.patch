+    case 0x00070014:
+    case 0x0007001C: {
+      // A media query into the dashboard's enumerator (its XamCreate-
+      // EnumeratorHandle with open/close messages 0x70015 / 0x70016 for
+      // songs, 0x7001D / 0x7001E for the other lists): xam 819A5628 /
+      // 819A5C28 check the arguments, then 81A400C8 finds the source the
+      // record (+4, else +8) names - connected, with the same id
+      // (81A3FD90; else 0x800704B1) - and queries its media index. The hard
+      // drive's index is empty, so the enumerator gets no items.
+      const auto* a = reinterpret_cast<const xe::be<uint32_t>*>(buffer);
+      const uint32_t out = message == 0x00070014 ? 6 : 7;
+      if (!buffer || (a[1] && a[2]) || (!a[1] && !a[2]) || !a[out]) {
+        return X_E_INVALIDARG;
+      }
+      const uint32_t record_ptr = a[1] ? uint32_t(a[1]) : uint32_t(a[2]);
+      const uint8_t* record = memory_->TranslateVirtual(record_ptr);
+      const bool hard_drive =
+          record_ptr && xe::load_and_swap<uint32_t>(record) == 0 &&
+          std::memcmp(record + 4, "Media Index", 12) == 0;
+      XELOGD("XMP media query ({:08X} {:08X} {:08X} {:08X} {:08X} {:08X} "
+             "{:08X}){}",
+             uint32_t(a[1]), uint32_t(a[2]), uint32_t(a[3]), uint32_t(a[4]),
+             uint32_t(a[5]), uint32_t(a[6]), uint32_t(a[7]),
+             hard_drive ? "" : ": source not connected");
+      return hard_drive ? X_E_SUCCESS : X_HRESULT_FROM_WIN32(0x4B1);
+    }
+    case 0x00070046: {
+      // xam 81A41060: one source's record (81A3FE68) by type at +4: 0 the
+      // hard drive, 4 the PC, 6 the audio CD, 7 the data CD
+      const auto* a = reinterpret_cast<const xe::be<uint32_t>*>(buffer);
+      if (!buffer || !a[2]) {
+        return X_E_INVALIDARG;
+      }
+      uint32_t slot;
+      switch (uint32_t(a[1])) {
+        case 0: slot = 0; break;
+        case 4: slot = 1; break;
+        case 6: slot = 5; break;
+        case 7: slot = 6; break;
+        default: return X_E_INVALIDARG;
+      }
+      WriteMediaSource(memory_->TranslateVirtual(a[2]), slot);
+      return X_E_SUCCESS;
+    }
+    case 0x00070028: {
+      // xam 819A5820: the title playlist at *(+4) is emptied (playback
+      // stops if it is playing it), then XN 0x8A000005 (0)
+      const auto* a = reinterpret_cast<const xe::be<uint32_t>*>(buffer);
+      if (!buffer || !a[1]) {
+        return X_E_INVALIDARG;
+      }
+      const uint32_t handle =
+          xe::load_and_swap<uint32_t>(memory_->TranslateVirtual(a[1]));
+      kernel_state_->emulator()->audio_media_player()->ClearPlaylistSongs(
+          handle);
+      kernel_state_->BroadcastNotification(
+          kXNotificationXmpTitlePlayListContentChanged, 0);
+      return X_E_SUCCESS;
+    }
+    case 0x00070033: {
+      // xam 819A9EAC -> 819AA528: client 0 gets xam's playback data block
+      // (0x81B200A0; 819ACCC8 sets +0x60 = 48000, the sample rate; the
+      // rest comes from playback - zero while nothing plays)
+      const auto* a = reinterpret_cast<const xe::be<uint32_t>*>(buffer);
+      if (!buffer || a[0] != 0 || !a[1]) {
+        return X_E_INVALIDARG;
+      }
+      if (!visualization_ptr_) {
+        visualization_ptr_ = memory_->SystemHeapAlloc(0x1000);
+        uint8_t* block = memory_->TranslateVirtual(visualization_ptr_);
+        std::memset(block, 0, 0x1000);
+        xe::store_and_swap<uint32_t>(block + 0x60, 48000);
+      }
+      xe::store_and_swap<uint32_t>(memory_->TranslateVirtual(a[1]),
+                                   visualization_ptr_);
+      return X_E_SUCCESS;
+    }
+    case 0x00070041: {
+      // xam 819A5548: a title playlist's song enumeration state into +8
+      // (the dashboard's enumerator): the playlist, then for one that has
+      // never started (state 0) zeros - the enumerator stays empty
+      const auto* a = reinterpret_cast<const xe::be<uint32_t>*>(buffer);
+      if (!buffer || a[0] > 1 || !a[1] || !a[2]) {
+        return X_E_INVALIDARG;
+      }
+      uint8_t* out = memory_->TranslateVirtual(a[2]);
+      std::memset(out, 0, 0x14);
+      xe::store_and_swap<uint32_t>(out, a[1]);
+      return X_E_SUCCESS;
+    }
+    case 0x0007004A: {
+      // XMPSetDashNowPlayingQueueMode (xam 819A5AB8): after XMPDashInIt; a
+      // changed mode is broadcast (XN 0x8A000007, 0)
+      const auto* a = reinterpret_cast<const xe::be<uint32_t>*>(buffer);
+      if (!buffer) {
+        return X_E_INVALIDARG;
+      }
+      auto* player = kernel_state_->emulator()->audio_media_player();
+      if (!player->dash_initialized) {
+        return X_HRESULT_FROM_WIN32(0x139F);
+      }
+      const uint32_t mode = a[1];
+      XELOGD("XMPSetDashNowPlayingQueueMode({})", mode);
+      if (player->dash_queue_mode != mode) {
+        player->dash_queue_mode = mode;
+        kernel_state_->BroadcastNotification(
+            kXNotificationXmpDashNowPlayingQueueModeChanged, 0);
+      }
+      return X_E_SUCCESS;
+    }
+    case 0x00070031: {
+      // xam 819A5E08: the title playlist's song count (819ACF20) for the
+      // handle at +4, written to +8
+      const auto* a = reinterpret_cast<const xe::be<uint32_t>*>(buffer);
+      if (!buffer || !a[1] || !a[2]) {
+        return X_E_INVALIDARG;
+      }
+      const uint32_t handle =
