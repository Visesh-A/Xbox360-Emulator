+// --------------------------------------------------------------- View Games
+
+void GuideOverlay::LoadViewGamesLayout() {
+  std::ifstream in(asset_dir_ / "viewgames.txt", std::ios::binary);
+  std::string line;
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::istringstream ls(line);
+    std::string kind, name;
+    ls >> kind;
+    if (kind == "text") {
+      std::string color;
+      MessageBoxItem item;
+      item.is_text = true;
+      ls >> name >> item.x >> item.y >> item.w >> item.h >> item.size >>
+          item.ascent >> item.line_h >> item.style >> color;
+      item.color = uint32_t(std::stoul(color, nullptr, 16));
+      vg_text_[name] = item;
+    } else if (kind == "image") {
+      std::array<float, 4> r;
+      ls >> name >> r[0] >> r[1] >> r[2] >> r[3];
+      vg_image_[name] = r;
+    } else if (kind == "list") {
+      int v;
+      ls >> v;
+      if (v >= 0 && v < 2) {
+        for (float& f : vg_list_[v]) ls >> f;
+      }
+    } else if (kind == "scroll") {
+      int v;
+      ls >> v >> name;
+      if (v >= 0 && v < 2) {
+        float* r = vg_scroll_[v][name == "down"];
+        ls >> r[0] >> r[1] >> r[2] >> r[3];
+      }
+    } else if (kind == "str") {
+      std::string id, text;
+      ls >> id;
+      std::getline(ls >> std::ws, text);
+      vg_str_[int(std::stoul(id, nullptr, 16))] = Unescape(text);
+    }
+  }
+  vg_ready_ = vg_list_[0][5] > 0 && vg_list_[1][5] > 0 && prefs_ready_ &&
+              vg_text_.count("det_desc");
+}
+
+// XamUserCreateTitlesPlayedEnumerator, as this Xenia's xam gives it: most
+// recently played first, without the dashboard and titles without
+// achievements.
+void GuideOverlay::LoadViewGames() {
+  vg_titles_.clear();
+  vg_game_ = vg_game_top_ = 0;
+  vg_scroll_dir_ = -1;
+  auto* tracker = emulator_->kernel_state()->xam_state()->user_tracker();
+  for (const auto& title : tracker->GetPlayedTitles(gp_xuid_)) {
+    if (title.id == kernel::kDashboardID || !title.achievements_count ||
+        !title.gamerscore_amount) {
+      continue;
+    }
+    VgTitle t;
+    t.id = title.id;
+    t.name = title.title_name;
+    t.earned = title.unlocked_achievements_count;
+    t.total = title.achievements_count;
+    t.gamerscore = title.title_earned_gamerscore;
+    t.icon.assign(title.icon.begin(), title.icon.end());
+    vg_titles_.push_back(std::move(t));
+  }
+}
+
+// XamUserCreateAchievementEnumerator for the title, sorted by date (821's
+// init, 9010F3C0: +0x540 = 0).
+void GuideOverlay::LoadAchievements() {
+  vg_achs_.clear();
+  vg_ach_ = vg_ach_top_ = 0;
+  vg_sort_ = 0;
+  vg_scroll_dir_ = -1;
+  if (vg_game_ < 0 || vg_game_ >= int(vg_titles_.size())) return;
+  auto* tracker = emulator_->kernel_state()->xam_state()->user_tracker();
+  int order = 0;
+  for (const auto& a :
+       tracker->GetUserTitleAchievements(gp_xuid_, vg_titles_[vg_game_].id)) {
+    VgAchievement v;
+    v.id = a.achievement_id;
+    v.gamerscore = a.gamerscore;
+    v.flags = a.flags;
+    v.unlocked_at =
+        (uint64_t(uint32_t(a.unlock_time.high_part)) << 32) |
+        uint32_t(a.unlock_time.low_part);
+    v.name = a.achievement_name;
+    v.description = a.unlocked_description;
+    v.locked_description = a.locked_description;
+    v.order = order++;
+    vg_achs_.push_back(std::move(v));
+  }
+  SortAchievements();
+}
+
+// 821's comparators: by date (9010EDA8): unlocked first, in the enumerator's
+// order, then locked ones by id; by gamerscore (9010EE10): among unlocked
+// ones, and among locked ones shown (flag 8), the higher score first, the
+// rest as by date.
+void GuideOverlay::SortAchievements() {
+  auto unlocked = [](const VgAchievement& a) { return (a.flags & 0x20000) != 0; };
+  auto by_date = [&](const VgAchievement& a, const VgAchievement& b) {
+    if (unlocked(a) != unlocked(b)) return unlocked(a);
+    if (unlocked(a)) return a.order < b.order;
+    return a.id < b.id;
+  };
+  auto by_score = [&](const VgAchievement& a, const VgAchievement& b) {
+    if (a.gamerscore != b.gamerscore) {
+      if (unlocked(a) && unlocked(b)) return a.gamerscore > b.gamerscore;
+      if (!unlocked(a) && !unlocked(b) && (a.flags & 8) && (b.flags & 8)) {
+        return a.gamerscore > b.gamerscore;
+      }
+    }
+    return by_date(a, b);
+  };
+  if (vg_sort_) {
+    std::stable_sort(vg_achs_.begin(), vg_achs_.end(), by_score);
+  } else {
+    std::stable_sort(vg_achs_.begin(), vg_achs_.end(), by_date);
+  }
+}
+
+// Y: 820's hidden yButton (PressPath GamerscoreMoreInfo.xur); 821's
+// (9010F168) changes the sort order, the focus staying on its achievement.
+void GuideOverlay::GpY() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (page_ == Page::kGpGames) {
+    PlaySfx("btn_Select");
+    GpGoTo(Page::kGpGsInfo);
+  } else if (page_ == Page::kGpAchs) {
+    PlaySfx("btn_Select");
+    const uint32_t focused =
+        vg_ach_ < int(vg_achs_.size()) ? vg_achs_[vg_ach_].id : 0;
+    vg_sort_ = vg_sort_ ? 0 : 1;
+    SortAchievements();
+    const int visible = std::max(1, int(vg_list_[1][5]));
+    for (int i = 0; i < int(vg_achs_.size()); ++i) {
+      if (vg_achs_[i].id == focused) vg_ach_ = i;
+    }
+    if (vg_ach_ < vg_ach_top_) vg_ach_top_ = vg_ach_;
+    if (vg_ach_ >= vg_ach_top_ + visible) vg_ach_top_ = vg_ach_ - visible + 1;
+    ++page_version_;
+  }
+}
+
+const GuideOverlay::Pixels* GuideOverlay::VgPicture(
+    const std::string& key, const std::vector<uint8_t>& png) {
+  auto it = vg_pictures_.find(key);
+  if (it == vg_pictures_.end()) {
+    Pixels pixels;
+    int channels;
+    if (!png.empty()) {
+      if (uint8_t* rgba =
+              stbi_load_from_memory(png.data(), int(png.size()), &pixels.width,
+                                    &pixels.height, &channels, STBI_rgb_alpha)) {
+        pixels.rgba.assign(rgba,
+                           rgba + size_t(pixels.width) * pixels.height * 4);
+        stbi_image_free(rgba);
+      }
+    } else if (key == "unearned") {
+      Decode("gp_unearned", pixels);
+    }
+    it = vg_pictures_.emplace(key, std::move(pixels)).first;
+  }
+  return it->second.rgba.empty() ? nullptr : &it->second;
+}
