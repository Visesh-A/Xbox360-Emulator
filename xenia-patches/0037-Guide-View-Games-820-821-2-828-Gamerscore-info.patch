+namespace {
+// "%1!u! of %2!u! ..." (XamFormatMessage) with two numbers.
+std::u16string FormatCount(std::u16string text, uint32_t a, uint32_t b) {
+  auto put = [&](const char16_t* key, uint32_t v) {
+    size_t at = text.find(key);
+    if (at != std::u16string::npos) {
+      text.replace(at, 5, xe::to_utf16(std::to_string(v)));
+    }
+  };
+  put(u"%1!u!", a);
+  put(u"%2!u!", b);
+  return text;
+}
