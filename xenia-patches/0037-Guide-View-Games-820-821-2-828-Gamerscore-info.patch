+// The lists' scroll ends (ScrollMore where they can scroll; the Scrolling
+// glow when they do).
+void GuideOverlay::DrawViewGames(float k, float ox, float oy, float up,
+                                 float alpha) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  const Page page = page_;
+  const bool games = page == Page::kGpGames;
+  const int count = games ? int(vg_titles_.size()) : int(vg_achs_.size());
+  const int top = games ? vg_game_top_ : vg_ach_top_;
+  const auto scroll_at = vg_scroll_at_;
+  const int dir = vg_scroll_dir_;
+  lock.unlock();
+  const int v = games ? 0 : 1;
+  const int visible = std::max(1, int(vg_list_[v][5]));
+  auto V = [up](float x, float y) { return ImVec2(x * up, y * up); };
+  ImDrawList* draw_list = ImGui::GetForegroundDrawList();
+  const float g =
+      std::chrono::duration<float>(Clock::now() - scroll_at).count() *
+      layout_.fps;
+  const float glow = g < 10.0f   ? g / 10.0f
+                     : g < 21.0f ? 1.0f - (g - 10.0f) / 11.0f
+                                 : 0.0f;
+  const bool more[2] = {top > 0, top + visible < count};
+  for (int side = 0; side < 2; ++side) {
+    const float* r = vg_scroll_[v][side];
+    const std::string name = side ? "gp_scroll_down" : "gp_scroll_up";
+    for (int layer = 0; layer < 2; ++layer) {
+      const float a = layer ? (dir == side ? glow : 0.0f) : (more[side] ? 1.0f : 0.0f);
+      if (a <= 0.0f) continue;
+      if (const Image* img = Texture(layer ? name + "_shade" : name, k)) {
+        const float x0 = ox + r[0] * k, y0 = oy + r[1] * k;
+        draw_list->AddImage(
+            reinterpret_cast<ImTextureID>(img->texture.get()), V(x0, y0),
+            V(x0 + r[2] * k, y0 + r[3] * k), ImVec2(0, 0), ImVec2(1, 1),
+            IM_COL32(255, 255, 255, int(a * alpha * 255.0f + 0.5f)));
+      }
+    }
+  }
+}
