+bool GuideOverlay::ComposeViewGamesPage(Page page, float ppu, Pixels& out) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  const std::vector<VgTitle> titles = vg_titles_;
+  const std::vector<VgAchievement> achs = vg_achs_;
+  const int game = vg_game_, game_top = vg_game_top_, ach = vg_ach_,
+            ach_top = vg_ach_top_, sort = vg_sort_;
+  const uint64_t xuid = gp_xuid_;
+  lock.unlock();
+  const VgTitle* title =
+      game >= 0 && game < int(titles.size()) ? &titles[game] : nullptr;
+  auto unlocked = [](const VgAchievement& a) { return (a.flags & 0x20000) != 0; };
+  auto shown = [&](const VgAchievement& a) { return unlocked(a) || (a.flags & 8); };
+  // the pictures: the title's icon, an achievement's (XamReadImage) or, locked,
+  // sharedres://unearnedAchievement.png
+  auto* tracker = emulator_->kernel_state()->xam_state()->user_tracker();
+  auto ach_picture = [&](const VgAchievement& a) -> const Pixels* {
+    if (!unlocked(a) || !title) return VgPicture("unearned", {});
+    auto icon = tracker->GetAchievementIcon(xuid, title->id, a.id);
+    return VgPicture(fmt::format("a{:08X}_{}", title->id, a.id),
+                     std::vector<uint8_t>(icon.begin(), icon.end()));
+  };
+  std::string base;
+  switch (page) {
+    case Page::kGpGames:
+      base = titles.empty() ? "gpgames_none" : "gpgames";
+      break;
+    case Page::kGpAchs:
+      base = achs.empty() ? "gpachs_none" : "gpachs";
+      break;
+    case Page::kGpAchDetail:
+      base = "gpachd";
+      break;
+    default:
+      base = "gpgsinfo";
+      break;
+  }
+  std::lock_guard<std::mutex> images_lock(prepare_mutex_);
+  if (!scaled_ready_ || scaled_ppu_ != ppu) return false;
+  auto it = scaled_.find(base);
+  if (it == scaled_.end()) return false;
+  out = it->second;
+  auto text = [&](const std::string& name, const std::u16string& value,
+                  float dx = 0, float dy = 0) {
+    auto t = vg_text_.find(name);
+    if (t == vg_text_.end()) return;
+    MessageBoxItem item = t->second;
+    item.x += dx;
+    item.y += dy;
+    RenderText(out, item, value, ppu);
+  };
+  auto picture = [&](const std::string& name, const Pixels* p, float dx = 0,
+                     float dy = 0) {
+    auto r = vg_image_.find(name);
+    if (p && r != vg_image_.end()) {
+      DrawPictureInto(out, *p, r->second[0] + dx, r->second[1] + dy,
+                      r->second[2], r->second[3], ppu);
+    }
+  };
+  // a list row: the item's visual, then its columns
+  auto row = [&](int v, int i, int top, bool focused,
+                 const std::u16string& l1, const std::u16string& l2,
+                 const std::u16string& l3, const Pixels* pic) {
+    const float x = vg_list_[v][0], y = vg_list_[v][1] + (i - top) * vg_list_[v][4];
+    const std::string state = focused ? "focus" : "normal";
+    auto img = scaled_.find(fmt::format("gp_grow_{}_{}", v, state));
+    if (img != scaled_.end()) {
+      const Pixels& p = img->second;
+      const int ox0 = int(std::lround(x * ppu)), oy0 = int(std::lround(y * ppu));
+      for (int yy = 0; yy < p.height; ++yy) {
+        int oy = oy0 + yy;
+        if (oy < 0 || oy >= out.height) continue;
+        for (int xx = 0; xx < p.width; ++xx) {
+          int ox = ox0 + xx;
+          if (ox < 0 || ox >= out.width) continue;
+          const uint8_t* c = &p.rgba[(size_t(yy) * p.width + xx) * 4];
+          BlendPixel(&out.rgba[(size_t(oy) * out.width + ox) * 4],
+                     c[0] / 255.0f, c[1] / 255.0f, c[2] / 255.0f,
+                     c[3] / 255.0f);
+        }
+      }
+    }
+    const std::string key = fmt::format("row{}_{}_", v, state);
+    text(key + "l1", l1, x, y);
+    text(key + "l2", l2, x, y);
+    text(key + "l3", l3, x, y);
+    picture(key + "img", pic, x, y);
+  };
+  if (page == Page::kGpGames) {
+    const int visible = std::max(1, int(vg_list_[0][5]));
+    for (int i = game_top; i < int(titles.size()) && i < game_top + visible; ++i) {
+      const VgTitle& t = titles[i];
+      row(0, i, game_top, i == game, t.name,
+          FormatCount(vg_str_[0x27], t.earned, t.total),
+          xe::to_utf16(std::to_string(t.gamerscore)),
+          VgPicture(fmt::format("t{:08X}", t.id), t.icon));
+    }
+  } else if (page == Page::kGpAchs) {
+    uint32_t earned = 0;
+    for (const auto& a : achs) earned += unlocked(a) ? 1 : 0;
+    text("ach_header", title ? title->name : u"");
+    text("ach_sort", vg_str_[sort ? 0x44 : 0x45]);
+    text("ach_count", FormatCount(vg_str_[7], earned, uint32_t(achs.size())));
+    const int visible = std::max(1, int(vg_list_[1][5]));
+    for (int i = ach_top; i < int(achs.size()) && i < ach_top + visible; ++i) {
+      const VgAchievement& a = achs[i];
+      std::u16string line2 = vg_str_[6];  // "Locked"
+      if (unlocked(a)) {
+        if (a.unlocked_at) {
+          // XamFormatDateString of the local date
+          const int64_t secs = int64_t(a.unlocked_at / 10000000ull) - 11644473600ll;
+          std::time_t when = std::time_t(secs);
+          std::tm local = {};
+          localtime_s(&local, &when);
+          std::u16string date = xe::to_utf16(fmt::format(
+              "{}/{}/{}", local.tm_mon + 1, local.tm_mday, local.tm_year + 1900));
+          line2 = vg_str_[3];
+          size_t at = line2.find(u"%s");
+          if (at != std::u16string::npos) line2.replace(at, 2, date);
+        } else {
+          line2 = vg_str_[2];
+        }
+      }
+      row(1, i, ach_top, i == ach, shown(a) ? a.name : vg_str_[4], line2,
+          unlocked(a) ? xe::to_utf16(std::to_string(a.gamerscore)) : vg_str_[0x2C],
+          ach_picture(a));
+    }
+  } else if (page == Page::kGpAchDetail && ach >= 0 && ach < int(achs.size())) {
+    // 90104B28
+    const VgAchievement& a = achs[ach];
+    text("det_header", title ? title->name : u"");
+    if (shown(a)) {
+      text("det_title", a.name);
+      text("det_cred", xe::to_utf16(std::to_string(a.gamerscore)));
+      text("det_desc", unlocked(a) ? a.description : a.locked_description);
+    } else {
+      text("det_title", vg_str_[4]);
+      text("det_cred", vg_str_[0x2C]);
+      text("det_desc", vg_str_[5]);
+    }
+    picture("det_image", ach_picture(a));
+  }
+  return true;
+}
