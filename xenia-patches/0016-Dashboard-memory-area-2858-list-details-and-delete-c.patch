+  xe::be<uint64_t> xuid;       // 0x138
+  xe::be<uint32_t> title_id;   // 0x140
+  uint8_t padding1[4];         // 0x144
+};
+static_assert_size(XCONTENT_AGGREGATE_DATA_SYSTEM, 0x148);
