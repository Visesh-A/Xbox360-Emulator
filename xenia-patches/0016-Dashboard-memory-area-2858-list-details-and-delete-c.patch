+// The dashboard's memory area (2858). A package is a folder here, not the
+// console's single package file: its size is the size of the files in it.
+static std::filesystem::path SystemPackagePath(
+    const XCONTENT_AGGREGATE_DATA_SYSTEM& data) {
+  return kernel_state()->emulator()->content_root() /
+         fmt::format("{:016X}", uint64_t(data.xuid)) /
+         fmt::format("{:08X}", uint32_t(data.title_id)) /
+         fmt::format("{:08X}", static_cast<uint32_t>(static_cast<XContentType>(data.content_data.content_type))) /
+         data.content_data.file_name();
+}
+
+static uint64_t PackageSize(const std::filesystem::path& path) {
+  uint64_t size = 0;
+  std::error_code ec;
+  for (auto& entry :
+       std::filesystem::recursive_directory_iterator(path, ec)) {
+    if (entry.is_regular_file(ec)) {
+      size += entry.file_size(ec);
+    }
+  }
+  return size;
+}
+
+static X_RESULT CompleteContentCall(pointer_t<XAM_OVERLAPPED> overlapped,
+                                    X_RESULT result) {
+  if (overlapped) {
+    kernel_state()->CompleteOverlappedImmediate(overlapped, result);
+    return X_ERROR_IO_PENDING;
+  }
+  return result;
+}
+
+// 2858 xam (message 0x2001A): the package file's attributes, as
+// {u32 attributes; u64 creation, last access, last write time; u64 size}.
+dword_result_t XamContentGetAttributesInternal_entry(
+    pointer_t<XCONTENT_AGGREGATE_DATA_SYSTEM> data, lpvoid_t attributes,
+    pointer_t<XAM_OVERLAPPED> overlapped) {
+  if (!data || !attributes) {
+    return CompleteContentCall(overlapped, X_ERROR_INVALID_PARAMETER);
+  }
+  auto path = SystemPackagePath(*data);
+  XELOGD("XamContentGetAttributesInternal: xuid {:016X} title {:08X} type {:08X} "
+         "file '{}' -> {}",
+         uint64_t(data->xuid), uint32_t(data->title_id),
+         static_cast<uint32_t>(
+             static_cast<XContentType>(data->content_data.content_type)),
+         data->content_data.file_name(), xe::path_to_utf8(path));
+  std::error_code ec;
+  if (!std::filesystem::is_directory(path, ec)) {
+    return CompleteContentCall(overlapped, X_ERROR_FILE_NOT_FOUND);
+  }
+  // On Windows the file clock counts FILETIME units from 1601.
+  uint64_t time = std::filesystem::last_write_time(path, ec)
+                      .time_since_epoch()
+                      .count();
+  uint8_t* out = attributes.as<uint8_t*>();
+  std::memset(out, 0, 0x24);
+  xe::store_and_swap<uint32_t>(out + 0x00, 0x80);  // FILE_ATTRIBUTE_NORMAL
+  xe::store_and_swap<uint64_t>(out + 0x04, time);
+  xe::store_and_swap<uint64_t>(out + 0x0C, time);
+  xe::store_and_swap<uint64_t>(out + 0x14, time);
+  xe::store_and_swap<uint64_t>(out + 0x1C, PackageSize(path));
+  return CompleteContentCall(overlapped, X_ERROR_SUCCESS);
+}
+DECLARE_XAM_EXPORT1(XamContentGetAttributesInternal, kContent, kImplemented);
+
+// 2858 xam (message 0x20011): the package header's metadata block, as it is
+// stored from offset 0x344 of a package (0x93D6 bytes).
+dword_result_t XamContentGetMetaDataInternal_entry(
+    pointer_t<XCONTENT_AGGREGATE_DATA_SYSTEM> data, lpvoid_t metadata,
+    pointer_t<XAM_OVERLAPPED> overlapped) {
+  if (!data || !metadata) {
+    return CompleteContentCall(overlapped, X_ERROR_INVALID_PARAMETER);
+  }
+  auto path = SystemPackagePath(*data);
+  XELOGD("XamContentGetMetaDataInternal: xuid {:016X} title {:08X} type {:08X} "
+         "file '{}' -> {}",
+         uint64_t(data->xuid), uint32_t(data->title_id),
+         static_cast<uint32_t>(
+             static_cast<XContentType>(data->content_data.content_type)),
+         data->content_data.file_name(), xe::path_to_utf8(path));
+  std::error_code ec;
+  if (!std::filesystem::is_directory(path, ec)) {
+    return CompleteContentCall(overlapped, X_ERROR_FILE_NOT_FOUND);
+  }
+  uint8_t* out = metadata.as<uint8_t*>();
+  std::memset(out, 0, 0x93D6);
+  xe::store_and_swap<uint32_t>(out + 0x0000,
+                               static_cast<uint32_t>(static_cast<XContentType>(data->content_data.content_type)));
+  xe::store_and_swap<uint64_t>(out + 0x0008, PackageSize(path));
+  xe::store_and_swap<uint32_t>(out + 0x001C, uint32_t(data->title_id));
+  // Profile ID of the package's creator (header offset 0x371).
+  xe::store_and_swap<uint64_t>(out + 0x002D, uint64_t(data->xuid));
+  // Display name (first language), UTF-16, 0x80 bytes.
+  auto name = data->content_data.display_name();
+  for (size_t i = 0; i < name.size() && i < 0x3F; ++i) {
+    xe::store_and_swap<uint16_t>(out + 0x00CD + i * 2, uint16_t(name[i]));
+  }
+  // The game's name and icon, which a console finds in the package header
+  // (written with the save): here from a profile's GPD for that game, the
+  // package owner's first.
+  {
+    const auto root = kernel_state()->emulator()->content_root();
+    const auto title = fmt::format("{:08X}", uint32_t(data->title_id));
+    std::vector<std::string> owners{fmt::format("{:016X}", uint64_t(data->xuid))};
+    for (auto& info : xe::filesystem::ListDirectories(root)) {
+      owners.push_back(xe::path_to_utf8(info.name));
+    }
+    for (auto& owner : owners) {
+      auto gpd_path =
+          root / owner / "FFFE07D1" / "00010000" / owner / (title + ".gpd");
+      std::error_code gpd_ec;
+      if (!std::filesystem::is_regular_file(gpd_path, gpd_ec)) {
+        continue;
+      }
+      std::vector<uint8_t> bytes(std::filesystem::file_size(gpd_path, gpd_ec));
+      if (FILE* file = xe::filesystem::OpenFile(gpd_path, "rb")) {
+        fread(bytes.data(), 1, bytes.size(), file);
+        fclose(file);
+      }
+      GpdInfo gpd(uint32_t(data->title_id), bytes);
+      auto title_name = gpd.GetString(kXdbfIdTitle);
+      auto icon = gpd.GetImage(kXdbfIdTitle);
+      for (size_t i = 0; i < title_name.size() && i < 0x3F; ++i) {
+        xe::store_and_swap<uint16_t>(out + 0x134D + i * 2,
+                                     uint16_t(title_name[i]));
+      }
+      if (!icon.empty() && icon.size() <= 0x4000) {
+        xe::store_and_swap<uint32_t>(out + 0x13D2, uint32_t(icon.size()));
+        std::memcpy(out + 0x53D6, icon.data(), icon.size());
+      }
+      if (!title_name.empty()) {
+        break;
+      }
+    }
+  }
+  XCONTENT_AGGREGATE_DATA content;
+  content.device_id = data->content_data.device_id;
+  content.content_type = data->content_data.content_type;
+  content.set_display_name(name);
+  content.set_file_name(data->content_data.file_name());
+  content.xuid = data->xuid;
+  content.title_id = data->title_id;
+  std::vector<uint8_t> thumbnail;
+  if (XSUCCEEDED(kernel_state()->content_manager()->GetContentThumbnail(
+          data->xuid, content, &thumbnail)) &&
+      !thumbnail.empty() && thumbnail.size() <= 0x4000) {
+    xe::store_and_swap<uint32_t>(out + 0x13CE, uint32_t(thumbnail.size()));
+    std::memcpy(out + 0x13D6, thumbnail.data(), thumbnail.size());
+  }
+  return CompleteContentCall(overlapped, X_ERROR_SUCCESS);
+}
+DECLARE_XAM_EXPORT1(XamContentGetMetaDataInternal, kContent, kImplemented);
