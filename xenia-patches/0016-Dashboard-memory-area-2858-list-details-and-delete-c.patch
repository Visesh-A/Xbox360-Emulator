+// 2858 xam (message 0x23004): a profile's account (gamertag, flags, ...) as
+// stored in its Account file, for the dashboard's memory area.
+dword_result_t XamProfileLoadAccountInfo_entry(
+    dword_t device_id, qword_t xuid, pointer_t<X_XAMACCOUNTINFO> account) {
+  if (!account) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+  auto* found =
+      kernel_state()->xam_state()->profile_manager()->GetAccount(xuid);
+  if (!found) {
+    return X_ERROR_FILE_NOT_FOUND;
+  }
+  std::memcpy(static_cast<X_XAMACCOUNTINFO*>(account), found, sizeof(X_XAMACCOUNTINFO));
+  return X_ERROR_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamProfileLoadAccountInfo, kNone, kImplemented);
+
+// 2858 xam (message 0x23006): the profile and everything it owns. (The
+// dashboard's "Delete Profile and Items"; "Delete Profile Only" deletes the
+// profile's package with XamContentDeleteInternal instead.)
+dword_result_t XamProfileDelete_entry(dword_t device_id, qword_t xuid) {
+  auto* profile_manager = kernel_state()->xam_state()->profile_manager();
+  if (!profile_manager->GetAccount(xuid)) {
+    return X_ERROR_FILE_NOT_FOUND;
+  }
+  return profile_manager->DeleteProfile(xuid) ? X_ERROR_SUCCESS
+                                              : X_ERROR_FUNCTION_FAILED;
+}
+DECLARE_XAM_EXPORT1(XamProfileDelete, kNone, kImplemented);
