+  if (!cached_ptr) {
+    auto xam_module = kernel_state()->GetModule("xam", true);
+    uint32_t section = 0, section_size = 0;
+    if (!xam_module ||
+        XFAILED(xam_module->GetSection("xam", &section, &section_size))) {
+      return X_E_FAIL;
+    }
+    auto* base = kernel_memory()->TranslateVirtual<uint8_t*>(section);
+    if (section_size < 0x16 || xe::load_and_swap<uint32_t>(base) != 'XUIZ') {
+      return X_E_FAIL;
+    }
+    uint32_t table_size = xe::load_and_swap<uint32_t>(base + 0x10);
+    uint16_t count = xe::load_and_swap<uint16_t>(base + 0x14);
+    uint32_t p = 0x16;
+    for (uint16_t i = 0; i < count && p + 9 <= section_size; ++i) {
+      uint32_t file_size = xe::load_and_swap<uint32_t>(base + p);
+      uint32_t file_offset = xe::load_and_swap<uint32_t>(base + p + 4);
+      uint8_t name_length = base[p + 8];
+      std::string name;
+      for (uint8_t c = 0; c < name_length; ++c) {
+        name += char(xe::load_and_swap<uint16_t>(base + p + 9 + c * 2));
+      }
+      p += 9 + name_length * 2;
+      if (xe::utf8::equal_case(name, "defaultsystemimage.png")) {
+        cached_ptr = section + 0x16 + table_size + file_offset;
+        cached_size = file_size;
+        break;
+      }
+    }
+    if (!cached_ptr) {
+      return X_E_FAIL;
+    }
+  }
+  if (image_ptr) *image_ptr = cached_ptr;
+  if (size_ptr) *size_ptr = cached_size;
+  return X_ERROR_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamGetDefaultSystemImage, kNone, kImplemented);
+
+// Collation of the console's xam (its own sort-weight tables): run the loaded
+// xam.xex's export, which is pure computation.
+dword_result_t XamUniSortCmpString_entry(lpvoid_t string1, lpvoid_t string2,
+                                         dword_t count) {
+  auto xam_module = kernel_state()->GetModule("xam", true);
+  uint32_t address =
+      xam_module ? xam_module->GetProcAddressByOrdinal(0x1E6) : 0;
+  if (!address) {
+    // No console xam: plain UTF-16 order.
+    auto* a = string1.as<uint16_t*>();
+    auto* b = string2.as<uint16_t*>();
+    for (uint32_t i = 0; i < count; ++i) {
+      uint16_t ca = xe::byte_swap(a[i]), cb = xe::byte_swap(b[i]);
+      if (ca != cb || !ca) {
+        return ca < cb ? uint32_t(-1) : ca > cb ? 1 : 0;
+      }
+    }
+    return 0;
+  }
+  uint64_t args[] = {string1.guest_address(), string2.guest_address(),
+                     count.value()};
+  return uint32_t(kernel_state()->processor()->Execute(
+      XThread::GetCurrentThread()->thread_state(), address, args, 3));
+}
+DECLARE_XAM_EXPORT1(XamUniSortCmpString, kNone, kImplemented);
