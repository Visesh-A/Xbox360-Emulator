+bool ProfileManager::DeleteProfilePackage(const uint64_t xuid) {
+  const uint8_t user_index = GetUserIndexAssignedToProfile(xuid);
+  if (user_index < XUserMaxUserCount) {
+    Logout(user_index);
+  }
+  DismountProfile(xuid);
+  accounts_.erase(xuid);
+  std::error_code ec;
+  std::filesystem::remove_all(GetProfilePath(xuid), ec);
+  if (ec) {
+    XELOGE("Cannot remove profile package: {}", ec.message());
+    return false;
+  }
+  return true;
+}
