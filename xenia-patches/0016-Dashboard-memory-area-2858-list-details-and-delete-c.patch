+// As xam's content enumerator (0xFE message 0x2000F) walks
+// Content\<xuid>\<title>\<type>\<package>: xuid 0 = every user (-1 = common
+// content only), title 0 = every title, type -1 = every type.
+static std::vector<XCONTENT_AGGREGATE_DATA> ListAllContent(
+    uint64_t xuid, uint32_t title_id, uint32_t content_type) {
+  std::vector<XCONTENT_AGGREGATE_DATA> result;
+  auto hex_dirs = [](const std::filesystem::path& dir, size_t digits) {
+    std::vector<std::pair<uint64_t, std::string>> out;
+    for (auto& info : xe::filesystem::ListDirectories(dir)) {
+      auto name = xe::path_to_utf8(info.name);
+      if (name.size() != digits ||
+          name.find_first_not_of("0123456789ABCDEFabcdef") !=
+              std::string::npos) {
+        continue;
+      }
+      out.emplace_back(string_util::from_string<uint64_t>(name, true), name);
+    }
+    return out;
+  };
+  const auto root = kernel_state()->emulator()->content_root();
+  for (auto& [owner, owner_name] : hex_dirs(root, 16)) {
+    if (xuid != 0 && xuid != owner && !(xuid == ~0ull && owner == 0)) {
+      continue;
+    }
+    for (auto& [title, title_name] : hex_dirs(root / owner_name, 8)) {
+      if (title_id != 0 && title_id != title) {
+        continue;
+      }
+      for (auto& [type, type_name] :
+           hex_dirs(root / owner_name / title_name, 8)) {
+        if (content_type != 0xFFFFFFFF && content_type != type) {
+          continue;
+        }
+        auto items = kernel_state()->content_manager()->ListContent(
+            static_cast<uint32_t>(DummyDeviceId::HDD), owner,
+            static_cast<uint32_t>(title), XContentType(uint32_t(type)));
+        for (auto& item : items) {
+          // The walk knows where each package lives; a header file's own
+          // fields do not carry the owner.
+          item.xuid = owner;
+          item.title_id = static_cast<uint32_t>(title);
+          result.push_back(item);
+        }
+      }
+    }
+  }
+  return result;
+}
