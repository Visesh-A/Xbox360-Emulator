 DEFINE_string(logged_profile_slot_1_xuid, "",
@@ -105,6 +114,24 @@ ProfileManager::ProfileManager(KernelState* kernel_state,
     LoadAccount(account_xuid);
   }
 
+  if (cvars::power_on) {
+    // Power-on: xam 818C1040 -> 818EBE88 asks for sign-in with flags 0xA44
+    // when XCONFIG_USER_RETAIL_FLAGS has 0x40; its 0x200 (818EA78C) signs
+    // the Auto Sign-In profile (XCONFIG_USER_DEFAULT_PROFILE) into slot 0
+    // when nobody is signed in, the profile is found and not recovering.
+    for (uint8_t slot = 0; slot < XUserMaxUserCount; ++slot) {
+      UpdateConfig(0, slot);
+    }
+    const uint64_t xuid = cvars::default_profile_xuid;
+    if ((cvars::retail_flags & 0x40) && xuid && accounts_.count(xuid) &&
+        !(accounts_[xuid].GetReservedFlags() &
+          X_XAMACCOUNTINFO::AccountReservedFlags::kRecovering)) {
+      XELOGI("Auto Sign-In: {:016X}", xuid);
+      Login(xuid, 0);
+    }
+    return;
+  }
+
   if (!cvars::logged_profile_slot_0_xuid.empty()) {
     Login(xe::string_util::from_string<uint64_t>(
               cvars::logged_profile_slot_0_xuid, true),
@@ -576,7 +603,15 @@ void ProfileManager::UpdateConfig(const uint64_t xuid, const uint8_t slot) {
   return;
 }
 
+// xam 818EA210: a deleted profile is no longer the Auto Sign-In one.
+void ProfileManager::ClearDefaultProfile(const uint64_t xuid) {
+  if (xuid && cvars::default_profile_xuid == xuid) {
+    xboxkrnl::SetDefaultProfile(0);
+  }
+}
