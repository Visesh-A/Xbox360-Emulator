+void GuideOverlay::DrawGamerTag(float k, float ox, float oy, float up,
+                                float hud_f) {
+  const GamerTagLayout& g = gamertag_layout_;
+  HudState state = HudAt("GamerTag", hud_f);
+  if (!g.loaded || !state.show || state.opacity <= 0.0f) {
+    return;
+  }
+  std::u16string gamertag;
+  if (auto* user = emulator_->kernel_state()->xam_state()->GetUserProfile(
+          uint32_t(hud_user_))) {
+    gamertag = xe::to_utf16(user->name());
+  }
+  if (gamertag.empty()) {
+    return;
+  }
+  if (gamertag != gamertag_shown_ || gamertag_k_ != k ||
+      !images_.count("gamertag")) {
+    // the text on its own, unrotated, at frame pixels per unit
+    Pixels pixels;
+    pixels.width = std::max(1, int(std::ceil(g.item.w * k)));
+    pixels.height = std::max(1, int(std::ceil(g.item.h * k)));
+    pixels.rgba.assign(size_t(pixels.width) * pixels.height * 4, 0);
+    RenderText(pixels, g.item, gamertag, k);
+    Image& image = images_["gamertag"];
+    image.texture = imgui_drawer_->CreateImGuiTexture(
+        pixels.width, pixels.height, pixels.rgba.data());
+    image.pixels_per_unit = k;
+    image.width = pixels.width;
+    image.height = pixels.height;
+    image.units_w = pixels.width / k;
+    image.units_h = pixels.height / k;
+    gamertag_shown_ = gamertag;
+    gamertag_k_ = k;
+  }
+  const Image& image = images_["gamertag"];
+  auto* draw_list = ImGui::GetForegroundDrawList();
+  // the box's corners through its transform, moved by its keyframed x
+  const float dx = state.x - g.key_x;
+  auto corner = [&](float u, float v) {
+    float x = g.tx + dx + g.m[0] * u + g.m[1] * v;
+    float y = g.ty + g.m[2] * u + g.m[3] * v;
+    return ImVec2((ox + x * k) * up, (oy + y * k) * up);
+  };
+  const float w = image.units_w, hh = image.units_h;
+  draw_list->AddImageQuad(
+      reinterpret_cast<ImTextureID>(image.texture.get()), corner(0, 0),
+      corner(w, 0), corner(w, hh), corner(0, hh), ImVec2(0, 0), ImVec2(1, 0),
+      ImVec2(1, 1), ImVec2(0, 1),
+      IM_COL32(255, 255, 255, int(state.opacity * 255.0f + 0.5f)));
+}
