diff --git a/src/xenia/cpu/xex_module.cc b/src/xenia/cpu/xex_module.cc
index a4455173a..2cc5bd6b0 100644
--- a/src/xenia/cpu/xex_module.cc
+++ b/src/xenia/cpu/xex_module.cc
@@ -367,8 +367,10 @@ int XexModule::ApplyPatch(XexModule* module) {
   memcpy(orig_session_key, module->session_key_, 0x10);
 
   // Header patch updated the base XEX key, need to redecrypt it
+  // (with the key the base was decrypted with: system modules like xam.xex
+  // use the XEX1 key)
   aes_decrypt_buffer(
-      module->is_dev_kit_ ? xe_xex2_devkit_key : xe_xex2_retail_key,
+      module->master_key_,
       reinterpret_cast<const uint8_t*>(module->xex_security_info()->aes_key),
       16, module->session_key_, 16);
 
@@ -514,6 +516,7 @@ int XexModule::ReadImage(const void* xex_addr, size_t xex_length,
   }
 
   is_dev_kit_ = key[0] == 0x00;
+  master_key_ = key;
 
   if (is_patch()) {
     // Make a copy of patch data for other XEX's to use with ApplyPatch()
@@ -555,6 +558,28 @@ int XexModule::ReadImage(const void* xex_addr, size_t xex_length,
     return 0;
   }
 
+  // Resource-only images (no PE at all) are valid on the console. Accept one
+  // when its first resource starts with a printable tag, which a wrong key
+  // would not produce.
+  xex2_opt_resource_info* resources = nullptr;
+  if (GetOptHeader(XEX_HEADER_RESOURCE_INFO, &resources) && resources &&
+      resources->size >= sizeof(xex2_resource) + 4) {
+    const uint32_t res_address = resources->resources[0].address;
+    if (res_address >= base_address_) {
+      const uint8_t* tag = memory()->TranslateVirtual(res_address);
+      bool printable = true;
+      for (int i = 0; i < 4; ++i) {
+        printable &= tag[i] >= 0x20 && tag[i] < 0x7F;
+      }
+      if (printable) {
+        XELOGI("XEX {}: resource-only image (first resource tag {:c}{:c}{:c}{:c})",
+               name_, tag[0], tag[1], tag[2], tag[3]);
+        is_resource_only_ = true;
+        return 0;
+      }
+    }
+  }
+
   // Not a patch and image doesn't have proper PE header, return 3
   return 3;
 }
@@ -981,6 +1006,12 @@ bool XexModule::LoadContinue() {
 
   finished_load_ = true;
 
+  if (is_resource_only_) {
+    // Nothing to link or execute; resources are read straight from memory.
+    low_address_ = high_address_ = base_address_;
+    return true;
+  }
+
   if (ReadPEHeaders()) {
     XELOGE("Failed to load XEX PE headers!");
     return false;
