+void Emulator::DumpPatchedSystemModules(const std::string& spec) {
+  // spec: "<dir with the base .xex files>|<dir with the .xexp patches>|<out>"
+  std::vector<std::string> parts;
+  std::stringstream stream(spec);
+  for (std::string part; std::getline(stream, part, '|');) {
+    parts.push_back(part);
+  }
+  if (parts.size() != 3) {
+    XELOGE("dump_patched_system_modules: expected base|patch|out");
+    return;
+  }
+  auto read = [](const std::filesystem::path& path) {
+    std::vector<uint8_t> data;
+    if (FILE* file = xe::filesystem::OpenFile(path, "rb")) {
+      fseek(file, 0, SEEK_END);
+      data.resize(ftell(file));
+      fseek(file, 0, SEEK_SET);
+      fread(data.data(), 1, data.size(), file);
+      fclose(file);
+    }
+    return data;
+  };
+  auto dump = [&](const std::string& name, xe::cpu::XexModule* xex) {
+    auto path = std::filesystem::path(parts[2]) / name;
+    if (FILE* file = xe::filesystem::OpenFile(path, "wb")) {
+      fwrite(memory_->TranslateVirtual(xex->base_address()), 1,
+             xex->image_size(), file);
+      fclose(file);
+      XELOGI("dump_patched_system_modules: {} ({:08X}+{:X})",
+             xe::path_to_utf8(path), xex->base_address(), xex->image_size());
+    }
+  };
+  for (const char* name :
+       {"hud", "huduiskin", "xam", "minimediaplayer", "signin"}) {
+    auto base_data = read(std::filesystem::path(parts[0]) /
+                          (std::string(name) + ".xex"));
+    auto patch_data = read(std::filesystem::path(parts[1]) /
+                           (std::string(name) + ".xexp"));
+    if (base_data.empty() || patch_data.empty()) {
+      XELOGE("dump_patched_system_modules: {} base or patch missing", name);
+      continue;
+    }
+    auto module = kernel::object_ref<kernel::UserModule>(
+        new kernel::UserModule(kernel_state_.get()));
+    if (XFAILED(module->LoadFromMemoryNamed(std::string(name) + "_research",
+                                            base_data.data(),
+                                            base_data.size()))) {
+      XELOGE("dump_patched_system_modules: {} failed to load", name);
+      continue;
+    }
+    dump(std::string(name) + "_1888.bin", module->xex_module());
+    auto patch = kernel::object_ref<kernel::UserModule>(
+        new kernel::UserModule(kernel_state_.get()));
+    if (XFAILED(patch->LoadFromMemoryNamed(std::string(name) + "_patch",
+                                           patch_data.data(),
+                                           patch_data.size()))) {
+      XELOGE("dump_patched_system_modules: {} patch failed to load", name);
+      continue;
+    }
+    int code = patch->xex_module()->ApplyPatch(module->xex_module());
+    if (code) {
+      XELOGE("dump_patched_system_modules: {} patch failed ({})", name, code);
+      continue;
+    }
+    dump(std::string(name) + "_2858.bin", module->xex_module());
+  }
+}
