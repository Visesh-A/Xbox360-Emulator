From e7eca47c13dc341554876cdf9a62ce0351ec93cb Mon Sep 17 00:00:00 2001
From: Xbox360 Blades <xbox360-blades@users.noreply.github.com>
Date: Thu, 1 Oct 2026 20:39:19 +0530
Subject: [PATCH 50/51] XMPGetMediaSources: xam's 10 source slots

The count query returns 10; each slot's 0xB4-byte record as xam
81A3FE68 fills it (slot, id, type, flags, state, name): the hard
drive's media index connected (XboxHardwareInfo hard disk), the PC,
MTP, audio CD, data CD and other slots with no device. unk1 != 0 lists
connected slots only (xam 81A410F8).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01D8Y8uNNBmKZ7J6MZXNhzHq
---
 src/xenia/kernel/xam/apps/xmp_app.cc | 50 ++++++++++++++++++++++++++--
 1 file changed, 47 insertions(+), 3 deletions(-)

diff --git a/src/xenia/kernel/xam/apps/xmp_app.cc b/src/xenia/kernel/xam/apps/xmp_app.cc
index 714652f06..21cb60ef7 100644
--- a/src/xenia/kernel/xam/apps/xmp_app.cc
+++ b/src/xenia/kernel/xam/apps/xmp_app.cc
@@ -8,6 +8,8 @@
  */
 
 #include "xenia/kernel/xam/apps/xmp_app.h"
+
+#include <cstring>
 #include "xenia/kernel/xthread.h"
 
 #include "xenia/base/logging.h"
@@ -456,11 +458,53 @@ X_HRESULT XmpApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
       XELOGD("XMPGetMediaSources({:08X}, {:08X}, {:08X}, {:08X}, {:08X})",
              args->xmp_client.get(), args->unk1.get(), args->sources_ptr.get(),
              args->max_sources.get(), args->count_ptr.get());
-      // No media devices are emulated: there are no sources. Failing the call
-      // instead made the blades dashboard abandon its Pictures screen.
+      // xam 81A410F8 over its 10 source slots (made in 81A43480). With no
+      // buffer: the count (10). Otherwise each slot's 0xB4-byte record
+      // (81A3FE68): +0 slot, +4 id (0x24 bytes), +0x28 type, +0x2C flags,
+      // +0x30 state (4 = connected), +0x34 name (64 chars); unk1 != 0 lists
+      // only connected slots. Slot 0 is the hard drive's media index (type
+      // 0, connected when XboxHardwareInfo has a hard disk, 81A47198); the
+      // others are their classes with no device: PC (4), three MTP players
+      // (3), audio CD (6), data CD (7), three more (2). Names are empty.
+      struct Slot {
+        const char* id;
+        uint32_t type, flags, state;
+      };
+      static const Slot kSlots[10] = {
+          {"Media Index", 0, 0x802, 4},  {"", 4, 0x82B, 0},
+          {"some mtp device", 3, 0, 0},  {"some mtp device", 3, 0, 0},
+          {"some mtp device", 3, 0, 0},  {"CDDA", 6, 0x802, 0},
+          {"some data cd", 7, 0x113, 0}, {"", 2, 0x113, 0},
+          {"", 2, 0x113, 0},             {"", 2, 0x113, 0}};
+      if (!args->sources_ptr) {
+        if (args->count_ptr) {
+          xe::store_and_swap<uint32_t>(
+              memory_->TranslateVirtual(args->count_ptr), 10);
+        }
+        return X_E_SUCCESS;
+      }
+      if (args->max_sources < 10) {
+        return X_HRESULT_FROM_WIN32(X_ERROR_NOT_ENOUGH_MEMORY);  // 0x80070008
+      }
+      uint8_t* out = memory_->TranslateVirtual(args->sources_ptr);
+      uint32_t count = 0;
+      for (uint32_t slot = 0; slot < 10; ++slot) {
+        const Slot& source = kSlots[slot];
+        if (args->unk1 && source.state != 4) {
+          continue;
+        }
+        uint8_t* record = out + count * 0xB4;
+        std::memset(record, 0, 0xB4);
+        xe::store_and_swap<uint32_t>(record + 0x00, slot);
+        std::memcpy(record + 0x04, source.id, std::strlen(source.id));
+        xe::store_and_swap<uint32_t>(record + 0x28, source.type);
+        xe::store_and_swap<uint32_t>(record + 0x2C, source.flags);
+        xe::store_and_swap<uint32_t>(record + 0x30, source.state);
+        ++count;
+      }
       if (args->count_ptr) {
         xe::store_and_swap<uint32_t>(
-            memory_->TranslateVirtual(args->count_ptr), 0);
+            memory_->TranslateVirtual(args->count_ptr), count);
       }
       return X_E_SUCCESS;
     }
