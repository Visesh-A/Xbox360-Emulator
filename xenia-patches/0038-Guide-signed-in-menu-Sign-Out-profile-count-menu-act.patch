+// What the menus fill in at run time: signed out, labelProfiles ("%d
+// Profiles Found" / "%d Profile Found", 91449310); signed in, the gamer
+// card's gamerscore, achievements and picture (xam's card control).
+void GuideOverlay::DrawMenuDynamic(float k, float ox, float oy, float up,
+                                   float alpha, bool signed_in) {
+  auto* state = emulator_->kernel_state()->xam_state();
+  std::u16string cred, achievements, profiles;
+  std::vector<uint8_t> tile;
+  uint64_t xuid = 0;
+  if (signed_in) {
+    auto* user = state->GetUserProfile(uint32_t(hud_user_));
+    if (!user) return;
+    xuid = user->xuid();
+    auto* tracker = state->user_tracker();
+    auto value = [&](kernel::xam::UserSettingId id) {
+      auto setting = tracker->GetSetting(user, kernel::kDashboardID, uint32_t(id));
+      if (!setting) return int32_t(0);
+      auto data = setting->get_host_data();
+      if (auto* v = std::get_if<int32_t>(&data)) return *v;
+      if (auto* u = std::get_if<uint32_t>(&data)) return int32_t(*u);
+      return int32_t(0);
+    };
+    cred = xe::to_utf16(std::to_string(
+        value(kernel::xam::UserSettingId::XPROFILE_GAMERCARD_CRED)));
+    achievements = xe::to_utf16(std::to_string(value(
+        kernel::xam::UserSettingId::XPROFILE_GAMERCARD_ACHIEVEMENTS_EARNED)));
+    auto icon = tracker->GetIcon(xuid, 0, kernel::xam::XTileType::kGamerTile, 0);
+    tile.assign(icon.begin(), icon.end());
+  } else {
+    const size_t count = state->profile_manager()->GetAccounts()->size();
+    std::u16string text = si_str_[count == 1 ? 38 : 37];
+    size_t at = text.find(u"%d");
+    if (at != std::u16string::npos) {
+      text.replace(at, 2, xe::to_utf16(std::to_string(count)));
+    }
+    profiles = text;
+  }
+  const std::string key = fmt::format(
+      "{}|{}|{}|{}|{}|{}|{}", signed_in, xe::to_utf8(cred),
+      xe::to_utf8(achievements), xe::to_utf8(profiles), xuid, tile.size(), k);
+  Image& image = images_["menu_dyn"];
+  if (key != menu_dyn_key_ || !image.texture) {
+    Pixels pixels;
+    pixels.width = int(std::ceil(layout_.canvas_w * k));
+    pixels.height = int(std::ceil(layout_.canvas_h * k));
+    pixels.rgba.assign(size_t(pixels.width) * pixels.height * 4, 0);
+    auto text = [&](const char* name, const std::u16string& value) {
+      auto it = si_text_.find(name);
+      if (it != si_text_.end()) RenderText(pixels, it->second, value, k);
+    };
+    if (signed_in) {
+      text("card_cred", cred);
+      text("card_ach", achievements);
+      if (!tile.empty()) {
+        Pixels picture;
+        int channels;
+        if (uint8_t* rgba = stbi_load_from_memory(
+                tile.data(), int(tile.size()), &picture.width,
+                &picture.height, &channels, STBI_rgb_alpha)) {
+          picture.rgba.assign(rgba,
+                              rgba + size_t(picture.width) * picture.height * 4);
+          stbi_image_free(rgba);
+          DrawPictureInto(pixels, picture, si_tile_[0], si_tile_[1],
+                          si_tile_[2], si_tile_[3], k);
+        }
+      }
+    } else {
+      text("profiles", profiles);
+    }
+    image.texture = imgui_drawer_->CreateImGuiTexture(
+        pixels.width, pixels.height, pixels.rgba.data());
+    image.width = pixels.width;
+    image.height = pixels.height;
+    menu_dyn_key_ = key;
+  }
+  auto V = [up](float x, float y) { return ImVec2(x * up, y * up); };
+  ImGui::GetForegroundDrawList()->AddImage(
+      reinterpret_cast<ImTextureID>(image.texture.get()), V(ox, oy),
+      V(ox + image.width, oy + image.height), ImVec2(0, 0), ImVec2(1, 1),
+      IM_COL32(255, 255, 255, int(alpha * 255.0f + 0.5f)));
+}
