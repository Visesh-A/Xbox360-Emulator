+void GuideOverlay::LoadSignedInLayout() {
+  std::ifstream in(asset_dir_ / "signedin.txt", std::ios::binary);
+  std::string line;
+  std::vector<std::array<std::string, 4>> nav_names;
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::istringstream ls(line);
+    std::string kind, name;
+    ls >> kind;
+    if (kind == "menusi") {
+      std::array<std::string, 4> nav;
+      ls >> name >> nav[0] >> nav[1] >> nav[2] >> nav[3];
+      layout_.menu_si.push_back({name});
+      nav_names.push_back(nav);
+    } else if (kind == "text") {
+      std::string color;
+      MessageBoxItem item;
+      item.is_text = true;
+      ls >> name >> item.x >> item.y >> item.w >> item.h >> item.size >>
+          item.ascent >> item.line_h >> item.style >> color;
+      item.color = uint32_t(std::stoul(color, nullptr, 16));
+      si_text_[name] = item;
+    } else if (kind == "image") {
+      ls >> name >> si_tile_[0] >> si_tile_[1] >> si_tile_[2] >> si_tile_[3];
+    }
+  }
+  // "up down left right" by name -> by index
+  for (size_t i = 0; i < layout_.menu_si.size(); ++i) {
+    for (int d = 0; d < 4; ++d) {
+      for (size_t j = 0; j < layout_.menu_si.size(); ++j) {
+        if (layout_.menu_si[j].id == nav_names[i][d]) {
+          layout_.menu_si[i].nav[d] = int(j);
+        }
+      }
+    }
+  }
+  std::ifstream strings(asset_dir_ / "signedin_strings.txt", std::ios::binary);
+  while (std::getline(strings, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::istringstream ls(line);
+    std::string kind, text;
+    int id;
+    ls >> kind >> id;
+    std::getline(ls >> std::ws, text);
+    if (kind == "str") si_str_[id] = xe::to_utf16(text);
+  }
+  if (layout_.menu_si.empty() || !si_text_.count("profiles")) {
+    XELOGW("Guide: signed-in menu assets missing (signedin.txt)");
+    layout_.menu_si.clear();
+  }
+}
+
+void GuideOverlay::RunAfterClose(std::function<void()> action) {
+  BeginClose();
+  std::thread([this, action = std::move(action)]() {
+    for (int i = 0; i < 100; ++i) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (mode_ == Mode::kClosed) break;
+    }
+    action();
+  }).detach();
+}
+
+// A on the menu (and X, its legend): what hud.xex's menus do. Signed out
+// (91449038, then 91449490 once the Guide has closed): Sign In and X ->
+// XamShowSigninUIp(user, 1, 0x10000); Create New Profile -> createprofile.
+// Signed in (914481F8, then 91448570): the gamer card -> gamerprofile; in
+// state 9 (a profile without an Xbox Live account) the community bar and
+// Private Chat -> InfoUpsellLive.xur (9144851C, XuiSceneNavigateForward);
+// X -> the Sign Out box.
+void GuideOverlay::MenuPress(bool x_button) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  const auto& menu = Menu();
+  if (focus_ < 0 || focus_ >= int(menu.size())) return;
+  const std::string item = menu[focus_].id;
+  const bool signed_in = menu_signed_in_;
+  const uint32_t user = hud_user_;
+  lock.unlock();
+  PlaySfx("btn_Select");
+  if (!signed_in) {
+    if (x_button || item == "btnSignIn") {
+      RunAfterClose([this, user]() { ShowSignIn(user); });
+    } else if (item == "btnNewProfile") {
+      RunAfterClose([this, user]() { ShowCreateProfile(user); });
+    }
+    return;
+  }
+  if (x_button) {
+    ShowMessageBox(Page::kSignOut);
+    return;
+  }
+  if (item == "ctlGamerCard") {
+    RunAfterClose([this, user]() { ShowGamerCard(user); });
+  } else if (item == "btnMessages" || item == "btnFriends" ||
+             item == "btnRecentPlayers" || item == "btnQuickChat") {
+    lock.lock();
+    upsell_from_menu_ = true;
+    page_ = Page::kUpsell;
+    ++page_version_;
+    transition_ = Transition::kHalfToFull;  // a full-width scene
+    transition_start_ = Clock::now();
+    lock.unlock();
+    PlaySfx("HUD_open");  // hudbkgnd HalfToFull, frame 75
+  }
+}
