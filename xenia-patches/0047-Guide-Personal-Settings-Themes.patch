+void UserTracker::SetRecord(uint64_t xuid, uint32_t title_id,
+                            uint16_t section, uint64_t id,
+                            std::span<const uint8_t> data) {
+  if (!IsUserTracked(xuid)) {
+    return;
+  }
+  auto user = kernel_state()->xam_state()->GetUserProfile(xuid);
+  if (!user) {
+    return;
+  }
+  GpdInfo* info = user->GetGpd(title_id);
+  if (!info) {
+    return;
+  }
+  info->SetRecord(section, id, data);
+  FlushUserData(xuid);
+}
+
+std::vector<uint8_t> UserTracker::GetRecord(uint64_t xuid, uint32_t title_id,
+                                            uint16_t section,
+                                            uint64_t id) const {
+  auto user = kernel_state()->xam_state()->GetUserProfile(xuid);
+  if (!user) {
+    return {};
+  }
+  const GpdInfo* info = user->GetGpd(title_id);
+  if (!info) {
+    return {};
+  }
+  auto data = info->GetRecord(section, id);
+  return {data.begin(), data.end()};
+}
