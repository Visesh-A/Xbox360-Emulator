+void GuideOverlay::SetGuideBackground(int kind, uint32_t color,
+                                      const std::string& tile) {
+  auto* state = emulator_->kernel_state()->xam_state();
+  uint32_t user_index;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    user_index = opt_user_;
+  }
+  auto* user = state->GetUserProfile(user_index);
+  if (!user) return;
+  std::vector<uint8_t> data;
+  if (kind == 1) {
+    data = {uint8_t(color >> 24), uint8_t(color >> 16), uint8_t(color >> 8),
+            uint8_t(color)};
+  } else if (kind == 2) {
+    data = ReadFileBytes(asset_dir_ / tile);
+  }
+  state->user_tracker()->SetRecord(user->xuid(), kernel::kDashboardID,
+                                   kGuideBackgroundSection, kGuideBackgroundId,
+                                   data);
+  XELOGI("Guide: Guide background {}",
+         kind == 0 ? std::string("default")
+         : kind == 1 ? fmt::format("colour {:08X}", color)
+                     : tile);
+  UpdateGuideLook(user_index);
+}
+
+// 9144C7F0 with flag 2: the profile's DashStyle file (deleted for the
+// default trim), then XNotifyBroadcast(0x8000000F) for the dashboard.
+void GuideOverlay::SetDashStyle(int style) {
+  auto* state = emulator_->kernel_state()->xam_state();
+  uint32_t user_index;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    user_index = opt_user_;
+  }
+  auto* user = state->GetUserProfile(user_index);
+  if (!user) return;
+  const auto path =
+      state->profile_manager()->GetProfilePath(user->xuid()) / "DashStyle";
+  std::error_code ec;
+  if (style == 0) {
+    std::filesystem::remove(path, ec);
+  } else {
+    std::ofstream out(path, std::ios::binary);
+    const uint8_t data[4] = {0, 0, 0, uint8_t(style)};
+    out.write(reinterpret_cast<const char*>(data), 4);
+  }
+  emulator_->kernel_state()->BroadcastNotification(0x8000000F, 1u << user_index);
+  XELOGI("Guide: dashboard trim {}", style);
+}
+
+// SkinsList's built-in themes (9144CD68): 9144C7F0(index, 3) writes the trim
+// and sets the Guide background (Carbon: Carbon.png, Glass: Pearl.png, the
+// default: none), then ThematicSkin (an installed theme) is deleted.
+void GuideOverlay::ApplyBuiltinTheme(int index) {
+  SetDashStyle(index);
+  if (index == 1) {
+    SetGuideBackground(2, 0, "Carbon.png");
+  } else if (index == 2) {
+    SetGuideBackground(2, 0, "Pearl.png");
+  } else {
+    SetGuideBackground(0, 0, "");
+  }
+  auto* state = emulator_->kernel_state()->xam_state();
+  uint32_t user_index;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    user_index = opt_user_;
+  }
+  if (auto* user = state->GetUserProfile(user_index)) {
+    std::error_code ec;
+    std::filesystem::remove(
+        state->profile_manager()->GetProfilePath(user->xuid()) / "ThematicSkin",
+        ec);
+  }
+  emulator_->kernel_state()->BroadcastNotification(0x8000000F, 1u << user_index);
+}
+
+std::string GuideOverlay::LookForUser(uint32_t user_index) {
+  auto* state = emulator_->kernel_state()->xam_state();
+  auto* user = state->GetUserProfile(user_index);
+  if (!user) return "";
+  const std::vector<uint8_t> data = state->user_tracker()->GetRecord(
+      user->xuid(), kernel::kDashboardID, kGuideBackgroundSection,
+      kGuideBackgroundId);
+  if (data.empty()) return "";
+  if (data.size() == 4) {
+    const uint32_t color = (uint32_t(data[0]) << 24) |
+                           (uint32_t(data[1]) << 16) |
+                           (uint32_t(data[2]) << 8) | uint32_t(data[3]);
+    return fmt::format("color:{:08X}", color);
+  }
+  for (const auto& [name, file] : kTiles) {
+    if (ReadFileBytes(asset_dir_ / file) == data) {
+      return std::string("image:") + file;
+    }
+  }
+  return "";
+}
+
+// The Guide drawn with the user's background: its images rendered for that
+// look (render_guide_look.py, in the background, the first time; the console
+// changes it at once). Draw switches to them once rendered (SwitchGuideLook).
+void GuideOverlay::UpdateGuideLook(uint32_t user_index) {
+  const std::string look = LookForUser(user_index);
+  std::filesystem::path dir = asset_dir_;
+  if (!look.empty()) {
+    std::string folder = look;
+    std::replace(folder.begin(), folder.end(), ':', '_');
+    dir = asset_dir_.parent_path() / "guide_looks" / folder;
+  }
+  bool start = false;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (look == current_look_ && dir == look_wanted_dir_) return;
+    current_look_ = look;
+    look_wanted_dir_ = dir;
+    look_checked_ = {};
+    if (!look.empty() && !std::filesystem::exists(dir / "ready")) {
+      start = !rendering_looks_[look];
+      rendering_looks_[look] = true;
+    }
+  }
+  if (!start) return;
+  if (cvars::guide_look_python.empty() || cvars::guide_look_script.empty()) {
+    XELOGW("Guide: guide_look_python / guide_look_script not set; the Guide "
+           "look {} is not rendered",
+           look);
+    return;
+  }
+  const std::wstring cmd = L"\"" + Wide(cvars::guide_look_python) +
+                           L"\" \"" +
+                           Wide(cvars::guide_look_script) +
+                           L"\" \"" + Wide(look) + L"\" \"" +
+                           dir.wstring() + L"\"";
+  std::vector<wchar_t> line(cmd.begin(), cmd.end());
+  line.push_back(0);
+  STARTUPINFOW si = {sizeof(si)};
+  PROCESS_INFORMATION pi = {};
+  if (CreateProcessW(nullptr, line.data(), nullptr, nullptr, FALSE,
+                     CREATE_NO_WINDOW | BELOW_NORMAL_PRIORITY_CLASS, nullptr,
+                     nullptr, &si, &pi)) {
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    XELOGI("Guide: rendering the Guide look {} in the background", look);
+  } else {
+    XELOGW("Guide: could not start {} ({})", cvars::guide_look_script,
+           GetLastError());
+  }
+}
+
+// UI thread (Draw): once the wanted look's images exist and no image job is
+// running, the images are prepared again from its folder; the ones on screen
+// stay until their replacements are ready (look_gen_).
+void GuideOverlay::SwitchGuideLook() {
+  std::filesystem::path wanted;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    wanted = look_wanted_dir_;
+    if (wanted.empty()) return;
+    const auto now = Clock::now();
+    if (now - look_checked_ < std::chrono::milliseconds(500)) return;
+    look_checked_ = now;
+  }
+  {
+    std::lock_guard<std::mutex> lock(look_mutex_);
+    if (wanted == image_dir_) return;
+  }
+  if (wanted != asset_dir_ && !std::filesystem::exists(wanted / "ready")) {
+    return;
+  }
+  if (prepare_busy_ || look_scaling_ ||
+      (create_profile_ready_ && !scaled_ready_)) {
+    return;
+  }
+  if (prepare_thread_.joinable()) prepare_thread_.join();
+  if (scale_thread_.joinable()) scale_thread_.join();
+  {
+    std::lock_guard<std::mutex> lock(look_mutex_);
+    image_dir_ = wanted;
+  }
+  XELOGI("Guide: images from {}", xe::path_to_utf8(wanted));
+  float ppu;
+  {
+    std::lock_guard<std::mutex> lock(prepare_mutex_);
+    ppu = prepare_for_;
+    prepared_.clear();
+    ++look_gen_;
+    if (ppu > 0) {
+      prepare_busy_ = true;
+      prepare_thread_ = std::thread([this, ppu]() { PrepareImages(ppu); });
+    }
+  }
+  const float scale_ppu = scaling_for_;
+  if (create_profile_ready_ && scale_ppu > 0) {
+    // scaled_ is swapped whole when done: the old look meanwhile
+    look_scaling_ = true;
+    scale_thread_ = std::thread([this, scale_ppu]() {
+      PrepareCreateProfileImages(scale_ppu);
+      look_scaling_ = false;
+      std::lock_guard<std::mutex> lock(mutex_);
+      ++page_version_;  // the composed pages again, from the new images
+    });
+  }
+}
