+void GuideOverlay::ThemesMove(Direction direction) {
+  const char* key = OptKey(page_);
+  if (!key || opt_fading_) return;
+  if (page_ == Page::kOptColor) {
+    static const char* const kSliders[] = {"sliderRed", "sliderGreen",
+                                           "sliderBlue"};
+    int i = 0;
+    while (i < 3 && opt_focus_ != kSliders[i]) ++i;
+    if (i == 3) i = 0;
+    if (direction == kUp || direction == kDown) {
+      const int next = i + (direction == kDown ? 1 : -1);
+      if (next < 0 || next > 2) return;
+      opt_focus_ = kSliders[next];
+      ++page_version_;
+      PlaySfx("btn_Focus");
+      return;
+    }
+    // XuiSlider: a step toward the end, within RangeMin 10 / RangeMax 255;
+    // the preview follows (ColorSelect 9144E1C8 -> 9144D670)
+    const int value = std::clamp(th_color_[i] + (direction == kRight ? 1 : -1),
+                                 10, 255);
+    if (value == th_color_[i]) return;
+    th_color_[i] = value;
+    ++page_version_;
+    return;
+  }
+  const OptPage& p = opt_pages_[key];
+  if (p.rows <= 0 || (direction != kUp && direction != kDown)) return;
+  ThemeList& list = th_list_[key];
+  const int next = list.sel + (direction == kDown ? 1 : -1);
+  if (next < 0 || next >= p.rows) return;
+  list.sel = next;
+  if (list.sel < list.top) list.top = list.sel;
+  if (list.sel >= list.top + p.visible) list.top = list.sel - p.visible + 1;
+  ++page_version_;
+  PlaySfx("btn_Focus");
+}
+
+void GuideOverlay::ThemesActivate() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  if (opt_fading_) return;
+  const Page page = page_;
+  const int sel = th_list_[OptKey(page)].sel;
+  if (page == Page::kOptColor) {
+    // A "Apply" (9144E168 -> 9144D6D0): the colour as the Guide background
+    const uint32_t color = 0xFF000000u | (uint32_t(th_color_[0]) << 16) |
+                           (uint32_t(th_color_[1]) << 8) | uint32_t(th_color_[2]);
+    lock.unlock();
+    SetGuideBackground(1, color, "");
+    return;
+  }
+  // a row's Press (its XuiButton visual: btn_Select)
+  if (page == Page::kOptSkin) {
+    // SkinsList 9144CC40: Customize -> OptionsPersonalization.xur; the
+    // built-in themes (Xbox 360 (Default), Carbon, Glass) -> 9144C7F0
+    if (sel == 0) {
+      OptGoTo(Page::kOptCust);
+      lock.unlock();
+      PlaySfx("btn_Select");
+      return;
+    }
+    lock.unlock();
+    PlaySfx("btn_Select");
+    ApplyBuiltinTheme(sel - 1);
+    return;
+  }
+  if (page == Page::kOptCust) {
+    // CustomizeList 9144D118: table 0x914540A4 (DashStyleSelect,
+    // TileSelect; Camera Effect removed without a camera)
+    OptGoTo(sel == 0 ? Page::kOptTrim : Page::kOptTile);
+    lock.unlock();
+    PlaySfx("btn_Select");
+    return;
+  }
+  if (page == Page::kOptTrim) {
+    // StyleList 9144D090: the built-in trims -> 9144C7F0 (DashStyle only)
+    lock.unlock();
+    PlaySfx("btn_Select");
+    SetDashStyle(sel);
+    return;
+  }
+  if (page == Page::kOptTile) {
+    // TileList 9144D360: Custom Color -> ColorSelect.xur; Default -> the
+    // default background; a tile -> its image (hud resource)
+    if (sel == 0) {
+      OptGoTo(Page::kOptColor);
+      lock.unlock();
+      PlaySfx("btn_Select");
+      return;
+    }
+    lock.unlock();
+    PlaySfx("btn_Select");
+    if (sel == 1) {
+      SetGuideBackground(0, 0, "");
+    } else if (sel - 2 < int(std::size(kTiles))) {
+      SetGuideBackground(2, 0, kTiles[sel - 2].second);
+    }
+  }
+}
