+std::span<const uint8_t> GpdInfo::GetRecord(uint16_t section,
+                                            uint64_t id) const {
+  const Entry* entry = GetEntry(section, id);
+  if (!entry) {
+    return {};
+  }
+  return {entry->data.data(), entry->data.size()};
+}
+
+void GpdInfo::SetRecord(uint16_t section, uint64_t id,
+                        std::span<const uint8_t> data) {
+  if (data.empty()) {
+    if (const Entry* entry = GetEntry(section, id)) {
+      DeleteEntry(entry);
+    }
+    return;
+  }
+  Entry new_entry(id, section, static_cast<uint32_t>(data.size()));
+  memcpy(new_entry.data.data(), data.data(), data.size());
+  UpsertEntry(&new_entry);
+}
