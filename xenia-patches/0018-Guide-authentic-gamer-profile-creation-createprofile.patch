+// --------------------------------------------------------- creating a profile
+
+namespace {
+// The console's own strings file (make_createprofile_strings.py): one
+// "<key> <text>" per line, \n escaped.
+std::u16string Unescape(const std::string& text) {
+  std::string out;
+  for (size_t i = 0; i < text.size(); ++i) {
+    if (text[i] == '\\' && i + 1 < text.size()) {
+      out.push_back(text[i + 1] == 'n' ? '\n' : text[i + 1]);
+      ++i;
+    } else {
+      out.push_back(text[i]);
+    }
+  }
+  return xe::to_utf16(out);
+}
+
+bool IsLetter(char16_t c) {
+  return (c >= u'a' && c <= u'z') || (c >= u'A' && c <= u'Z');
+}
+bool IsDigit(char16_t c) { return c >= u'0' && c <= u'9'; }
+}  // namespace
+
+void GuideOverlay::LoadCreateProfileLayout() {
+  auto read_text = [](std::istream& in, MessageBoxItem& item) {
+    std::string color;
+    in >> item.x >> item.y >> item.w >> item.h >> item.size >> item.ascent >>
+        item.line_h >> item.style >> color;
+    item.color = uint32_t(std::stoul(color, nullptr, 16));
+    item.is_text = true;
+  };
+  std::ifstream kbd(asset_dir_ / "kbd.txt");
+  std::string kind;
+  while (kbd >> kind) {
+    if (kind == "text") {
+      std::string name;
+      kbd >> name;
+      MessageBoxItem item;
+      read_text(kbd, item);
+      if (name == "title") {
+        kbd_title_ = item;
+      } else if (name == "prompt") {
+        kbd_prompt_ = item;
+      } else if (name == "edit") {
+        kbd_edit_ = item;
+      } else if (name.rfind("capf.", 0) == 0) {
+        auto& key = kbd_keys_[name.substr(5)];
+        key.capf = item;
+        key.has_capf = true;
+      } else if (name.rfind("cap.", 0) == 0) {
+        auto& key = kbd_keys_[name.substr(4)];
+        key.cap = item;
+        key.has_cap = true;
+      }
+    } else if (kind == "focus") {
+      std::string id;
+      kbd >> id;
+      auto& key = kbd_keys_[id];
+      kbd >> key.x >> key.y >> key.w >> key.h >> key.image;
+    } else if (kind == "caret") {
+      kbd >> kbd_caret_[0] >> kbd_caret_[1] >> kbd_caret_[2] >> kbd_caret_[3];
+    } else if (kind == "key") {
+      std::string id;
+      int ch, enabled;
+      kbd >> id >> ch >> enabled;
+      auto& key = kbd_keys_[id];
+      key.id = id;
+      key.ch = char16_t(ch);
+      key.enabled = enabled != 0;
+    } else if (kind == "nav") {
+      std::string id;
+      kbd >> id;
+      auto& key = kbd_keys_[id];
+      for (auto& n : key.nav) {
+        kbd >> n;
+        if (n == "-") n.clear();
+      }
+    } else if (kind == "default") {
+      kbd >> kbd_default_;
+    } else {
+      std::string rest;
+      std::getline(kbd, rest);
+    }
+  }
+  std::ifstream save(asset_dir_ / "congrats.txt");
+  while (save >> kind) {
+    if (kind == "text") {
+      std::string name;
+      save >> name;
+      MessageBoxItem item;
+      read_text(save, item);
+      if (name == "gamertag") save_gamertag_ = item;
+    } else if (kind == "button") {
+      SaveButton b;
+      save >> b.id >> b.image >> b.up >> b.down;
+      if (b.up == "-") b.up.clear();
+      if (b.down == "-") b.down.clear();
+      save_buttons_.push_back(b);
+    } else if (kind == "default") {
+      save >> save_default_;
+    } else {
+      std::string rest;
+      std::getline(save, rest);
+    }
+  }
+  std::ifstream strings(asset_dir_ / "createprofile.txt", std::ios::binary);
+  std::string line;
+  while (std::getline(strings, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    size_t space = line.find(' ');
+    if (space != std::string::npos) {
+      profile_strings_[line.substr(0, space)] = Unescape(line.substr(space + 1));
+    }
+  }
+  create_profile_ready_ = !kbd_keys_.empty() && !save_buttons_.empty() &&
+                          profile_strings_.count("title") && font_;
+  if (!create_profile_ready_) {
+    XELOGW("Guide: profile creation assets missing (kbd.txt, congrats.txt, "
+           "createprofile.txt)");
+  }
+}
+
+void GuideOverlay::PrepareCreateProfileImages(float ppu) {
+  auto start = Clock::now();
+  std::vector<std::string> names = {"kbd_base", "kbd_caret"};
+  for (auto& b : save_buttons_) names.push_back(b.image);
+  for (auto& [id, key] : kbd_keys_) {
+    if (!key.image.empty()) names.push_back("kbd_focus_" + key.image);
+  }
+  std::map<std::string, Pixels> out;
+  float f = ppu / layout_.scale;
+  for (const auto& name : names) {
+    Pixels pixels;
+    if (!Decode(name, pixels)) continue;
+    if (f < 1.0f) {
+      pixels = Resample(pixels, std::max(1, int(std::lround(pixels.width * f))),
+                        std::max(1, int(std::lround(pixels.height * f))));
+    }
+    out[name] = std::move(pixels);
+  }
+  {
+    std::lock_guard<std::mutex> lock(prepare_mutex_);
+    scaled_ = std::move(out);
+    scaled_ppu_ = ppu;
+  }
+  scaled_ready_ = true;
+  XELOGI("Guide: profile screens prepared in {} ms",
+         std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() -
+                                                               start)
+             .count());
+}
+
+bool GuideOverlay::ShowCreateProfile() {
+  if (!create_profile_ready_) {
+    return false;
+  }
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode_ != Mode::kClosed || create_profile_active_) {
+      return false;
+    }
+    create_profile_active_ = true;
+    kbd_text_.clear();
+    kbd_cursor_ = 0;
+    kbd_caps_ = false;
+    kbd_focus_ = kbd_default_;
+    save_focus_ = save_default_;
+    ++page_version_;
+  }
+  // Prepared for the screen's size; if the Guide has not been drawn yet, the
+  // first frame does it (Draw).
+  if (display_h_ > 0) {
+    float ppu = display_h_ / layout_.canvas_h;
+    if (scaling_for_ != ppu) {
+      scaling_for_ = ppu;
+      scaled_ready_ = false;
+      if (scale_thread_.joinable()) scale_thread_.join();
+      scale_thread_ =
+          std::thread([this, ppu]() { PrepareCreateProfileImages(ppu); });
+    }
+  }
+  emulator_->kernel_state()->BroadcastNotification(
+      xe::kXNotificationSystemUI, true);
+  XELOGI("Guide: create profile");
+  Open(Page::kKeyboard);
+  return true;
+}
+
+void GuideOverlay::EndCreateProfile() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    create_profile_active_ = false;
+  }
+  BeginClose();
+  std::thread([this]() {
+    std::this_thread::sleep_for(std::chrono::milliseconds(600));
+    emulator_->kernel_state()->BroadcastNotification(
+        xe::kXNotificationSystemUI, false);
+  }).detach();
+}
+
+void GuideOverlay::KeyboardPress(const std::string& id) {
+  auto it = kbd_keys_.find(id);
+  if (it == kbd_keys_.end() || !it->second.enabled) {
+    return;
+  }
+  const KeyboardKey& key = it->second;
+  constexpr size_t kMaxLength = 15;  // createprofile passes 15
+  if (key.ch) {
+    if (kbd_text_.size() < kMaxLength) {
+      char16_t c = key.ch;
+      if (kbd_caps_ && c >= u'a' && c <= u'z') c = char16_t(c - u'a' + u'A');
+      kbd_text_.insert(kbd_text_.begin() + kbd_cursor_, c);
+      ++kbd_cursor_;
+    }
+  } else if (id == "Key.Spc") {
+    if (kbd_text_.size() < kMaxLength) {
+      kbd_text_.insert(kbd_text_.begin() + kbd_cursor_, u' ');
+      ++kbd_cursor_;
+    }
+  } else if (id == "Key.BS") {
+    if (kbd_cursor_ > 0) {
+      kbd_text_.erase(kbd_text_.begin() + kbd_cursor_ - 1);
+      --kbd_cursor_;
+    }
+  } else if (id == "Key.Caps") {
+    kbd_caps_ = !kbd_caps_;
+  } else if (id == "Key.Left") {
+    kbd_cursor_ = std::max(0, kbd_cursor_ - 1);
+  } else if (id == "Key.Right") {
+    kbd_cursor_ = std::min(int(kbd_text_.size()), kbd_cursor_ + 1);
+  } else if (id == "Key.OK") {
+    KeyboardSubmit();
+    return;
+  }
+  caret_start_ = Clock::now();
+  ++page_version_;
+}
+
+void GuideOverlay::KeyboardSubmit() {
+  // createprofile 90105E40: runs of spaces become one, a trailing one goes.
+  std::u16string name;
+  bool space = false;
+  for (char16_t c : kbd_text_) {
+    if (c == u' ') {
+      if (space) continue;
+      space = true;
+    } else {
+      space = false;
+    }
+    name.push_back(c);
+  }
+  if (space && !name.empty()) name.pop_back();
+  // 90107AD0 (offline profile names).
+  std::u16string error;
+  if (name.empty()) {
+    error = profile_strings_["err_empty"];
+  } else if (!IsLetter(name[0])) {
+    error = profile_strings_["err_letter"];
+  } else {
+    bool prev_space = false;
+    for (size_t i = 1; i < name.size() && error.empty(); ++i) {
+      char16_t c = name[i];
+      if (c == u' ') {
+        if (prev_space) error = profile_strings_["err_spaces"];
+        prev_space = true;
+      } else if (IsLetter(c) || IsDigit(c)) {
+        prev_space = false;
+      } else {
+        error = profile_strings_["err_chars"];
+      }
+    }
+    if (error.empty() && name.back() == u' ') {
+      error = profile_strings_["err_end"];
+    }
+    if (error.empty()) {
+      // An existing profile with this name (90107918).
+      auto* profiles = emulator_->kernel_state()->xam_state()->profile_manager();
+      for (const auto& [xuid, account] : *profiles->GetAccounts()) {
+        if (xe::utf8::equal_case(account.GetGamertagString(),
+                                 xe::to_utf8(name))) {
+          std::u16string text = profile_strings_["err_dup"];
+          size_t at = text.find(u"%s");
+          if (at != std::u16string::npos) text.replace(at, 2, name);
+          error = text;
+          break;
+        }
+      }
+    }
+  }
+  if (!error.empty()) {
+    // XamShowMessageBox(title "Gamer Profile", error, {OK}); the keyboard
+    // comes back with the text when it closes.
+    kernel::xam::TitleMessageBox box;
+    box.title = profile_strings_["title"];
+    box.text = error;
+    box.buttons = {profile_strings_["ok"]};
+    ShowProfileBox(box, Page::kKeyboard);
+    return;
+  }
+  kbd_text_ = name;
+  kbd_cursor_ = int(name.size());
+  page_ = Page::kSaveProfile;
+  save_focus_ = save_default_;
+  ++page_version_;
+}
+
+void GuideOverlay::ShowProfileBox(const kernel::xam::TitleMessageBox& box,
+                                  Page return_to) {
+  float ppu = scaled_ppu_ > 0 ? scaled_ppu_ : layout_.scale;
+  std::map<std::string, Pixels> images;
+  for (int focus = 0; focus < int(box.buttons.size()); ++focus) {
+    Pixels pixels;
+    if (!ComposeMessageBox(box, focus, pixels)) {
+      return;
+    }
+    float f = ppu / layout_.scale;
+    if (f < 1.0f) {
+      pixels = Resample(pixels, std::max(1, int(std::lround(pixels.width * f))),
+                        std::max(1, int(std::lround(pixels.height * f))));
+    }
+    images["msgbox_title_f" + std::to_string(focus)] = std::move(pixels);
+  }
+  {
+    std::lock_guard<std::mutex> lock(prepare_mutex_);
+    title_images_ = std::move(images);
+    title_images_ppu_ = ppu;
+  }
+  title_buttons_ = int(box.buttons.size());
+  profile_box_return_ = return_to;
+  page_ = Page::kProfileError;
+  choice_ = std::clamp(int(box.focus), 0, title_buttons_ - 1);
+  transition_ = Transition::kToError;  // FullToError
+  transition_start_ = Clock::now();
+}
+
+void GuideOverlay::SaveProfilePress() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  if (save_focus_ != "doneButton") {
+    // Join Xbox Live / Customize Profile: AddXboxLive.xur checks the network;
+    // without one createprofile shows "Can't Connect" (901030D8).
+    kernel::xam::TitleMessageBox box;
+    box.title = profile_strings_["cant_title"];
+    box.text = profile_strings_["cant_text"];
+    box.buttons = {profile_strings_["test"], profile_strings_["cancel"]};
+    box.focus = 0;
+    box.icon = 1;  // XamShowMessageBox flags 1
+    ShowProfileBox(box, Page::kSaveProfile);
+    lock.unlock();
+    PlaySfx("btn_Select");
+    return;
+  }
+  std::string name = xe::to_utf8(kbd_text_);
+  lock.unlock();
+  PlaySfx("btn_Select");
+  auto* profiles = emulator_->kernel_state()->xam_state()->profile_manager();
+  // Signed in when nobody else is.
+  bool autologin = !profiles->IsAnyProfileSignedIn();
+  bool created = profiles->CreateProfile(name, autologin, false);
+  XELOGI("Guide: profile \"{}\" {}", name, created ? "created" : "NOT created");
+  EndCreateProfile();
+}
+
+bool GuideOverlay::ComposeCreateProfilePage(float ppu, Pixels& out) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  const Page page = page_;
+  const std::u16string text = kbd_text_;
+  const bool caps = kbd_caps_;
+  const std::string focus = page == Page::kSaveProfile ? save_focus_ : kbd_focus_;
+  lock.unlock();
+  std::lock_guard<std::mutex> images_lock(prepare_mutex_);
+  if (!scaled_ready_ || scaled_ppu_ != ppu) {
+    return false;
+  }
+  if (page == Page::kSaveProfile) {
+    std::string image;
+    for (auto& b : save_buttons_) {
+      if (b.id == focus) image = b.image;
+    }
+    auto it = scaled_.find(image);
+    if (it == scaled_.end()) return false;
+    out = it->second;
+    RenderText(out, save_gamertag_, text, ppu);
+    return true;
+  }
+  auto base = scaled_.find("kbd_base");
+  if (base == scaled_.end()) return false;
+  out = base->second;
+  auto key_it = kbd_keys_.find(focus);
+  if (key_it != kbd_keys_.end()) {
+    auto crop = scaled_.find("kbd_focus_" + key_it->second.image);
+    if (crop != scaled_.end()) {
+      const Pixels& c = crop->second;
+      int x0 = int(std::lround(key_it->second.x * ppu));
+      int y0 = int(std::lround(key_it->second.y * ppu));
+      for (int y = 0; y < c.height; ++y) {
+        int oy = y0 + y;
+        if (oy < 0 || oy >= out.height) continue;
+        for (int x = 0; x < c.width; ++x) {
+          int ox = x0 + x;
+          if (ox < 0 || ox >= out.width) continue;
+          const uint8_t* p = &c.rgba[(size_t(y) * c.width + x) * 4];
+          BlendPixel(&out.rgba[(size_t(oy) * out.width + ox) * 4], p[0] / 255.0f,
+                     p[1] / 255.0f, p[2] / 255.0f, p[3] / 255.0f);
+        }
+      }
+    }
+  }
+  RenderText(out, kbd_title_, profile_strings_["title"], ppu);
+  RenderText(out, kbd_prompt_, profile_strings_["prompt"], ppu);
+  RenderText(out, kbd_edit_, text, ppu);
+  // Captions: vk's key table (upper case with Caps), its string table for
+  // Caps/Done/Backspace/Accents, the scene's own for the rest.
+  static const std::map<std::string, std::u16string> kNames = {
+      {"Key.Caps", u"Caps"},     {"Key.OK", u"Done"},
+      {"Key.BS", u"Backspace"},  {"Key.Next", u"Accents"},
+      {"Key.Prev", u"Symbols"},  {"Key.Spc", u"Space"},
+      {"Key.Left", u"Cursor"},   {"Key.Right", u"Cursor"}};
+  for (auto& [id, key] : kbd_keys_) {
+    std::u16string caption;
+    if (key.ch) {
+      char16_t c = key.ch;
+      if (caps && c >= u'a' && c <= u'z') c = char16_t(c - u'a' + u'A');
+      caption.push_back(c);
+    } else {
+      auto n = kNames.find(id);
+      if (n != kNames.end()) caption = n->second;
+    }
+    const bool focused = id == focus && key.has_capf;
+    if (focused) {
+      RenderText(out, key.capf, caption, ppu);
+    } else if (key.has_cap) {
+      RenderText(out, key.cap, caption, ppu);
+    }
+  }
+  return true;
+}
+
 }  // namespace app
 }  // namespace xe
