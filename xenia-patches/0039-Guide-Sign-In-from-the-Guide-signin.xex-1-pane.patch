+void GuideOverlay::LoadSignInLayout() {
+  std::ifstream in(asset_dir_ / "signin.txt", std::ios::binary);
+  std::string line;
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::istringstream ls(line);
+    std::string kind, name;
+    ls >> kind;
+    if (kind == "text") {
+      std::string color;
+      MessageBoxItem item;
+      item.is_text = true;
+      ls >> name >> item.x >> item.y >> item.w >> item.h >> item.size >>
+          item.ascent >> item.line_h >> item.style >> color;
+      item.color = uint32_t(std::stoul(color, nullptr, 16));
+      sn_text_[name] = item;
+    } else if (kind == "image") {
+      std::array<float, 4> r;
+      ls >> name >> r[0] >> r[1] >> r[2] >> r[3];
+      sn_image_[name] = r;
+    } else if (kind == "list") {
+      for (float& v : sn_list_) ls >> v;
+    } else if (kind == "str") {
+      int id;
+      std::string text;
+      ls >> id;
+      std::getline(ls >> std::ws, text);
+      sn_str_[id] = xe::to_utf16(text);
+    }
+  }
+  sn_ready_ = sn_list_[4] > 0 && sn_text_.count("st_l1") && sn_str_.count(53);
+}
+
+// XamShowSigninUIp(user, 1 pane, 0x10000) from the Guide's Sign In. No
+// profiles (901054CC): XamShowMessageBox("No Profiles Found", 9, {Create
+// New Profile, Exit}, focus 0, icon 2); Create New Profile ->
+// XamShowCreateProfileUI (90104890). Else signin1.xur (a half-width scene)
+// with the console's profiles.
 bool GuideOverlay::ShowSignIn(uint32_t user_index) {
-  XELOGW("Guide: sign in (signin.xex) is not built yet (controller {})",
-         user_index);
-  return false;
+  if (!sn_ready_ || !create_profile_ready_) return false;
+  auto* state = emulator_->kernel_state()->xam_state();
+  std::vector<SiProfile> profiles;
+  for (const auto& [xuid, account] : *state->profile_manager()->GetAccounts()) {
+    SiProfile p;
+    p.xuid = xuid;
+    p.gamertag = xe::to_utf16(account.GetGamertagString());
+    // +0x1B0: "Xbox Live" for a profile with a Live account (its Live XUID)
+    p.live = account.IsLiveEnabled() ? sn_str_[16] : u"";
+    p.device = sn_str_[15];  // the hard drive ("HDD")
+    profiles.push_back(std::move(p));
+  }
+  if (profiles.empty()) {
+    kernel::xam::TitleMessageBox box;
+    box.title = sn_str_[53];
+    box.text = sn_str_[9];
+    box.buttons = {sn_str_[6], sn_str_[12]};
+    box.focus = 0;
+    box.icon = 2;
+    return ShowTitleMessageBox(box, [this, user_index](int choice) {
+      if (choice == 0) {
+        std::thread([this, user_index]() {
+          for (int i = 0; i < 100; ++i) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (mode_ == Mode::kClosed) break;
+          }
+          ShowCreateProfile(user_index);
+        }).detach();
+      }
+    });
+  }
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode_ != Mode::kClosed || create_profile_active_ || gp_active_ ||
+        sn_active_) {
+      return false;
+    }
+    sn_active_ = true;
+    sn_status_ = false;
+    sn_profiles_ = std::move(profiles);
+    sn_focus_ = sn_top_ = 0;
+    sn_user_ = user_index;
+    hud_user_ = user_index;
+    ++page_version_;
+  }
+  if (display_h_ > 0) {
+    float ppu = display_h_ / layout_.canvas_h;
+    if (scaling_for_ != ppu) {
+      scaling_for_ = ppu;
+      scaled_ready_ = false;
+      if (scale_thread_.joinable()) scale_thread_.join();
+      scale_thread_ =
+          std::thread([this, ppu]() { PrepareCreateProfileImages(ppu); });
+    }
+  }
+  emulator_->kernel_state()->BroadcastNotification(xe::kXNotificationSystemUI,
+                                                   true);
+  XELOGI("Guide: sign in (signin.xex, 1 pane)");
+  Open(Page::kSignIn);
+  return true;
+}
+
+void GuideOverlay::EndSignIn() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    sn_active_ = false;
+  }
+  BeginClose();
+  std::thread([this]() {
+    std::this_thread::sleep_for(std::chrono::milliseconds(600));
+    emulator_->kernel_state()->BroadcastNotification(
+        xe::kXNotificationSystemUI, false);
+  }).detach();
+}
+
+void GuideOverlay::SignInMove(Direction direction) {
+  if (sn_status_ || (direction != kUp && direction != kDown)) return;
+  const int count = int(sn_profiles_.size());
+  const int visible = std::max(1, int(sn_list_[4]));
+  const int next = sn_focus_ + (direction == kDown ? 1 : -1);
+  if (next < 0 || next >= count) return;
+  sn_focus_ = next;
+  if (sn_focus_ < sn_top_) sn_top_ = sn_focus_;
+  if (sn_focus_ >= sn_top_ + visible) sn_top_ = sn_focus_ - visible + 1;
+  ++page_version_;
+  PlaySfx("btn_Focus");
+}
+
+// A on a profile (901088D0): the pane goes to status.xur with it
+// ("Signing in"); it is signed in on the Guide's controller and signin.xex
+// ends.
+void GuideOverlay::SignInActivate() {
+  uint64_t xuid;
+  uint32_t user;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (sn_status_ || sn_focus_ < 0 || sn_focus_ >= int(sn_profiles_.size())) {
+      return;
+    }
+    sn_status_ = true;
+    xuid = sn_profiles_[sn_focus_].xuid;
+    user = sn_user_;
+    ++page_version_;
+  }
+  PlaySfx("btn_Select");
+  Schedule(Clock::now() + std::chrono::milliseconds(1000), [this, xuid, user]() {
+    auto* profiles = emulator_->kernel_state()->xam_state()->profile_manager();
+    const uint8_t slot = user < 4 ? uint8_t(user) : XUserIndexAny;
+    if (slot != XUserIndexAny) profiles->Logout(slot, false);
+    profiles->Login(xuid, slot);
+    XELOGI("Guide: signed in {:016X} on controller {}", xuid, user);
+    EndSignIn();
+  });
+}
+
+bool GuideOverlay::ComposeSignInPage(float ppu, Pixels& out) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  const std::vector<SiProfile> profiles = sn_profiles_;
+  const bool status = sn_status_;
+  const int focus = sn_focus_, top = sn_top_;
+  lock.unlock();
+  // XamReadImage(0xB): the profile's gamer picture. The listed profiles are
+  // not signed in (no User_ device mounted), so it is read from the
+  // profile's folder (tile_64.png, as UserProfile::LoadProfileIcon).
+  auto* profile_manager =
+      emulator_->kernel_state()->xam_state()->profile_manager();
+  auto picture_of = [&](uint64_t xuid) -> const Pixels* {
+    std::ifstream in(profile_manager->GetProfilePath(xuid) / "tile_64.png",
+                     std::ios::binary);
+    std::vector<uint8_t> icon((std::istreambuf_iterator<char>(in)),
+                              std::istreambuf_iterator<char>());
+    return VgPicture(fmt::format("p{:016X}_{}", xuid, icon.size()), icon);
+  };
+  std::lock_guard<std::mutex> images_lock(prepare_mutex_);
+  if (!scaled_ready_ || scaled_ppu_ != ppu) return false;
+  auto it = scaled_.find(status ? "si_status" : "si_list");
+  if (it == scaled_.end()) return false;
+  out = it->second;
+  auto text = [&](const std::string& name, const std::u16string& value,
+                  float dx = 0, float dy = 0) {
+    auto t = sn_text_.find(name);
+    if (t == sn_text_.end()) return;
+    MessageBoxItem item = t->second;
+    item.x += dx;
+    item.y += dy;
+    RenderText(out, item, value, ppu);
+  };
+  auto picture = [&](const std::string& name, const Pixels* p, float dx = 0,
+                     float dy = 0) {
+    auto r = sn_image_.find(name);
+    if (p && r != sn_image_.end()) {
+      DrawPictureInto(out, *p, r->second[0] + dx, r->second[1] + dy,
+                      r->second[2], r->second[3], ppu);
+    }
+  };
+  if (status) {
+    if (focus >= 0 && focus < int(profiles.size())) {
+      const SiProfile& p = profiles[focus];
+      text("st_l1", p.gamertag);
+      text("st_l2", p.live);
+      text("st_l3", p.device);
+      picture("st_img", picture_of(p.xuid));
+    }
+    return true;
+  }
+  const int visible = std::max(1, int(sn_list_[4]));
+  for (int i = top; i < int(profiles.size()) && i < top + visible; ++i) {
+    const float x = sn_list_[0], y = sn_list_[1] + (i - top) * sn_list_[3];
+    const std::string state = i == focus ? "focus" : "normal";
+    auto img = scaled_.find("si_row_" + state);
+    if (img != scaled_.end()) {
+      const Pixels& p = img->second;
+      const int ox0 = int(std::lround(x * ppu)), oy0 = int(std::lround(y * ppu));
+      for (int yy = 0; yy < p.height; ++yy) {
+        int oy = oy0 + yy;
+        if (oy < 0 || oy >= out.height) continue;
+        for (int xx = 0; xx < p.width; ++xx) {
+          int ox = ox0 + xx;
+          if (ox < 0 || ox >= out.width) continue;
+          const uint8_t* c = &p.rgba[(size_t(yy) * p.width + xx) * 4];
+          BlendPixel(&out.rgba[(size_t(oy) * out.width + ox) * 4],
+                     c[0] / 255.0f, c[1] / 255.0f, c[2] / 255.0f,
+                     c[3] / 255.0f);
+        }
+      }
+    }
+    const SiProfile& p = profiles[i];
+    const std::string key = "row_" + state + "_";
+    text(key + "l1", p.gamertag, x, y);
+    text(key + "l2", p.live, x, y);
+    text(key + "l3", p.device, x, y);
+    picture(key + "img", picture_of(p.xuid), x, y);
+  }
+  return true;
 }
 
