+X_RESULT KernelState::ApplySystemUpdate(const object_ref<UserModule> module,
+                                        uint32_t update_title_id) {
+  const auto updates = FindTitleUpdate(update_title_id);
+  if (updates.empty()) {
+    return X_STATUS_SUCCESS;
+  }
+  auto patch_module = LoadTitleUpdate(&updates.front(), module);
+  if (!patch_module || !patch_module->xex_module()->is_patch()) {
+    return X_STATUS_SUCCESS;
+  }
+  if (!IsPatchSignatureProper(module, patch_module)) {
+    XELOGW("Skipping system update for {}: made for a different base",
+           module->name());
+    return X_STATUS_SUCCESS;
+  }
+  return ApplyTitleUpdate(module, patch_module);
+}
+
 X_RESULT KernelState::ApplyTitleUpdate(
     const object_ref<UserModule> title_module) {
   const auto title_updates = FindTitleUpdate(title_module->title_id());
