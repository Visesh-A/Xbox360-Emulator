+  if (cvars::debug_stack_dump_ms > 0) {
+    std::thread([this]() {
+      struct QuietListener : cpu::DebugListener {
+        void OnFocus() override {}
+        void OnDetached() override {}
+        void OnExecutionPaused() override {}
+        void OnExecutionContinued() override {}
+        void OnExecutionEnded() override {}
+        void OnStepCompleted(cpu::ThreadDebugInfo*) override {}
+        void OnBreakpointHit(cpu::Breakpoint*, cpu::ThreadDebugInfo*) override {}
+      };
+      static QuietListener listener;
+      std::this_thread::sleep_for(
+          std::chrono::milliseconds(cvars::debug_stack_dump_ms));
+      auto* cpu = processor();
+      cpu->set_debug_listener(&listener);
+      for (int sample = 0; sample < 3; ++sample) {
+      if (sample) std::this_thread::sleep_for(std::chrono::seconds(1));
+      cpu->Pause();
+      XELOGI("Stack dump: sample {}", sample);
+      for (auto* info : cpu->QueryThreadDebugInfos()) {
+        if (info->state == cpu::ThreadDebugInfo::State::kZombie ||
+            info->state == cpu::ThreadDebugInfo::State::kExited) {
+          continue;
+        }
+        XELOGI("Stack dump: thread {:X} state {} lr {:08X}", info->thread_id,
+               int(info->state), uint32_t(info->guest_context.lr));
+        auto& g = info->guest_context;
+        for (int r = 0; r < 32; r += 8) {
+          XELOGI("Stack dump:  r{:<2} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} "
+                 "{:08X} {:08X}",
+                 r, uint32_t(g.r[r]), uint32_t(g.r[r + 1]), uint32_t(g.r[r + 2]),
+                 uint32_t(g.r[r + 3]), uint32_t(g.r[r + 4]),
+                 uint32_t(g.r[r + 5]), uint32_t(g.r[r + 6]),
+                 uint32_t(g.r[r + 7]));
+        }
+        // 64 bytes at every register that points into guest memory
+        for (int r = 0; r < 32; ++r) {
+          uint32_t a = uint32_t(g.r[r]);
+          if (a < 0x40000000 || a >= 0xA0000000) continue;
+          auto* heap = memory()->LookupHeap(a);
+          uint32_t protect = 0, protect_end = 0;
+          if (!heap || !heap->QueryProtect(a, &protect) ||
+              !heap->QueryProtect(a + 63, &protect_end) ||
+              !(protect & kMemoryProtectRead) ||
+              !(protect_end & kMemoryProtectRead)) {
+            continue;
+          }
+          auto* m = memory()->TranslateVirtual<uint8_t*>(a);
+          std::string hex;
+          for (int i = 0; i < 64; i += 4) {
+            hex += fmt::format(" {:08X}", xe::load_and_swap<uint32_t>(m + i));
+          }
+          XELOGI("Stack dump:  [r{}={:08X}]{}", r, a, hex);
+        }
+        for (auto& frame : info->frames) {
+          if (frame.guest_pc) {
+            XELOGI("Stack dump:    {:08X} in function {:08X}", frame.guest_pc,
+                   frame.guest_function_address);
+          }
+        }
+      }
+      cpu->Continue();
+      }
+    }).detach();
+  }
+
   XELOGI("Loading module {}", module_path);
   auto module = kernel_state_->LoadUserModule(module_path);
   if (!module) {
