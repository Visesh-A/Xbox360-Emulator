+// XUI keyframe easing (Interpolation 2), as xam computes it: the key's
+// EaseIn / EaseOut / EaseScale (signed bytes) give a cubic Bezier from 0 to 1
+// whose control points are (EaseScale/100, 0) turned by (1 - EaseIn/100) pi/4
+// and (1, 1) - (EaseScale/100, 0) turned by (1 - EaseOut/100) pi/4
+// (8191E1A0); the timeline then uses only its y at the linear progress u
+// (8190EA40): 3 P1 (1-u)^2 u + 3 P2 (1-u) u^2 + u^3.
+float XuiEase(float u, float ease_in, float ease_out, float ease_scale) {
+  constexpr float kQuarterPi = 0.78539816f;
+  const float s = ease_scale * 0.01f;
+  const float p1 = s * std::sin((1.0f - ease_in * 0.01f) * kQuarterPi);
+  const float p2 = 1.0f - s * std::sin((1.0f - ease_out * 0.01f) * kQuarterPi);
+  const float v = 1.0f - u;
+  return 3.0f * p1 * v * v * u + 3.0f * p2 * v * u * u + u * u * u;
+}
+// hudbkgnd's keys: EaseIn 100 (slow start), EaseOut 100 (slow end), or both,
+// always with EaseScale 50.
+float EaseIn(float u) { return XuiEase(u, 100.0f, 0.0f, 50.0f); }
+float EaseOut(float u) { return XuiEase(u, 0.0f, 100.0f, 50.0f); }
+float EaseInOut(float u) { return XuiEase(u, 100.0f, 100.0f, 50.0f); }
 }  // namespace
 
