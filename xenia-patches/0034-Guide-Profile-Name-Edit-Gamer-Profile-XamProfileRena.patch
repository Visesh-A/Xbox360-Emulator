+// Profile Name's Done (mutex_ held): 90106750 accepts the gamertag as it is,
+// else 90115580 checks the text as typed (no spaces taken out) with
+// LiveProfile's messages; a failure is XamShowMessageBox(the keyboard's
+// title, the message, {OK}) and the keyboard again (90118DF0). Accepted:
+// 90107090, XamProfileRenameAccount, back to Edit Gamer Profile.
+void GuideOverlay::RenameSubmit() {
+  auto* profiles = emulator_->kernel_state()->xam_state()->profile_manager();
+  const auto* account = profiles->GetAccount(gp_xuid_);
+  const std::u16string name = kbd_text_;
+  const std::u16string current =
+      account ? xe::to_utf16(account->GetGamertagString()) : u"";
+  std::u16string error;
+  if (name != current) {
+    if (name.empty()) {
+      error = profile_strings_["err_empty"];
+    } else if (!IsLetter(name[0])) {
+      error = profile_strings_["err_letter"];
+    } else {
+      bool prev_space = false;
+      for (size_t i = 1; i < name.size() && error.empty(); ++i) {
+        char16_t c = name[i];
+        if (c == u' ') {
+          if (prev_space) error = profile_strings_["err_spaces"];
+          prev_space = true;
+        } else if (IsLetter(c) || IsDigit(c)) {
+          prev_space = false;
+        } else {
+          error = profile_strings_["err_chars"];
+        }
+      }
+      if (error.empty() && name.back() == u' ') {
+        error = profile_strings_["err_end"];
+      }
+      if (error.empty()) {
+        // 901151E8: another profile with this name
+        for (const auto& [xuid, other] : *profiles->GetAccounts()) {
+          if (xuid != gp_xuid_ &&
+              xe::utf8::equal_case(other.GetGamertagString(),
+                                   xe::to_utf8(name))) {
+            std::u16string text = profile_strings_["err_dup"];
+            size_t at = text.find(u"%s");
+            if (at != std::u16string::npos) text.replace(at, 2, name);
+            error = text;
+            break;
+          }
+        }
+      }
+    }
+  }
+  if (!error.empty()) {
+    kernel::xam::TitleMessageBox box;
+    box.title = gp_strings_["editname"];
+    box.text = error;
+    box.buttons = {profile_strings_["ok"]};
+    box.icon = 1;  // XamShowMessageBox flags 1 (90118EB8)
+    ShowProfileBox(box, Page::kKeyboard);
+    OpenKeyboard(kbd_text_);
+    page_ = Page::kProfileError;
+    return;
+  }
+  if (name != current) {
+    profiles->RenameProfile(gp_xuid_, name);
+  }
+  kbd_rename_ = false;
+  if (!gp_back_.empty()) {
+    page_ = gp_back_.back().first;
+    gp_focus_ = gp_back_.back().second;
+    gp_back_.pop_back();
+  }
+  ++page_version_;
+}
