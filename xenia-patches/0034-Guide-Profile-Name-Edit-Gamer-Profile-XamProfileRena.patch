+// gamerprofile 90107090 (Edit Gamer Profile's Profile Name): the signed-in
+// profile's XUID and its new gamertag.
+dword_result_t XamProfileRenameAccount_entry(qword_t xuid,
+                                             lpu16string_t gamertag) {
+  auto* profile_manager = kernel_state()->xam_state()->profile_manager();
+  if (!gamertag || !profile_manager->GetAccount(xuid)) {
+    return X_E_INVALIDARG;
+  }
+  return profile_manager->RenameProfile(xuid, gamertag.value())
+             ? X_ERROR_SUCCESS
+             : X_E_FAIL;
+}
+DECLARE_XAM_EXPORT1(XamProfileRenameAccount, kNone, kImplemented);
