+bool ProfileManager::RenameProfile(const uint64_t xuid,
+                                   const std::u16string& gamertag) {
+  if (!accounts_.count(xuid)) {
+    return false;
+  }
+  X_XAMACCOUNTINFO account = accounts_[xuid];
+  std::memset(account.gamertag, 0, sizeof(account.gamertag));
+  string_util::copy_and_swap_truncating(account.gamertag, gamertag,
+                                        sizeof(account.gamertag));
+  const uint8_t user_index = GetUserIndexAssignedToProfile(xuid);
+  const bool signed_in = user_index < XUserMaxUserCount;
+  // the Account file is in the profile's package, mounted while signed in
+  if (!signed_in && !MountProfile(xuid)) {
+    return false;
+  }
+  const bool result = UpdateAccount(xuid, &account);
+  if (!signed_in) {
+    DismountProfile(xuid);
+  }
+  if (!result) {
+    return false;
+  }
+  accounts_[xuid] = account;
+  if (signed_in) {
+    logged_profiles_.at(user_index)->SetAccountInfo(account);
+  }
+  XELOGI("Profile {:016X} renamed to {}", xuid, account.GetGamertagString());
+  return true;
+}
