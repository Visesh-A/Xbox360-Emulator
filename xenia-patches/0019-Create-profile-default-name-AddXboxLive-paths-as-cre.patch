+bool GuideOverlay::SaveProfile() {
+  std::string name;
+  uint32_t user_index;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (created_xuid_) {
+      return true;  // saved on an earlier pass (90103768: +0x98 set)
+    }
+    name = xe::to_utf8(kbd_text_);
+    user_index = create_user_index_;
+  }
+  auto* profiles = emulator_->kernel_state()->xam_state()->profile_manager();
+  if (!profiles->CreateProfile(name, false, false)) {
+    XELOGE("Guide: profile \"{}\" NOT created", name);
+    return false;
+  }
+  uint64_t xuid = 0;
+  for (const auto& [id, account] : *profiles->GetAccounts()) {
+    if (account.GetGamertagString() == name) {
+      xuid = id;
+    }
+  }
+  // 90103530 -> 90102820: XamUserLogon with the new profile on the
+  // controller that created it, in place of whoever was signed in there.
+  if (xuid) {
+    uint8_t slot = user_index < 4 ? uint8_t(user_index) : XUserIndexAny;
+    if (slot != XUserIndexAny) {
+      profiles->Logout(slot, false);
+    }
+    profiles->Login(xuid, slot);
+  }
+  XELOGI("Guide: profile \"{}\" created, signed in on controller {}", name,
+         user_index);
+  std::lock_guard<std::mutex> lock(mutex_);
+  created_xuid_ = xuid ? xuid : 1;
+  return true;
+}
