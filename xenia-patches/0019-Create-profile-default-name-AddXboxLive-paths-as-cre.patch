+void GuideOverlay::JoinXboxLive() {
+  using kernel::xam::TitleMessageBox;
+  auto back = [this](int) {
+    // 90102CE8: XuiSceneNavigateBack, to Save Gamer Profile
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      profile_box_return_ = Page::kSaveProfile;
+    }
+    DismissMessageBox();
+  };
+  // 901028F8: network status; offline, 901030D8 "Can't Connect".
+  auto cant_connect = [this, back]() {
+    TitleMessageBox box;
     box.title = profile_strings_["cant_title"];
     box.text = profile_strings_["cant_text"];
     box.buttons = {profile_strings_["test"], profile_strings_["cancel"]};
     box.focus = 0;
     box.icon = 1;  // XamShowMessageBox flags 1
-    ShowProfileBox(box, Page::kSaveProfile);
-    lock.unlock();
-    PlaySfx("btn_Select");
+    return std::make_pair(box, std::function<void(int)>([this, back](int c) {
+      if (c != 0) {
+        back(c);  // Cancel / B
+        return;
+      }
+      // Test Connection (90102E60): "Exit Session", [Yes, No], No focused.
+      TitleMessageBox exit;
+      exit.title = profile_strings_["exit_title"];
+      exit.text = profile_strings_["exit_text"];
+      exit.buttons = {profile_strings_["yes"], profile_strings_["no"]};
+      exit.focus = 1;
+      exit.icon = 3;  // flags 3
+      QueueProfileBox(exit, Page::kSaveProfile, [this, back](int e) {
+        if (e != 0) {
+          back(e);
+          return;
+        }
+        // 90102AD8: the dashboard again with launch data 2 (its network
+        // test), which is not available here.
+        XELOGW("Guide: the dashboard's connection test is not available");
+        EndCreateProfile();
+      });
+      DismissMessageBox();
+    }));
+  };
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (cvars::retail_flags & 0x4) {
+    auto [box, done] = cant_connect();
+    ShowProfileBox(box, Page::kSaveProfile, done);
     return;
   }
-  std::string name = xe::to_utf8(kbd_text_);
-  lock.unlock();
-  PlaySfx("btn_Select");
-  auto* profiles = emulator_->kernel_state()->xam_state()->profile_manager();
-  // Signed in when nobody else is.
-  bool autologin = !profiles->IsAnyProfileSignedIn();
-  bool created = profiles->CreateProfile(name, autologin, false);
-  XELOGI("Guide: profile \"{}\" {}", name, created ? "created" : "NOT created");
-  EndCreateProfile();
+  // 90102D78: XCONFIG_USER_RETAIL_FLAGS without 0x4: asked first.
+  TitleMessageBox ask;
+  ask.title = profile_strings_["live_title"];
+  ask.text = profile_strings_["live_text"];
+  ask.buttons = {profile_strings_["live_yes"], profile_strings_["live_no"]};
+  ask.focus = 0;
+  ask.icon = 1;  // flags 1
+  ShowProfileBox(ask, Page::kSaveProfile, [this, back, cant_connect](int c) {
+    if (c != 0) {
+      back(c);  // No, not now / B
+      return;
+    }
+    kernel::xboxkrnl::SetRetailFlags(cvars::retail_flags | 0x4);
+    auto [box, done] = cant_connect();
+    QueueProfileBox(box, Page::kSaveProfile, done);
+    DismissMessageBox();
+  });
 }
 
