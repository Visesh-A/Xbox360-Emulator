   // Let the select sound play briefly, then leave like a title exit.
   // Keep what was changed while running, e.g. the profile signed in on
   // the dashboard, as closing the window normally would.
@@ -2677,11 +2690,32 @@ void GuideOverlay::JoinXboxLive(uint64_t run) {
                   back(e);
                   return;
                 }
-                // 90102AD8: the dashboard again with launch data 2 (its
-                // network test), which is not available here.
-                XELOGW(
-                    "Guide: the dashboard's connection test is not available");
-                EndCreateProfile();
+                // 90102AD8 -> 90102088: XamLoaderSetLaunchData (0x3FC bytes:
+                // +4 = 2, +8 = the user index), then XamLoaderLaunchTitleEx
+                // (NULL, NULL, NULL, 0): the dashboard again (xam request
+                // type 8), for its network test.
+                std::vector<uint8_t> data(0x3FC, 0);
+                uint32_t user_index;
+                {
+                  std::lock_guard<std::mutex> lock(mutex_);
+                  user_index = create_user_index_;
+                }
+                xe::store_and_swap<uint32_t>(data.data() + 4, 2);
+                xe::store_and_swap<uint32_t>(data.data() + 8, user_index);
+                auto xam = emulator_->kernel_state()
+                                ->GetKernelModule<kernel::xam::XamModule>(
+                                    "xam.xex");
+                xam->loader_data().launch_data = std::move(data);
+                xam->loader_data().launch_data_present = true;
+                // The disc stays in the drive when it is the dashboard
+                // relaunching (the launcher only empties it after a game).
+                std::string request;
+                auto disc = emulator_->disc_path();
+                if (DashboardIsRunning() && !disc.empty()) {
+                  request = "|" + xe::path_to_utf8(disc);
+                }
+                XELOGI("Guide: Exit Session, the dashboard with launch data 2");
+                HandOff(request);
               },
               false);
         });
