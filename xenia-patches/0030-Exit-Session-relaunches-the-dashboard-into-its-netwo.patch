   if (cvars::dashboard_handoff) {
-    // The dashboard's disc tile passes no path: boot whatever is in the drive,
-    // telling the launcher which disc image that is ("<path>|<image>").
+    // No path (xam 818C3228): flag 0x2 boots the disc in the drive (request
+    // type 1; the dashboard's disc tile passes 0x12), otherwise the
+    // dashboard itself (type 8; e.g. createprofile's Exit Session, 90102088).
+    // The launcher is told which disc image is in the drive ("<path>|<image>")
