   }
+  // XamLoaderSetLaunchData's data goes to the next title
+  auto xam =
+      emulator_->kernel_state()->GetKernelModule<kernel::xam::XamModule>(
+          "xam.xex");
+  const auto& launch_data = xam->loader_data().launch_data;
+  if (!launch_data.empty()) {
+    if (FILE* file = xe::filesystem::OpenFile(
+            kernel::xam::kHandoffLaunchDataFileName, "wb")) {
+      fwrite(launch_data.data(), 1, launch_data.size(), file);
+      fclose(file);
+    }
