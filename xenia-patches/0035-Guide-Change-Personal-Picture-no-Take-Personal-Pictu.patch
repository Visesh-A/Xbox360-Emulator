diff --git a/src/xenia/kernel/xam/xam_user.cc b/src/xenia/kernel/xam/xam_user.cc
index 6d30f544b..8068843fa 100644
--- a/src/xenia/kernel/xam/xam_user.cc
+++ b/src/xenia/kernel/xam/xam_user.cc
@@ -940,6 +940,26 @@ X_RESULT WriteGamerPicture(uint64_t xuid, uint32_t title_id, uint32_t big_id,
   return X_ERROR_SUCCESS;
 }
 
+// The personal picture (XamWriteGamerTileEx type 2, gamerprofile 90105990):
+// its key, the gamercard's personal picture setting.
+X_RESULT WritePersonalPicture(uint64_t xuid, uint32_t title_id,
+                              uint32_t big_id, uint32_t small_id) {
+  if (!kernel_state()->xam_state()->GetUserProfile(xuid)) {
+    return X_ERROR_NO_SUCH_USER;
+  }
+  const UserSetting setting(
+      UserSettingId::XPROFILE_GAMERCARD_PERSONAL_PICTURE,
+      xe::string_util::read_u16string_and_swap(
+          xe::to_utf16(fmt::format("{:08X}{:08X}{:08X}", title_id, big_id,
+                                   small_id))
+              .c_str()));
+  kernel_state()->xam_state()->user_tracker()->UpsertSetting(
+      xuid, kDashboardID, &setting);
+  XELOGI("Personal picture {:08x}{:08x}{:08x} written for {:016X}", title_id,
+         big_id, small_id, xuid);
+  return X_ERROR_SUCCESS;
+}
+
 // As createprofile calls it (90108970): (user index, title, big tile id,
 // small tile id, 0, overlapped); xam stores the picture's two sizes in the
 // profile and sets its gamercard picture key.
