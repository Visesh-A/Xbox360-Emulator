+// hud action 5 (91447EA8): XamAppLoad("minimediaplayer.xex", user). Its
+// first scene is full width, so the Guide goes HalfToFull.
+void GuideOverlay::MusicOpen() {
+  opt_user_ = hud_user_;
+  opt_back_.clear();
+  opt_fading_ = false;
+  opt_fade_capture_ = false;
+  page_ = Page::kMus579;
+  opt_focus_ = OptFirstFocus(Page::kMus579);
+  transition_ = Transition::kHalfToFull;
+  transition_start_ = Clock::now();
+  ++page_version_;
+}
+
+// The app's running flag cleared (901022E0): it unloads and the Guide is
+// back on hud's menu, on Select Music (FullToHalf).
+void GuideOverlay::MusicClose() {
+  opt_back_.clear();
+  opt_fading_ = false;
+  opt_fade_capture_ = false;
+  page_ = Page::kMenu;
+  const auto& menu = menu_signed_in_ ? layout_.menu_si : layout_.menu;
+  for (size_t i = 0; i < menu.size(); ++i) {
+    if (menu[i].id == "btnPlaylist") focus_ = int(i);
+  }
+  transition_ = Transition::kFullToHalf;
+  transition_start_ = Clock::now();
+  ++page_version_;
+  PlaySfx("HUD_close");  // hudbkgnd FullToHalf, frame 120
+}
+
+// BeginPlayback (90107A20): its query of the library finds no songs, so the
+// timer (50 ms, 90108A60 -> 90108458) ends it and the app unloads.
+void GuideOverlay::MusicPlayEmpty() {
+  Schedule(Clock::now() + std::chrono::milliseconds(50), [this]() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (page_ == Page::kMusPlay) MusicClose();
+  });
+}
+
+// X: Music Sources' "Return Control to Game" (90104798: the title's own
+// music back, then the app unloads); the other scenes' "Xbox Guide" (the
+// app unloads).
+void GuideOverlay::OptX() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!IsMusicPage(page_) || opt_fading_) return;
+  MusicClose();
+}
+
+// Y: "Play All Music" on Music Sources (a source row focused) and on the
+// Music Library; cleared on the empty category lists.
+void GuideOverlay::OptY() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (opt_fading_) return;
+    if (!(page_ == Page::kMus579 && opt_focus_ == "listSources") &&
+        page_ != Page::kMus570) {
+      return;
+    }
+    OptGoTo(Page::kMusPlay);
+  }
+  MusicPlayEmpty();
+}
+
 }  // namespace app
