+void WinKeyInputDriver::CaptureMouse(bool capture) {
+  if (capture == mouse_captured_) {
+    return;
+  }
+  auto* win32 = static_cast<ui::Win32Window*>(window());
+  if (capture) {
+    RECT rect;
+    GetClientRect(win32->hwnd(), &rect);
+    POINT corners[2] = {{rect.left, rect.top}, {rect.right, rect.bottom}};
+    MapWindowPoints(win32->hwnd(), nullptr, corners, 2);
+    RECT screen = {corners[0].x, corners[0].y, corners[1].x, corners[1].y};
+    ClipCursor(&screen);
+    SetCursorPos((screen.left + screen.right) / 2,
+                 (screen.top + screen.bottom) / 2);
+    while (ShowCursor(FALSE) >= 0) {
+    }
+    mouse_acc_x_ = mouse_acc_y_ = 0;
+    mouse_stick_x_ = mouse_stick_y_ = 0;
+    mouse_updated_ = std::chrono::steady_clock::now();
+  } else {
+    ClipCursor(nullptr);
+    while (ShowCursor(TRUE) < 0) {
+    }
+  }
+  mouse_captured_ = capture;
+  XELOGI("winkey: mouse {}", capture ? "captured (aim)" : "released");
+}
