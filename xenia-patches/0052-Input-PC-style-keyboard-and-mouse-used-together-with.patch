+// Mouse speed (pixels per second, over at least 8 ms) as the stick's
+// deflection: a look rate, like a stick held over. The cursor goes back to
+// the window's centre each time.
+void WinKeyInputDriver::UpdateMouse(int16_t& thumb_rx, int16_t& thumb_ry) {
+  auto* win32 = static_cast<ui::Win32Window*>(window());
+  RECT rect;
+  GetClientRect(win32->hwnd(), &rect);
+  POINT center = {(rect.left + rect.right) / 2, (rect.top + rect.bottom) / 2};
+  ClientToScreen(win32->hwnd(), &center);
+  POINT cursor;
+  if (GetCursorPos(&cursor)) {
+    mouse_acc_x_ += cursor.x - center.x;
+    mouse_acc_y_ += cursor.y - center.y;
+    if (cursor.x != center.x || cursor.y != center.y) {
+      SetCursorPos(center.x, center.y);
+    }
+  }
+  const auto now = std::chrono::steady_clock::now();
+  const double seconds =
+      std::chrono::duration<double>(now - mouse_updated_).count();
+  if (seconds >= 0.008) {
+    const double full = 600.0 / std::max(0.01, cvars::mouse_sensitivity);
+    double x = mouse_acc_x_ / seconds / full;
+    double y = -mouse_acc_y_ / seconds / full;
+    if (cvars::mouse_invert_y) {
+      y = -y;
+    }
+    const double length = std::sqrt(x * x + y * y);
+    if (length > 0.0001) {
+      // past the game's dead zone at once, full at length 1
+      const double offset = std::clamp(cvars::mouse_deadzone_offset, 0.0, 0.9);
+      const double scaled =
+          std::min(1.0, offset + (1.0 - offset) * std::min(1.0, length));
+      x = x / length * scaled;
+      y = y / length * scaled;
+    }
+    // a little smoothing: mouse reports arrive unevenly between polls
+    mouse_stick_x_ = 0.5 * mouse_stick_x_ + 0.5 * x;
+    mouse_stick_y_ = 0.5 * mouse_stick_y_ + 0.5 * y;
+    if (length <= 0.0001 && std::abs(mouse_stick_x_) < 0.02 &&
+        std::abs(mouse_stick_y_) < 0.02) {
+      mouse_stick_x_ = mouse_stick_y_ = 0;
+    }
+    mouse_acc_x_ = mouse_acc_y_ = 0;
+    mouse_updated_ = now;
+  }
+  auto add = [](int16_t& axis, double value) {
+    axis = int16_t(std::clamp(axis + value * 32767.0, -32768.0, 32767.0));
+  };
+  add(thumb_rx, mouse_stick_x_);
+  add(thumb_ry, mouse_stick_y_);
 }
 
