+bool GuideOverlay::ComposeGamerProfilePage(Page page, float ppu, Pixels& out) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  const std::string focus = gp_focus_;
+  const int cell = gp_cell_;
+  const uint64_t xuid = gp_xuid_;
+  lock.unlock();
+  const std::string key = GpKey(page);
+  const GpPage& layout = gp_pages_[key];
+  // the gamer card's data, as xam's gamercard control shows it (819B6B20):
+  // gamertag, gamerscore, games played, achievements earned
+  auto* state = emulator_->kernel_state()->xam_state();
+  auto user = state->GetUserProfile(xuid);
+  std::u16string gamertag;
+  int32_t cred = 0, titles = 0, achievements = 0;
+  std::u16string last_title;
+  Pixels own_picture;
+  if (user) {
+    gamertag = xe::to_utf16(user->name());
+    auto* tracker = state->user_tracker();
+    auto value = [&](kernel::xam::UserSettingId id) {
+      auto setting = tracker->GetSetting(user, kernel::kDashboardID,
+                                         uint32_t(id));
+      if (!setting) return int32_t(0);
+      auto data = setting->get_host_data();
+      if (auto* v = std::get_if<int32_t>(&data)) return *v;
+      if (auto* u = std::get_if<uint32_t>(&data)) return int32_t(*u);
+      return int32_t(0);
+    };
+    cred = value(kernel::xam::UserSettingId::XPROFILE_GAMERCARD_CRED);
+    titles = value(kernel::xam::UserSettingId::XPROFILE_GAMERCARD_TITLES_PLAYED);
+    achievements = value(
+        kernel::xam::UserSettingId::XPROFILE_GAMERCARD_ACHIEVEMENTS_EARNED);
+    // the extended panel's title: the most recently played game
+    auto played = tracker->GetPlayedTitles(xuid);
+    const kernel::xam::TitleInfo* last = nullptr;
+    for (const auto& t : played) {
+      if (!last || t.last_played > last->last_played) last = &t;
+    }
+    if (last) last_title = last->title_name;
+    auto icon = tracker->GetIcon(xuid, 0, kernel::xam::XTileType::kGamerTile, 0);
+    int channels;
+    if (!icon.empty()) {
+      if (uint8_t* rgba = stbi_load_from_memory(
+              icon.data(), int(icon.size()), &own_picture.width,
+              &own_picture.height, &channels, STBI_rgb_alpha)) {
+        own_picture.rgba.assign(
+            rgba, rgba + size_t(own_picture.width) * own_picture.height * 4);
+        stbi_image_free(rgba);
+      }
+    }
+  }
+  std::lock_guard<std::mutex> images_lock(prepare_mutex_);
+  if (!scaled_ready_ || scaled_ppu_ != ppu) {
+    return false;
+  }
+  auto base = scaled_.find(page == Page::kGpPics ? key : key + "_" + focus);
+  if (base == scaled_.end()) return false;
+  out = base->second;
+  auto text = [&](const char* name, const std::u16string& value) {
+    auto it = layout.texts.find(name);
+    if (it != layout.texts.end()) RenderText(out, it->second, value, ppu);
+  };
+  text("gamertag", gamertag);
+  text("cred", xe::to_utf16(std::to_string(cred)));
+  text("titles", xe::to_utf16(std::to_string(titles)));
+  text("achievements", xe::to_utf16(std::to_string(achievements)));
+  text("ext_title", last_title);
+  text("autosignin",
+       gp_strings_[cvars::default_profile_xuid == xuid && xuid ? "disable"
+                                                                : "enable"]);
+  // the card's picture: on Change Gamer Picture the focused item's (its
+  // focus change sets it on the card, 901056C8), else the profile's own
+  const Pixels* picture = own_picture.rgba.empty() ? nullptr : &own_picture;
+  if (page == Page::kGpPics) picture = GamerPicture(cell + 1);
+  auto tile = layout.images.find("tile");
+  if (picture && tile != layout.images.end()) {
+    const auto& r = tile->second;
+    DrawPictureInto(out, *picture, r[0], r[1], r[2], r[3], ppu);
+  }
+  if (page == Page::kGpPics) {
+    const float x0 = gp_cells_[0], y0 = gp_cells_[1], dx = gp_cells_[2],
+                dy = gp_cells_[3];
+    const int cols = int(gp_cells_[4]), count = int(gp_cells_[5]);
+    auto normal = scaled_.find("gp_cell_normal");
+    auto focused = scaled_.find("gp_cell_focus");
+    for (int i = 0; i < count; ++i) {
+      const float x = x0 + (i % cols) * dx, y = y0 + (i / cols) * dy;
+      auto img = i == cell ? focused : normal;
+      if (img != scaled_.end()) {
+        const Pixels& c = img->second;
+        const int ox0 = int(std::lround(x * ppu)), oy0 = int(std::lround(y * ppu));
+        for (int yy = 0; yy < c.height; ++yy) {
+          int oy = oy0 + yy;
+          if (oy < 0 || oy >= out.height) continue;
+          for (int xx = 0; xx < c.width; ++xx) {
+            int ox = ox0 + xx;
+            if (ox < 0 || ox >= out.width) continue;
+            const uint8_t* p = &c.rgba[(size_t(yy) * c.width + xx) * 4];
+            BlendPixel(&out.rgba[(size_t(oy) * out.width + ox) * 4],
+                       p[0] / 255.0f, p[1] / 255.0f, p[2] / 255.0f,
+                       p[3] / 255.0f);
+          }
+        }
+      }
+      if (const Pixels* pic = GamerPicture(i + 1)) {
+        DrawPictureInto(out, *pic, x + gp_cells_[6], y + gp_cells_[7], 64.0f,
+                        64.0f, ppu);
+      }
+    }
+  }
+  return true;
+}
