+void GuideOverlay::LoadGamerProfileLayout() {
+  std::ifstream in(asset_dir_ / "gamerprofile.txt");
+  std::string line;
+  while (std::getline(in, line)) {
+    std::istringstream ls(line);
+    std::string kind, page, name;
+    ls >> kind;
+    if (kind == "page") {
+      ls >> page;
+      ls >> gp_pages_[page].default_focus;
+    } else if (kind == "text") {
+      std::string color;
+      ls >> page >> name;
+      MessageBoxItem item;
+      item.is_text = true;
+      ls >> item.x >> item.y >> item.w >> item.h >> item.size >> item.ascent >>
+          item.line_h >> item.style >> color;
+      item.color = uint32_t(std::stoul(color, nullptr, 16));
+      gp_pages_[page].texts[name] = item;
+    } else if (kind == "image") {
+      std::array<float, 4> r;
+      ls >> page >> name >> r[0] >> r[1] >> r[2] >> r[3];
+      gp_pages_[page].images[name] = r;
+    } else if (kind == "button") {
+      SaveButton b;
+      ls >> page >> b.id >> b.up >> b.down;
+      if (b.up == "-") b.up.clear();
+      if (b.down == "-") b.down.clear();
+      gp_pages_[page].buttons.push_back(b);
+    } else if (kind == "cells") {
+      for (float& v : gp_cells_) ls >> v;
+    }
+  }
+  std::ifstream strings(asset_dir_ / "gamerprofile_strings.txt",
+                        std::ios::binary);
+  while (std::getline(strings, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    size_t space = line.find(' ');
+    if (space != std::string::npos) {
+      gp_strings_[line.substr(0, space)] = Unescape(line.substr(space + 1));
+    }
+  }
+  gp_ready_ = gp_pages_.size() == 4 && gp_cells_[4] > 0;
+  if (!gp_ready_) {
+    XELOGW("Guide: gamerprofile assets missing (gamerprofile.txt)");
+  }
+}
