+void GuideOverlay::GpGoTo(Page page) {
+  // XuiSceneNavigateForward to another full-width scene: the frame stays.
+  gp_back_.push_back({page_, gp_focus_});
+  page_ = page;
+  if (page == Page::kGpPics) {
+    gp_cell_ = 0;  // 90117CE0: the list selects its first item
+    gp_focus_.clear();
+  } else {
+    gp_focus_ = gp_pages_[GpKey(page)].default_focus;
+  }
+  ++page_version_;
+}
+
+void GuideOverlay::GpMove(Direction direction) {
+  if (page_ == Page::kGpPics) {
+    // the list's grid, 3 columns of 12 items
+    const int cols = int(gp_cells_[4]), count = int(gp_cells_[5]);
+    int next = gp_cell_;
+    if (direction == kLeft && gp_cell_ % cols > 0) next = gp_cell_ - 1;
+    if (direction == kRight && gp_cell_ % cols < cols - 1 &&
+        gp_cell_ + 1 < count)
+      next = gp_cell_ + 1;
+    if (direction == kUp && gp_cell_ - cols >= 0) next = gp_cell_ - cols;
+    if (direction == kDown && gp_cell_ + cols < count) next = gp_cell_ + cols;
+    if (next == gp_cell_) return;
+    gp_cell_ = next;
+  } else {
+    if (direction != kUp && direction != kDown) return;
+    std::string next;
+    for (const auto& b : gp_pages_[GpKey(page_)].buttons) {
+      if (b.id == gp_focus_) next = direction == kUp ? b.up : b.down;
+    }
+    if (next.empty()) return;
+    gp_focus_ = next;
+  }
+  ++page_version_;
+  PlaySfx("btn_Focus");
+}
