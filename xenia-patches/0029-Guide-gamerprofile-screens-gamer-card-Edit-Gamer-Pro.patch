+bool GuideOverlay::ShowGamerCard(uint32_t user_index) {
+  if (!gp_ready_ || !create_profile_ready_) {
+    return false;
+  }
+  auto user =
+      emulator_->kernel_state()->xam_state()->GetUserProfile(user_index);
+  if (!user) {
+    return false;
+  }
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode_ != Mode::kClosed || create_profile_active_ || gp_active_) {
+      return false;
+    }
+    gp_active_ = true;
+    gp_xuid_ = user->xuid();
+    gp_back_.clear();
+    gp_cell_ = 0;
+    gp_focus_ = gp_pages_["gpcard"].default_focus;
+    ++page_version_;
+  }
+  if (display_h_ > 0) {
+    float ppu = display_h_ / layout_.canvas_h;
+    if (scaling_for_ != ppu) {
+      scaling_for_ = ppu;
+      scaled_ready_ = false;
+      if (scale_thread_.joinable()) scale_thread_.join();
+      scale_thread_ =
+          std::thread([this, ppu]() { PrepareCreateProfileImages(ppu); });
+    }
+  }
+  emulator_->kernel_state()->BroadcastNotification(
+      xe::kXNotificationSystemUI, true);
+  XELOGI("Guide: gamer card (gamerprofile.xex, mode 0)");
+  Open(Page::kGpCard);  // GamerCardScene, full width (ClosedToFull)
+  return true;
+}
