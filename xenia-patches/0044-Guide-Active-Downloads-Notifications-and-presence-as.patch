@@ -528,8 +534,18 @@ void GuideOverlay::OptLoadValues(Page page) {
     }
   } else if (page == Page::kOptOnl) {
     // 9144A8B0: XamGetUserPresetPresenceState's state as the radio
+    // xam 818E8EA0: the sign-in slot's preset state, 0 until set (xam's user
+    // table +0x198; a Live logon clears it, 818EAD34). 0x4 Appear Offline;
+    // low bit with 0 / 0x10000 / 0x20000 Online / Away / Busy; else no
+    // radio is set.
     auto it = opt_presence_by_user_.find(user_index);
-    opt_presence_ = it != opt_presence_by_user_.end() ? it->second : 0;
