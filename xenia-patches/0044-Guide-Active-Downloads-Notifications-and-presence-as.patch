+    opt_presence_ = (s & 0x4)                            ? 3
+                    : !(s & 1)                           ? -1
+                    : (s & 0xF0000) == 0                 ? 0
+                    : (s & 0xF0000) == 0x10000           ? 1
+                    : (s & 0xF0000) == 0x20000           ? 2
