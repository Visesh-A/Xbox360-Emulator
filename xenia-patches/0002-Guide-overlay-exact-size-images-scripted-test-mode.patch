+// ------------------------------------------------------------------- input
+
+void GuideOverlay::InputThread() {
+  auto input_system = emulator_->input_system();
+  uint16_t prev = 0;
+  Clock::time_point guide_down, guide_up;
+  bool turn_off_shown = false;
+
+  // Debug schedule (--blades_guide_test): "<delay ms>,<page>[,black][,+button
+  // [*hold ms]]...", page "closed" to leave the Guide shut; the buttons are
+  // pressed one after another, 700 ms apart, from 1.5 s after the delay.
+  Clock::time_point test_at;
+  std::string test_page;
+  struct TestPress {
+    Clock::time_point down, up;
+    uint16_t button;
+  };
+  std::vector<TestPress> test_presses;
+  bool test_pending = !cvars::blades_guide_test.empty();
+  if (test_pending) {
+    std::stringstream spec(cvars::blades_guide_test);
+    std::string token;
+    std::getline(spec, token, ',');
+    test_at = Clock::now() + std::chrono::milliseconds(std::atoi(token.c_str()));
+    std::getline(spec, test_page);
+    const std::map<std::string, uint16_t> names = {
+        {"guide", hid::X_INPUT_GAMEPAD_GUIDE}, {"a", hid::X_INPUT_GAMEPAD_A},
+        {"b", hid::X_INPUT_GAMEPAD_B},         {"y", hid::X_INPUT_GAMEPAD_Y},
+        {"up", hid::X_INPUT_GAMEPAD_DPAD_UP},  {"down", hid::X_INPUT_GAMEPAD_DPAD_DOWN}};
+    auto at = test_at + std::chrono::milliseconds(1500);
+    std::stringstream rest(test_page);
+    while (std::getline(rest, token, ',')) {
+      if (token.empty() || token[0] != '+') {
+        continue;
+      }
+      size_t star = token.find('*');
+      auto it = names.find(token.substr(1, star == std::string::npos ? star : star - 1));
+      if (it == names.end()) {
+        continue;
+      }
+      int hold = star == std::string::npos ? 100 : std::atoi(token.c_str() + star + 1);
+      test_presses.push_back({at, at + std::chrono::milliseconds(hold), it->second});
+      at += std::chrono::milliseconds(hold + 700);
+    }
+  }
+
+  while (running_) {
+    if (test_pending && Clock::now() >= test_at) {
+      test_pending = false;
+      if (test_page.rfind("closed", 0) == 0) {
+        continue;
+      }
+      Open();
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (test_page.rfind("exit", 0) == 0 || test_page.rfind("off", 0) == 0) {
+        page_ = test_page[0] == 'e' ? Page::kExit : Page::kTurnOff;
+        choice_ = test_page.find("yes") != std::string::npos ? 0 : 1;
+      } else if (!test_page.empty()) {
+        focus_ = std::clamp(std::atoi(test_page.c_str()), 0, kMenuCount - 1);
+      }
+    }
+    uint16_t buttons = 0;
+    float ly = 0.0f;
+    if (input_system) {
+      auto lock = input_system->lock();
+      for (uint32_t user = 0; user < 4; ++user) {
+        hid::X_INPUT_STATE state = {};
+        if (input_system->GetState(user, hid::X_INPUT_FLAG::X_INPUT_FLAG_GAMEPAD,
+                                   &state) == X_ERROR_SUCCESS) {
+          buttons |= state.gamepad.buttons;
+          if (std::abs(int(state.gamepad.thumb_ly)) > std::abs(ly * 32767)) {
+            ly = state.gamepad.thumb_ly / 32767.0f;
+          }
+        }
+      }
+    }
+    auto now = Clock::now();
+    for (const TestPress& press : test_presses) {
+      if (now >= press.down && now < press.up) {
+        buttons |= press.button;
+      }
+    }
+    // A Guide release shorter than this is a glitch (e.g. the keyboard driver
+    // reporting nothing for a moment while the window changes focus), not a
+    // second press.
+    constexpr auto kMinRelease = std::chrono::milliseconds(80);
+    if (!(buttons & hid::X_INPUT_GAMEPAD_GUIDE)) {
+      if (prev & hid::X_INPUT_GAMEPAD_GUIDE) {
+        guide_up = now;
+      }
+    } else if (!(prev & hid::X_INPUT_GAMEPAD_GUIDE) &&
+               now - guide_up < kMinRelease) {
+      prev |= hid::X_INPUT_GAMEPAD_GUIDE;
+    }
+    uint16_t pressed = buttons & ~prev;
+    if (pressed & hid::X_INPUT_GAMEPAD_GUIDE) {
+      XELOGI("Guide: button pressed");
+    }
+
+    // Hold the Guide button to turn off the console (the Guide opens on the
+    // press, the prompt replaces it once the button has been held long enough).
+    if (pressed & hid::X_INPUT_GAMEPAD_GUIDE) {
+      guide_down = now;
+      turn_off_shown = false;
+    }
+    if ((buttons & hid::X_INPUT_GAMEPAD_GUIDE) && !turn_off_shown &&
+        now - guide_down >= kHoldToTurnOff) {
+      turn_off_shown = true;
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (mode_ == Mode::kOpen || mode_ == Mode::kOpening) {
+        page_ = Page::kTurnOff;
+        choice_ = 1;
+      }
+      pressed &= ~hid::X_INPUT_GAMEPAD_GUIDE;
+    }
+
+    OnButtons(pressed, buttons, ly, now);
+    prev = buttons;
+    std::this_thread::sleep_for(std::chrono::milliseconds(16));
+  }
+}
+
+void GuideOverlay::OnButtons(uint16_t pressed, uint16_t held, float ly,
+                             Clock::time_point now) {
+  static int repeat_dir = 0;
+  static Clock::time_point next_repeat;
+
+  if (pressed & hid::X_INPUT_GAMEPAD_GUIDE) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    Mode mode = mode_;
+    lock.unlock();
+    if (mode == Mode::kClosed || mode == Mode::kClosing) {
+      Open();
+    } else {
+      BeginClose();
+    }
+    return;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode_ != Mode::kOpen && mode_ != Mode::kOpening) {
+      repeat_dir = 0;
+      return;
+    }
+  }
+
+  // D-pad / left stick with auto-repeat.
+  int dir = 0;
+  if ((held & hid::X_INPUT_GAMEPAD_DPAD_UP) || ly > 0.5f) {
+    dir = -1;
+  } else if ((held & hid::X_INPUT_GAMEPAD_DPAD_DOWN) || ly < -0.5f) {
+    dir = 1;
+  }
+  if (dir != repeat_dir) {
+    repeat_dir = dir;
+    if (dir) {
+      Move(dir);
+      next_repeat = now + kRepeatDelay;
+    }
+  } else if (dir && now >= next_repeat) {
+    Move(dir);
+    next_repeat = now + kRepeatRate;
+  }
+
+  if (pressed & hid::X_INPUT_GAMEPAD_A) {
+    Activate();
+  } else if (pressed & hid::X_INPUT_GAMEPAD_B) {
+    Back();
+  } else if (pressed & hid::X_INPUT_GAMEPAD_Y) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (page_ == Page::kMenu) {
+      if (DashboardIsRunning()) {
+        lock.unlock();
+        BeginClose();  // already at the Xbox Dashboard
+      } else {
+        page_ = Page::kExit;
+        choice_ = 1;
+        lock.unlock();
+        PlaySfx("btn_Select");
+      }
+    }
+  }
+}
+
+void GuideOverlay::Open() {
+  XELOGI("Guide: open");
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    mode_ = Mode::kOpening;
+    page_ = Page::kMenu;
+    focus_ = 0;
+    anim_start_ = Clock::now();
+    if (!blocking_title_input_) {
+      // The title keeps running but sees no input, like the real Guide.
+      emulator_->kernel_state()->xam_state()->xam_dialogs_shown_++;
+      blocking_title_input_ = true;
+    }
+  }
+  PlaySfx("HUD_open");
+  app_context_.CallInUIThread([this]() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!dialog_) {
+      dialog_ = new Dialog(imgui_drawer_, this);
+    }
+  });
+}
+
+void GuideOverlay::BeginClose() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode_ == Mode::kClosed || mode_ == Mode::kClosing) {
+      return;
+    }
+    mode_ = Mode::kClosing;
+    anim_start_ = Clock::now();
+  }
+  PlaySfx("HUD_close");
+}
+
+void GuideOverlay::FinishClose() {
+  // Called from Draw (UI thread) once the chrome has slid away.
+  Dialog* dialog = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode_ != Mode::kClosing) {
+      return;
+    }
+    mode_ = Mode::kClosed;
+    if (blocking_title_input_) {
+      emulator_->kernel_state()->xam_state()->xam_dialogs_shown_--;
+      blocking_title_input_ = false;
+    }
+    dialog = dialog_;
+  }
+  if (dialog) {
+    dialog->Finish();
+  }
+}
+
+void GuideOverlay::Move(int delta) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (page_ == Page::kMenu) {
+    int next = std::clamp(focus_ + delta, 0, kMenuCount - 1);
+    if (next == focus_) {
+      return;
+    }
+    focus_ = next;
+  } else {
+    int next = std::clamp(choice_ + delta, 0, 1);
+    if (next == choice_) {
+      return;
+    }
+    choice_ = next;
+  }
+  PlaySfx("btn_Focus");
+}
+
+void GuideOverlay::Activate() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  Page page = page_;
+  int choice = choice_;
+  if (page == Page::kMenu) {
+    lock.unlock();
+    // Profile screens are not part of this Guide.
+    PlaySfx("btn_Select");
+    return;
+  }
+  if (choice == 1) {  // No
+    page_ = Page::kMenu;
+    lock.unlock();
+    PlaySfx("btn_Back");
+    return;
+  }
+  lock.unlock();
+  PlaySfx("btn_Select");
+  if (page == Page::kExit) {
+    HandOff("");  // back to the Xbox Dashboard
+  } else {
+    HandOff("OFF");  // turn off the console
+  }
+}
+
+void GuideOverlay::Back() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  if (page_ != Page::kMenu) {
+    page_ = Page::kMenu;
+    lock.unlock();
+    PlaySfx("btn_Back");
+    return;
+  }
+  lock.unlock();
+  BeginClose();
+}
+
+void GuideOverlay::HandOff(const std::string& request) {
+  if (!cvars::dashboard_handoff) {
+    // Not started by the launcher: nothing to hand the request to.
+    BeginClose();
+    return;
+  }
+  XELOGI("Guide: handing off \"{}\"", request);
+  if (FILE* file = xe::filesystem::OpenFile("dashboard_launch.txt", "wb")) {
+    fwrite(request.data(), 1, request.size(), file);
+    fclose(file);
+  }
+  // Let the select sound play briefly, then leave like a title exit.
+  std::this_thread::sleep_for(std::chrono::milliseconds(250));
+  xe::ShutdownLogging();
+  std::quick_exit(0);
+}
+
+void GuideOverlay::PlaySfx(const char* name) {
+  auto path = asset_dir_ / (std::string(name) + ".wav");
+  ::PlaySoundW(path.c_str(), nullptr, SND_FILENAME | SND_ASYNC | SND_NODEFAULT);
+}
+
+bool GuideOverlay::DashboardIsRunning() const {
+  return emulator_->is_title_open() &&
+         emulator_->title_id() == kDashboardTitleId;
+}
+
+GuideOverlay::View GuideOverlay::Snapshot() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  View view{mode_, page_, focus_, choice_, 0.0f};
+  float seconds =
+      std::chrono::duration<float>(Clock::now() - anim_start_).count();
+  view.frames = seconds * layout_.fps;
+  if (mode_ == Mode::kOpening &&
+      view.frames >= layout_.slide_frames + layout_.fade_frames) {
+    mode_ = view.mode = Mode::kOpen;
+  }
+  return view;
+}
+
+// ------------------------------------------------------------------ drawing
+
+namespace {
+// Box-filter downscale along one axis (area coverage, alpha weighted so
+// transparent pixels do not darken edges). `in` holds premultiplied RGBA
+// floats, `count` lines of `in_len` pixels spaced `stride` pixels apart
+// along the axis and `step` pixels apart between lines.
+void ResampleAxis(const std::vector<float>& in, std::vector<float>& out,
+                  int in_len, int out_len, int count, int in_stride,
+                  int in_step, int out_stride, int out_step) {
+  const double ratio = double(in_len) / out_len;
+  for (int line = 0; line < count; ++line) {
+    for (int o = 0; o < out_len; ++o) {
+      double start = o * ratio, end = std::min(double(in_len), start + ratio);
+      float sum[4] = {};
+      for (int i = int(start); i < end; ++i) {
+        float w = float(std::min(end, i + 1.0) - std::max(start, double(i)));
+        const float* p = &in[(size_t(line) * in_step + size_t(i) * in_stride) * 4];
+        for (int c = 0; c < 4; ++c) {
+          sum[c] += p[c] * w;
+        }
+      }
+      float* q = &out[(size_t(line) * out_step + size_t(o) * out_stride) * 4];
+      for (int c = 0; c < 4; ++c) {
+        q[c] = sum[c] / float(end - start);
+      }
+    }
+  }
+}
+}  // namespace
+
+// Every image the Guide draws, most urgent (first frames of the slide) first.
+const char* const kImages[] = {
+    "chrome",         "menu_btnSignIn",   "legends_menu",
+    "clock_atlas",    "menu_btnNewProfile", "menu_btnRecoverProfile",
+    "menu_btnOptions", "menu_btnGameBanner", "dialog_exit_no",
+    "dialog_exit_yes", "dialog_off_no",     "dialog_off_yes",
+    "legends_dialog"};
+
+bool GuideOverlay::Decode(const std::string& name, Pixels& out) const {
+  std::ifstream file(asset_dir_ / (name + ".png"), std::ios::binary);
+  std::vector<uint8_t> data((std::istreambuf_iterator<char>(file)),
+                            std::istreambuf_iterator<char>());
+  int channels;
+  uint8_t* pixels = stbi_load_from_memory(data.data(), int(data.size()),
+                                          &out.width, &out.height, &channels,
+                                          STBI_rgb_alpha);
+  if (!pixels) {
+    XELOGE("Guide: missing image {}", name);
+    return false;
+  }
+  out.rgba.assign(pixels, pixels + size_t(out.width) * out.height * 4);
+  out.units_w = out.width / layout_.scale;
+  out.units_h = out.height / layout_.scale;
+  stbi_image_free(pixels);
+  return true;
+}
+
+GuideOverlay::Pixels GuideOverlay::Resample(const Pixels& in, int out_w,
+                                            int out_h) {
+  int w = in.width, h = in.height;
+  std::vector<float> src(size_t(w) * h * 4);
+  for (size_t i = 0; i < size_t(w) * h; ++i) {
+    float a = in.rgba[i * 4 + 3] / 255.0f;
+    for (int c = 0; c < 3; ++c) {
+      src[i * 4 + c] = in.rgba[i * 4 + c] / 255.0f * a;
+    }
+    src[i * 4 + 3] = a;
+  }
+  std::vector<float> mid(size_t(out_w) * h * 4), dst(size_t(out_w) * out_h * 4);
+  ResampleAxis(src, mid, w, out_w, h, 1, w, 1, out_w);
+  ResampleAxis(mid, dst, h, out_h, out_w, out_w, 1, out_w, 1);
+  Pixels out{out_w, out_h, std::vector<uint8_t>(dst.size()), in.units_w,
+             in.units_h};
+  for (size_t i = 0; i < size_t(out_w) * out_h; ++i) {
+    float a = dst[i * 4 + 3];
+    for (int c = 0; c < 3; ++c) {
+      float v = a > 0 ? dst[i * 4 + c] / a : 0.0f;
+      out.rgba[i * 4 + c] = uint8_t(std::clamp(v * 255.0f + 0.5f, 0.0f, 255.0f));
+    }
+    out.rgba[i * 4 + 3] = uint8_t(std::clamp(a * 255.0f + 0.5f, 0.0f, 255.0f));
+  }
+  return out;
+}
+
+void GuideOverlay::PrepareImages(float pixels_per_unit) {
+  auto start = Clock::now();
+  float f = pixels_per_unit / layout_.scale;
+  for (const char* name : kImages) {
+    Pixels pixels;
+    if (!running_ || !Decode(name, pixels)) {
+      continue;
+    }
+    if (f < 1.0f) {
+      pixels = Resample(pixels, std::max(1, int(std::lround(pixels.width * f))),
+                        std::max(1, int(std::lround(pixels.height * f))));
+    }
+    std::lock_guard<std::mutex> lock(prepare_mutex_);
+    prepared_[name] = std::move(pixels);
+  }
+  XELOGI("Guide: images prepared for {:.3f} px/unit in {} ms", pixels_per_unit,
+         std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() -
+                                                               start)
+             .count());
+  prepare_busy_ = false;
+}
+
+const GuideOverlay::Image* GuideOverlay::Texture(const std::string& name,
+                                                 float pixels_per_unit) {
+  // The images are rendered at layout_.scale pixels per unit. Sampling them
+  // smaller on the GPU skips texels (shimmering text at 720p), so they are
+  // shrunk on the CPU to the exact on-screen size, off the UI thread.
+  Image& image = images_[name];
+  if (image.texture && image.pixels_per_unit == pixels_per_unit) {
+    return &image;
+  }
+  Pixels pixels;
+  {
+    std::lock_guard<std::mutex> lock(prepare_mutex_);
+    if (prepare_for_ != pixels_per_unit && !prepare_busy_) {
+      if (prepare_thread_.joinable()) {
+        prepare_thread_.join();
+      }
+      prepare_for_ = pixels_per_unit;
+      prepared_.clear();
+      prepare_busy_ = true;
+      prepare_thread_ = std::thread(
+          [this, pixels_per_unit]() { PrepareImages(pixels_per_unit); });
+    }
+    auto it = prepared_.find(name);
+    if (it != prepared_.end() && prepare_for_ == pixels_per_unit) {
+      pixels = std::move(it->second);
+      prepared_.erase(it);
+    }
+  }
+  if (pixels.rgba.empty()) {
+    // Not ready yet: keep the previous size meanwhile, if there is one.
+    return image.texture ? &image : nullptr;
+  }
+  image.texture =
+      imgui_drawer_->CreateImGuiTexture(pixels.width, pixels.height,
+                                        pixels.rgba.data());
+  image.pixels_per_unit = pixels_per_unit;
+  image.width = pixels.width;
+  image.height = pixels.height;
+  image.units_w = pixels.units_w;
+  image.units_h = pixels.units_h;
+  return image.texture ? &image : nullptr;
+}
+
+void GuideOverlay::Draw(float display_w, float display_h) {
+  View view = Snapshot();
+  const Layout& l = layout_;
+  static Mode last_mode = Mode::kClosed;
+  if (view.mode != last_mode) {
+    last_mode = view.mode;
+    XELOGI("Guide: mode {} ({}x{})", int(view.mode), display_w, display_h);
+  }
+
+  float chrome_x = 0, legend_x = 0;  // canvas units
+  float content_alpha = 1, legend_alpha = 1;
+  bool content_visible = true;
+  switch (view.mode) {
+    case Mode::kOpening: {
+      // hudbkgnd.xur ClosedToHalf: chrome slides in (frames 1-30) while the
+      // content and legends are invisible, then they fade in (30-44).
+      float slide = Clamp01(view.frames / l.slide_frames);
+      chrome_x = -l.slide * (1.0f - slide);
+      content_alpha = legend_alpha =
+          Clamp01((view.frames - l.slide_frames) / l.fade_frames);
+      break;
+    }
+    case Mode::kOpen:
+      break;
+    case Mode::kClosing: {
+      // HalfToClosed: the hosted scene hides at once, chrome and legends
+      // slide back out.
+      float slide = Clamp01(view.frames / l.slide_frames);
+      chrome_x = -l.slide * slide;
+      legend_x = -kLegendSlide * slide;
+      content_visible = false;
+      if (slide >= 1.0f) {
+        FinishClose();
+        return;
+      }
+      break;
+    }
+    case Mode::kClosed:
+      return;
+  }
+
+  // The 1120x770 Guide canvas fills the screen height from the left edge.
+  const float k = display_h / l.canvas_h;
+  ImDrawList* draw_list = ImGui::GetForegroundDrawList();
+  if (cvars::blades_guide_test.find("black") != std::string::npos) {
+    // Known backdrop for pixel comparisons against the reference renders.
+    draw_list->AddRectFilled(ImVec2(0, 0), ImVec2(display_w, display_h),
+                             IM_COL32(0, 0, 0, 255));
+  }
+  auto layer = [&](const std::string& name, float x, float alpha) {
+    if (alpha <= 0.0f) {
+      return;
+    }
+    if (const Image* image = Texture(name, k)) {
+      // One texel per pixel when resampled to this size (the canvas is then
+      // a fraction of a pixel narrower than canvas_w * k).
+      bool exact = image->pixels_per_unit == k && k < l.scale;
+      float w = exact ? float(image->width) : l.canvas_w * k;
+      float h = exact ? float(image->height) : display_h;
+      draw_list->AddImage(reinterpret_cast<ImTextureID>(image->texture.get()),
+                          ImVec2(x * k, 0), ImVec2(x * k + w, h),
+                          ImVec2(0, 0), ImVec2(1, 1),
+                          IM_COL32(255, 255, 255, int(alpha * 255.0f + 0.5f)));
+    }
+  };
+
+  if (view.mode == Mode::kOpening && !Texture("chrome", k)) {
+    // First open at this size: the images are still being prepared. Hold
+    // the animation at its start (a few frames) rather than stutter.
+    std::lock_guard<std::mutex> lock(mutex_);
+    anim_start_ = Clock::now();
+    return;
+  }
+  layer("chrome", chrome_x, 1.0f);
+  if (content_visible) {
+    std::string content;
+    const char* choice = view.choice == 0 ? "_yes" : "_no";
+    switch (view.page) {
+      case Page::kMenu:
+        content = std::string("menu_") + kMenuItems[view.focus];
+        break;
+      case Page::kExit:
+        content = std::string("dialog_exit") + choice;
+        break;
+      case Page::kTurnOff:
+        content = std::string("dialog_off") + choice;
+        break;
+    }
+    layer(content, 0.0f, content_alpha);
+  }
+  layer(view.page == Page::kMenu ? "legends_menu" : "legends_dialog", legend_x,
+        legend_alpha);
+
+  // Clock (hudbkgnd DateTimeTextId): glyphs rendered with the same font and
+  // metrics as the Guide images, right aligned and vertically centered.
+  const Image* clock_atlas =
+      legend_alpha > 0.0f ? Texture("clock_atlas", k) : nullptr;
+  if (clock_atlas) {
+    const Image& atlas = *clock_atlas;
+    std::time_t now = std::time(nullptr);
+    std::tm local = {};
+    localtime_s(&local, &now);
+    int hour = local.tm_hour % 12 == 0 ? 12 : local.tm_hour % 12;
+    char text[16];
+    snprintf(text, sizeof(text), "%d:%02d%s", hour, local.tm_min,
+             local.tm_hour < 12 ? "am" : "pm");
+    float width = 0;
+    for (const char* c = text; *c; ++c) {
+      width += l.clock_advance.count(*c) ? l.clock_advance.at(*c) : 0.0f;
+    }
+    float pen = l.clock_x + l.clock_w - width + legend_x;
+    float baseline = l.clock_y + (l.clock_h - l.clock_line_h) / 2 + l.clock_ascent;
+    float cell_h = l.clock_line_h + 2 * l.clock_pad;
+    ImU32 tint = IM_COL32(255, 255, 255, int(legend_alpha * 255.0f + 0.5f));
+    for (const char* c = text; *c; ++c) {
+      size_t index = l.clock_chars.find(*c);
+      if (index == std::string::npos) {
+        continue;
+      }
+      float u0 = index * l.clock_cell / atlas.units_w;
+      float u1 = (index + 1) * l.clock_cell / atlas.units_w;
+      float cx = pen - l.clock_pad;
+      float cy = baseline - (l.clock_pad + l.clock_ascent);
+      draw_list->AddImage(reinterpret_cast<ImTextureID>(atlas.texture.get()),
+                          ImVec2(cx * k, cy * k),
+                          ImVec2((cx + l.clock_cell) * k, (cy + cell_h) * k),
+                          ImVec2(u0, 0), ImVec2(u1, cell_h / atlas.units_h),
+                          tint);
+      pen += l.clock_advance.at(*c);
+    }
+  }
+}
+
+}  // namespace app
+}  // namespace xe
