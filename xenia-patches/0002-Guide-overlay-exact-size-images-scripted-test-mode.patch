+GuideOverlay::~GuideOverlay() {
+  running_ = false;
+  if (input_thread_.joinable()) {
+    input_thread_.join();
+  }
+  if (prepare_thread_.joinable()) {
+    prepare_thread_.join();
+  }
+}
