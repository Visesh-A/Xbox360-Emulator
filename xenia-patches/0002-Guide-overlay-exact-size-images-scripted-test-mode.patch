+// Lives while the Guide is on screen; the ImGui drawer calls OnDraw each frame.
+class GuideOverlay::Dialog final : public ui::ImGuiDialog {
+ public:
+  Dialog(ui::ImGuiDrawer* drawer, GuideOverlay* overlay)
+      : ui::ImGuiDialog(drawer), overlay_(overlay) {}
+  void Finish() { Close(); }
+
+ protected:
+  void OnDraw(ImGuiIO& io) override {
+    overlay_->Draw(io.DisplaySize.x, io.DisplaySize.y);
+  }
+  void OnClose() override {
+    std::lock_guard<std::mutex> lock(overlay_->mutex_);
+    if (overlay_->dialog_ == this) {
+      overlay_->dialog_ = nullptr;
+    }
+  }
+
+ private:
+  GuideOverlay* overlay_;
+};
