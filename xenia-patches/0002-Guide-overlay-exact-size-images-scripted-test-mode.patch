+void GuideOverlay::LoadLayout() {
+  std::ifstream in(asset_dir_ / "layout.txt");
+  std::string key;
+  auto& l = layout_;
+  while (in >> key) {
+    if (key == "canvas") {
+      in >> l.canvas_w >> l.canvas_h;
+    } else if (key == "scale") {
+      in >> l.scale;
+    } else if (key == "slide") {
+      in >> l.slide;
+    } else if (key == "slide_frames") {
+      in >> l.slide_frames;
+    } else if (key == "fade_frames") {
+      in >> l.fade_frames;
+    } else if (key == "fps") {
+      in >> l.fps;
+    } else if (key == "clock_box") {
+      in >> l.clock_x >> l.clock_y >> l.clock_w >> l.clock_h;
+    } else if (key == "clock_font") {
+      in >> l.clock_line_h >> l.clock_ascent;
+    } else if (key == "clock_cell") {
+      in >> l.clock_cell >> l.clock_pad;
+    } else if (key == "glyph") {
+      char ch;
+      float advance;
+      in >> ch >> advance;
+      l.clock_chars.push_back(ch);
+      l.clock_advance[ch] = advance;
+    } else {
+      std::string rest;
+      std::getline(in, rest);
+    }
+  }
+}
