+GuideOverlay::GuideOverlay(Emulator* emulator, ui::ImGuiDrawer* imgui_drawer,
+                           ui::WindowedAppContext& app_context)
+    : emulator_(emulator),
+      imgui_drawer_(imgui_drawer),
+      app_context_(app_context),
+      asset_dir_(xe::filesystem::GetExecutableFolder() / "guide") {
+  LoadLayout();
+  input_thread_ = std::thread([this]() { InputThread(); });
+  XELOGI("Blades Guide overlay enabled (assets: {})",
+         xe::path_to_utf8(asset_dir_));
+}
