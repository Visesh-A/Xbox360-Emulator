+
+#ifndef XENIA_APP_GUIDE_OVERLAY_H_
+#define XENIA_APP_GUIDE_OVERLAY_H_
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <filesystem>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace xe {
+class Emulator;
+namespace ui {
+class ImGuiDrawer;
+class ImmediateTexture;
+class WindowedAppContext;
+}  // namespace ui
+
+namespace app {
+
+// The 2006 (Blades) Xbox Guide, drawn from images rendered out of the
+// console's own Guide files (hud.xex scenes, huduiskin.xex skin, xam.xex's
+// hudbkgnd.xur frame) and animated with the frame scene's timeline.
+//
+// Guide button: open/close; hold it to turn off the console. While open the
+// title gets no input (like the real Guide) and keeps running.
+class GuideOverlay {
+ public:
+  GuideOverlay(Emulator* emulator, ui::ImGuiDrawer* imgui_drawer,
+               ui::WindowedAppContext& app_context);
+  ~GuideOverlay();
+
+  static bool IsEnabled();
+
+ private:
+  class Dialog;
+  friend class Dialog;
+  struct Image;
+
+  enum class Mode { kClosed, kOpening, kOpen, kClosing };
+  enum class Page { kMenu, kExit, kTurnOff };
+
+  struct Layout {
+    float canvas_w = 1120, canvas_h = 770, scale = 2;
+    float slide = 672, slide_frames = 29, fade_frames = 14, fps = 60;
+    float clock_x = 402, clock_y = 64, clock_w = 170, clock_h = 40;
+    float clock_line_h = 26, clock_ascent = 21, clock_cell = 40, clock_pad = 6;
+    std::string clock_chars;
+    std::map<char, float> clock_advance;
+  };
+
+  // Snapshot of what to draw, taken under the lock.
+  struct View {
+    Mode mode;
+    Page page;
+    int focus;
+    int choice;
+    float frames;  // animation frames since the current open/close began
+  };
+
+  void InputThread();
+  void OnButtons(uint16_t pressed, uint16_t held, float ly,
+                 std::chrono::steady_clock::time_point now);
+  void Open();
+  void BeginClose();
+  void Activate();  // A
+  void Back();      // B
+  void Move(int delta);
+  void HandOff(const std::string& request);
+  void PlaySfx(const char* name);
+  bool DashboardIsRunning() const;
+  View Snapshot();
+  void FinishClose();  // closing animation ended (UI thread)
+
+  // UI thread
+  void Draw(float display_w, float display_h);
+  // The image at `pixels_per_unit` (screen pixels per canvas unit), or at full
+  // size until the background job has resampled it.
+  const Image* Texture(const std::string& name, float pixels_per_unit);
+  void LoadLayout();
+
+  Emulator* emulator_;
+  ui::ImGuiDrawer* imgui_drawer_;
+  ui::WindowedAppContext& app_context_;
+  std::filesystem::path asset_dir_;
+  Layout layout_;
+
+  std::mutex mutex_;
+  Mode mode_ = Mode::kClosed;
+  Page page_ = Page::kMenu;
+  int focus_ = 0;
+  int choice_ = 1;  // dialogs: 0 = Yes, 1 = No
+  std::chrono::steady_clock::time_point anim_start_;
+  Dialog* dialog_ = nullptr;
+  bool blocking_title_input_ = false;
+
+  // Decoded straight-alpha RGBA.
+  struct Pixels {
+    int width = 0, height = 0;
+    std::vector<uint8_t> rgba;
+    float units_w = 0, units_h = 0;  // canvas units covered
+  };
+  static Pixels Resample(const Pixels& in, int out_w, int out_h);
+  bool Decode(const std::string& name, Pixels& out) const;
+  // Background job: every Guide image resampled for `pixels_per_unit`.
+  void PrepareImages(float pixels_per_unit);
+
+  struct Image {
+    float pixels_per_unit = 0;  // of `texture`
+    int width = 0, height = 0;  // of `texture`
+    float units_w = 0, units_h = 0;  // canvas units covered by the image
+    std::unique_ptr<ui::ImmediateTexture> texture;
+  };
+  std::map<std::string, Image> images_;  // UI thread
+
+  std::mutex prepare_mutex_;
+  float prepare_for_ = 0;  // pixels_per_unit of the job (running or done)
+  std::map<std::string, Pixels> prepared_;  // results waiting for upload
+  std::atomic<bool> prepare_busy_{false};
+  std::thread prepare_thread_;
+
+  std::atomic<bool> running_{true};
+  std::thread input_thread_;
+};
+
+}  // namespace app
+}  // namespace xe
+
+#endif  // XENIA_APP_GUIDE_OVERLAY_H_
