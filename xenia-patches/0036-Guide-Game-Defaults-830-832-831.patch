+// ------------------------------------------------------------ Game Defaults
+
+void GuideOverlay::LoadPrefsLayout() {
+  std::ifstream in(asset_dir_ / "prefs.txt", std::ios::binary);
+  std::string line;
+  auto rest = [](std::istringstream& ls) {
+    std::string text;
+    std::getline(ls >> std::ws, text);
+    if (!text.empty() && text.back() == '\r') text.pop_back();
+    return Unescape(text);
+  };
+  auto item = [](std::istringstream& ls, MessageBoxItem& it) {
+    std::string color;
+    it.is_text = true;
+    ls >> it.x >> it.y >> it.w >> it.h >> it.size >> it.ascent >> it.line_h >>
+        it.style >> color;
+    it.color = uint32_t(std::stoul(color, nullptr, 16));
+  };
+  while (std::getline(in, line)) {
+    std::istringstream ls(line);
+    std::string kind, which;
+    ls >> kind;
+    if (kind == "rowtext" || kind == "spintext") {
+      ls >> which;
+      item(ls, (kind == "rowtext" ? pref_rowtext_
+                                  : pref_spintext_)[which == "focus"]);
+    } else if (kind == "spin") {
+      int i;
+      ls >> i;
+      if (i >= 0 && i < 8) ls >> pref_spin_[i][0] >> pref_spin_[i][1];
+    } else if (kind == "scroll" || kind == "spinarrow") {
+      ls >> which;
+      float* r = kind == "scroll" ? pref_scroll_[which == "down"]
+                                  : pref_arrow_[which == "right"];
+      ls >> r[0] >> r[1] >> r[2] >> r[3];
+    } else if (kind == "list") {
+      for (float& v : pref_list_) ls >> v;
+    } else if (kind == "cat") {
+      int c;
+      ls >> c;
+      prefs_.push_back({rest(ls), {}});
+    } else if (kind == "setting" && !prefs_.empty()) {
+      int c;
+      std::string id;
+      PrefSetting setting;
+      ls >> c >> id >> setting.flags;
+      setting.id = uint32_t(std::stoul(id, nullptr, 16));
+      setting.name = rest(ls);
+      prefs_.back().settings.push_back(std::move(setting));
+    } else if (kind == "value" && !prefs_.empty() &&
+               !prefs_.back().settings.empty()) {
+      int32_t v;
+      ls >> v;
+      prefs_.back().settings.back().values.push_back({v, rest(ls)});
+    }
+  }
+  prefs_ready_ = prefs_.size() == 3 && pref_list_[4] > 0;
+}
+
+const GuideOverlay::PrefSetting* GuideOverlay::PrefSettingAt(int category,
+                                                             int row) const {
+  if (category < 0 || category >= int(prefs_.size())) return nullptr;
+  const auto& settings = prefs_[category].settings;
+  return row >= 0 && row < int(settings.size()) ? &settings[row] : nullptr;
+}
+
+// The profile's value (XamUserReadProfileSettings; unset = 0, the default),
+// as its place in the setting's list.
+int GuideOverlay::PrefIndex(const PrefSetting& setting) const {
+  int32_t value = 0;
+  auto* state = emulator_->kernel_state()->xam_state();
+  if (auto* user = state->GetUserProfile(gp_xuid_)) {
+    auto current = state->user_tracker()->GetSetting(
+        user, kernel::kDashboardID, setting.id);
+    if (current) {
+      auto data = current->get_host_data();
+      if (auto* v = std::get_if<int32_t>(&data)) value = *v;
+    }
+  }
+  for (size_t i = 0; i < setting.values.size(); ++i) {
+    if (setting.values[i].first == value) return int(i);
+  }
+  return 0;
+}
+
+// XamUserWriteProfileSettings (90115F28) with the value.
+void GuideOverlay::SetPref(const PrefSetting& setting, int index) {
+  if (index < 0 || index >= int(setting.values.size())) return;
+  const kernel::xam::UserSetting value(
+      static_cast<kernel::xam::UserSettingId>(setting.id),
+      setting.values[index].first);
+  emulator_->kernel_state()->xam_state()->user_tracker()->UpsertSetting(
+      gp_xuid_, kernel::kDashboardID, &value);
+  XELOGI("Guide: game default {:08X} = {}", setting.id,
+         setting.values[index].first);
+}
