+bool GuideOverlay::ComposePrefsPage(Page page, float ppu, Pixels& out) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  const int cat = pref_cat_, row = pref_row_, item = pref_item_,
+            top = pref_top_;
+  lock.unlock();
+  if (cat < 0 || cat >= int(prefs_.size())) return false;
+  std::string base;
+  if (page == Page::kGpPrefs) {
+    base = "gpprefs_" + std::to_string(cat);
+  } else if (page == Page::kGpPrefCat) {
+    base = fmt::format("gpcat_{}_{}", cat, row);
+  } else {
+    int index = row;
+    for (int c = 0; c < cat; ++c) index += int(prefs_[c].settings.size());
+    base = "gpset_" + std::to_string(index);
+  }
+  // the current values, before taking the images' lock
+  std::vector<std::u16string> spin_text;
+  for (const auto& setting : prefs_[cat].settings) {
+    spin_text.push_back(setting.values[PrefIndex(setting)].second);
+  }
+  std::lock_guard<std::mutex> images_lock(prepare_mutex_);
+  if (!scaled_ready_ || scaled_ppu_ != ppu) return false;
+  auto it = scaled_.find(base);
+  if (it == scaled_.end()) return false;
+  out = it->second;
+  const float lx = pref_list_[0], ly = pref_list_[1], rh = pref_list_[3];
+  const int visible = std::max(1, int(pref_list_[4]));
+  // a list row (XuiListItem, visual XuiButton) and its caption
+  auto list_row = [&](float y, bool focused, const std::u16string& text) {
+    auto img = scaled_.find(focused ? "gp_prow_focus" : "gp_prow_normal");
+    if (img != scaled_.end()) {
+      const Pixels& p = img->second;
+      const int ox0 = int(std::lround(lx * ppu));
+      const int oy0 = int(std::lround(y * ppu));
+      for (int yy = 0; yy < p.height; ++yy) {
+        int oy = oy0 + yy;
+        if (oy < 0 || oy >= out.height) continue;
+        for (int xx = 0; xx < p.width; ++xx) {
+          int ox = ox0 + xx;
+          if (ox < 0 || ox >= out.width) continue;
+          const uint8_t* c = &p.rgba[(size_t(yy) * p.width + xx) * 4];
+          BlendPixel(&out.rgba[(size_t(oy) * out.width + ox) * 4],
+                     c[0] / 255.0f, c[1] / 255.0f, c[2] / 255.0f,
+                     c[3] / 255.0f);
+        }
+      }
+    }
+    MessageBoxItem t = pref_rowtext_[focused];
+    t.x += lx;
+    t.y += y;
+    RenderText(out, t, text, ppu);
+  };
+  if (page == Page::kGpPrefs) {
+    for (int c = 0; c < int(prefs_.size()); ++c) {
+      list_row(ly + c * rh, c == cat, prefs_[c].name);
+    }
+  } else if (page == Page::kGpPrefCat) {
+    // each spinner's value (PreferenceValueList's item text)
+    for (int r = 0; r < int(spin_text.size()) && r < 8; ++r) {
+      MessageBoxItem t = pref_spintext_[r == row];
+      t.x += pref_spin_[r][0];
+      t.y += pref_spin_[r][1];
+      RenderText(out, t, spin_text[r], ppu);
+    }
+  } else if (const PrefSetting* setting = PrefSettingAt(cat, row)) {
+    const int n = int(setting->values.size());
+    for (int i = top; i < n && i < top + visible; ++i) {
+      list_row(ly + (i - top) * rh, i == item, setting->values[i].second);
+    }
+  }
+  return true;
+}
+
+// The lists' XuiScrollEnds: 832's focused spinner shows both arrows (Wrap),
+// fading in over btn_spinner's Focus frames (2-8); 831's list shows an arrow
+// where it can scroll (ScrollMore). Scrolling one way plays that end's
+// Scrolling glow (xhade1: 0 at frame 4, 1 at 14, 0 at 25).
+void GuideOverlay::DrawPrefs(float k, float ox, float oy, float up,
+                             float alpha) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  const Page page = page_;
+  const int cat = pref_cat_, row = pref_row_, top = pref_top_;
+  const auto focus_at = pref_focus_at_, scroll_at = pref_scroll_at_;
+  const int dir = pref_scroll_dir_;
+  lock.unlock();
+  const PrefSetting* setting = PrefSettingAt(cat, row);
+  if (!setting) return;
+  auto V = [up](float x, float y) { return ImVec2(x * up, y * up); };
+  ImDrawList* draw_list = ImGui::GetForegroundDrawList();
+  auto frames = [this](Clock::time_point t) {
+    return std::chrono::duration<float>(Clock::now() - t).count() *
+           layout_.fps;
+  };
+  const float g = frames(scroll_at);
+  const float glow = g < 10.0f   ? g / 10.0f
+                     : g < 21.0f ? 1.0f - (g - 10.0f) / 11.0f
+                                 : 0.0f;
+  auto image = [&](const std::string& name, const float* r, float x, float y,
+                   float a) {
+    if (a <= 0.0f) return;
+    if (const Image* img = Texture(name, k)) {
+      const float x0 = ox + (x + r[0]) * k, y0 = oy + (y + r[1]) * k;
+      draw_list->AddImage(
+          reinterpret_cast<ImTextureID>(img->texture.get()), V(x0, y0),
+          V(x0 + r[2] * k, y0 + r[3] * k), ImVec2(0, 0), ImVec2(1, 1),
+          IM_COL32(255, 255, 255, int(a * alpha * 255.0f + 0.5f)));
+    }
+  };
+  if (page == Page::kGpPrefCat && setting->values.size() > 1 && row < 8) {
+    const float shown = std::clamp(frames(focus_at) / 6.0f, 0.0f, 1.0f);
+    const float sx = pref_spin_[row][0], sy = pref_spin_[row][1];
+    for (int side = 0; side < 2; ++side) {
+      const std::string name = side ? "gp_spin_right" : "gp_spin_left";
+      image(name, pref_arrow_[side], sx, sy, shown);
+      if (dir == side) image(name + "_shade", pref_arrow_[side], sx, sy, glow);
+    }
+  } else if (page == Page::kGpPrefSet) {
+    const int n = int(setting->values.size());
+    const int visible = std::max(1, int(pref_list_[4]));
+    const bool more[2] = {top > 0, top + visible < n};
+    for (int side = 0; side < 2; ++side) {
+      const std::string name = side ? "gp_scroll_down" : "gp_scroll_up";
+      if (more[side]) image(name, pref_scroll_[side], 0, 0, 1.0f);
+      if (dir == side) image(name + "_shade", pref_scroll_[side], 0, 0, glow);
+    }
+  }
+}
